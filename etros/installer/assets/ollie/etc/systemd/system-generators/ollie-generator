#!/bin/sh
# Turn on Etros's services in Ollie OS. Files copied from the FAT boot
# partition can't be symlinks, so a generator does the enabling.
normal=$1
early=$2
mkdir -p "$normal/multi-user.target.wants"
for unit in ollie-check.service ollie-setup.service ollie-myroms.service ollie-padmouse.service ollie-wifi.service; do
    ln -sf "/etc/systemd/system/$unit" "$normal/multi-user.target.wants/$unit"
done
# Raspberry Pi OS's first-boot wizard asks for a user name and password,
# which can't be typed on a handheld. Ollie OS sets its user up itself.
ln -sf /dev/null "$early/userconfig.service"
# Arch Linux's: on its first start it asks for a keyboard layout and time
# zone on the console, which Etros hides (console=tty3), so the screen stays
# black waiting for an answer nobody can see or type.
ln -sf /dev/null "$early/systemd-firstboot.service"
exit 0
