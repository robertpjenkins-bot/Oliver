#!/bin/sh
# Ollie OS start-up check, run as early as systemd can. It leaves a report
# in etros/ollie-log.txt on the BATOCERA drive, which a computer (and Etros
# Maker's "Fix my Etros card") can read. If after three minutes there's no
# desktop on the screen, it restarts into Etros rather than leaving the
# screen black: Ollie OS only lasts one boot, so a restart is Etros.

LOG=/boot/etros/ollie-log.txt

report() {
    mount -o remount,rw /boot 2>/dev/null
    {
        echo "Ollie OS, $(date)"
        echo "$1"
        echo
        echo "== kernel =="
        uname -a
        echo
        echo "== storage (SHARE at /userdata) =="
        findmnt /userdata 2>&1 || echo "NOT MOUNTED"
        echo
        echo "== My ROMs =="
        journalctl -b -u ollie-myroms --no-pager -o cat -n 40 2>&1
        echo "In Not sorted:"
        find "/userdata/downloads/My ROMs/Not sorted - move these into a console folder" -mindepth 1 -maxdepth 1 2>&1
        echo
        echo "== failed services =="
        systemctl --failed --no-legend 2>&1
        echo
        echo "== display =="
        systemctl status display-manager --no-pager -n 20 2>&1
        ls -l /dev/dri /dev/dri/by-path 2>&1
        journalctl -b -u display-manager -u sddm --no-pager -o cat -n 40 2>&1
        echo
        echo "== X (the login screen) =="
        for x in /var/log/Xorg.0.log /var/lib/sddm/.local/share/xorg/Xorg.0.log; do
            test -f "$x" && grep -E '\((EE|WW)\)|Fatal|no screens' "$x" | tail -n 20
        done
        echo
        echo "== the desktop (KDE Plasma) =="
        journalctl -b _COMM=kwin_wayland _COMM=plasmashell _COMM=startplasma-wayland --no-pager -o cat -n 40 2>&1
        echo
        echo "== errors this boot =="
        journalctl -b -p err --no-pager -n 80 2>&1
    } > "$LOG.new" 2>&1
    mv "$LOG.new" "$LOG"
    sync
    mount -o remount,ro /boot 2>/dev/null
}

desktop_up() {
    systemctl is-active -q display-manager || return 1
    for p in plasmashell kwin_wayland kwin_x11 labwc wayfire lxsession lxpanel pcmanfm wf-panel-pi; do
        pgrep -x "$p" >/dev/null && return 0
    done
    return 1
}

report "starting (systemd is running)"
for _ in $(seq 1 36); do
    sleep 5
    if desktop_up; then
        # Keep the report current while Ollie OS runs, so it also shows what
        # happened to ROMs put in My ROMs.
        while true; do
            report "OK: the desktop is up"
            sleep 120
        done
    fi
done
report "NO DESKTOP after 3 minutes; restarting into Etros"
systemctl reboot
