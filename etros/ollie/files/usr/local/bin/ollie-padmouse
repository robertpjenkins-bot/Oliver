#!/usr/bin/env python3
"""Drive the Ollie OS desktop with a gamepad: the R36S has no mouse or
keyboard, and on the Pi 5 it saves reaching for one.

Labels are Nintendo-style, as printed on the R36S: A is the right face
button, B the bottom one.

    left stick / d-pad   pointer           A   left click
    right stick          scroll            Y   right click
    L / R                page up / down    B   back (Alt+Left)
    START                Enter             X   on-screen keyboard
    SELECT               Escape
    hold SELECT + START for two seconds: back to Etros

Talks to the kernel directly (evdev in, uinput out) so it needs nothing
beyond Python's standard library.
"""
import fcntl
import glob
import os
import select
import struct
import subprocess
import time

EV_SYN, EV_KEY, EV_REL, EV_ABS = 0, 1, 2, 3
REL_X, REL_Y, REL_WHEEL = 0, 1, 8
ABS_X, ABS_Y, ABS_RX, ABS_RY, ABS_HAT0X, ABS_HAT0Y = 0, 1, 3, 4, 16, 17
BTN_LEFT, BTN_RIGHT = 0x110, 0x111
BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST = 0x130, 0x131, 0x133, 0x134
BTN_TL, BTN_TR, BTN_SELECT, BTN_START = 0x136, 0x137, 0x13A, 0x13B
BTN_DPAD_UP, BTN_DPAD_DOWN, BTN_DPAD_LEFT, BTN_DPAD_RIGHT = 0x220, 0x221, 0x222, 0x223
KEY_ESC, KEY_ENTER, KEY_LEFTALT, KEY_LEFT = 1, 28, 56, 105
KEY_PAGEUP, KEY_PAGEDOWN = 104, 109

EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux
ABSINFO = struct.Struct("6i")

DEADZONE = 0.18
SPEED = 14.0
DPAD_SPEED = 5.0
TICK = 1 / 60

CLICKS = {BTN_EAST: BTN_LEFT, BTN_WEST: BTN_RIGHT}
KEYS = {
    BTN_SOUTH: [KEY_LEFTALT, KEY_LEFT],
    BTN_TL: [KEY_PAGEUP],
    BTN_TR: [KEY_PAGEDOWN],
    BTN_START: [KEY_ENTER],
    BTN_SELECT: [KEY_ESC],
}
DPAD = {BTN_DPAD_UP: (0, -1), BTN_DPAD_DOWN: (0, 1),
        BTN_DPAD_LEFT: (-1, 0), BTN_DPAD_RIGHT: (1, 0)}


def ioc(direction, kind, nr, size):
    return direction << 30 | size << 16 | ord(kind) << 8 | nr


def EVIOCGBIT(ev, length):
    return ioc(2, "E", 0x20 + ev, length)


def EVIOCGABS(axis):
    return ioc(2, "E", 0x40 + axis, ABSINFO.size)


EVIOCGNAME = ioc(2, "E", 0x06, 256)
UI_SET_EVBIT = ioc(1, "U", 100, 4)
UI_SET_KEYBIT = ioc(1, "U", 101, 4)
UI_SET_RELBIT = ioc(1, "U", 102, 4)
UI_DEV_SETUP = ioc(1, "U", 3, 92)
UI_DEV_CREATE = ioc(0, "U", 1, 0)


def bits(fd, ev, count):
    buf = bytearray((count + 7) // 8)
    fcntl.ioctl(fd, EVIOCGBIT(ev, len(buf)), buf)
    return {i for i in range(count) if buf[i // 8] >> (i % 8) & 1}


class Pad:
    def __init__(self, path):
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        name = bytearray(256)
        fcntl.ioctl(self.fd, EVIOCGNAME, name)
        self.name = name.split(b"\0")[0].decode(errors="replace")
        self.ranges = {}
        for axis in bits(self.fd, EV_ABS, 64):
            info = bytearray(ABSINFO.size)
            fcntl.ioctl(self.fd, EVIOCGABS(axis), info)
            _, lo, hi, _, _, _ = ABSINFO.unpack(info)
            self.ranges[axis] = (lo, hi)

    def axis(self, code, value):
        lo, hi = self.ranges.get(code, (-1, 1))
        v = (value - lo) / ((hi - lo) or 1) * 2 - 1
        if abs(v) < DEADZONE:
            return 0.0
        return (v - DEADZONE * (1 if v > 0 else -1)) / (1 - DEADZONE)


def is_gamepad(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        keys = bits(fd, EV_KEY, 0x300)
        name = bytearray(256)
        fcntl.ioctl(fd, EVIOCGNAME, name)
        if name.startswith(b"ollie-padmouse"):
            return False
        return bool(keys & {BTN_SOUTH, BTN_EAST, BTN_DPAD_UP})
    except OSError:
        return False
    finally:
        os.close(fd)


class Output:
    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        for ev in (EV_KEY, EV_REL):
            fcntl.ioctl(self.fd, UI_SET_EVBIT, ev)
        for key in [BTN_LEFT, BTN_RIGHT, KEY_ESC, KEY_ENTER, KEY_LEFTALT, KEY_LEFT, KEY_PAGEUP, KEY_PAGEDOWN]:
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, key)
        for rel in (REL_X, REL_Y, REL_WHEEL):
            fcntl.ioctl(self.fd, UI_SET_RELBIT, rel)
        setup = struct.pack("HHHH80sI", 0x06, 0x4F4C, 0x0001, 1, b"ollie-padmouse", 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, kind, code, value):
        os.write(self.fd, EVENT.pack(0, 0, kind, code, value))

    def sync(self):
        self.emit(EV_SYN, 0, 0)

    def tap(self, keys):
        for k in keys:
            self.emit(EV_KEY, k, 1)
        self.sync()
        for k in reversed(keys):
            self.emit(EV_KEY, k, 0)
        self.sync()


def as_desktop_user(cmd):
    """Run a command in the logged-in user's session."""
    try:
        uid = int(subprocess.check_output(["id", "-u", "ollie"]).strip())
    except (subprocess.CalledProcessError, ValueError):
        return
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{uid}",
               DBUS_SESSION_BUS_ADDRESS=f"unix:path=/run/user/{uid}/bus",
               WAYLAND_DISPLAY="wayland-0", DISPLAY=":0")
    subprocess.Popen(["runuser", "-u", "ollie", "--"] + cmd, env=env)


def main():
    out = Output()
    pads = {}
    axes = {}
    dpad = set()
    held = set()
    combo_since = None
    scroll_wait = 0
    last_scan = 0.0
    while True:
        now = time.monotonic()
        if now - last_scan > 2:
            last_scan = now
            for path in glob.glob("/dev/input/event*"):
                if path not in pads and is_gamepad(path):
                    try:
                        pads[path] = Pad(path)
                        print("using", pads[path].name, flush=True)
                    except OSError:
                        pass
        ready, _, _ = select.select([p.fd for p in pads.values()], [], [], TICK)
        for path, pad in list(pads.items()):
            if pad.fd not in ready:
                continue
            try:
                data = os.read(pad.fd, EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:  # unplugged
                os.close(pad.fd)
                del pads[path]
                continue
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, kind, code, value = EVENT.unpack_from(data, i)
                if kind == EV_ABS:
                    if code in (ABS_HAT0X, ABS_HAT0Y):
                        horizontal = code == ABS_HAT0X
                        dpad = {d for d in dpad if (d[0] if horizontal else d[1]) == 0}
                        if value:
                            dpad.add((value, 0) if horizontal else (0, value))
                    else:
                        axes[code] = pad.axis(code, value)
                elif kind == EV_KEY:
                    (held.add if value else held.discard)(code)
                    if code in DPAD:
                        (dpad.add if value else dpad.discard)(DPAD[code])
                    elif code in CLICKS:
                        out.emit(EV_KEY, CLICKS[code], 1 if value else 0)
                        out.sync()
                    elif value == 1 and code == BTN_NORTH:
                        as_desktop_user(["/usr/local/bin/ollie-keyboard-toggle"])
                    elif value == 1 and code in KEYS and not {BTN_START, BTN_SELECT} <= held:
                        out.tap(KEYS[code])

        x, y = axes.get(ABS_X, 0.0), axes.get(ABS_Y, 0.0)
        dx = x * abs(x) * SPEED + sum(d[0] for d in dpad) * DPAD_SPEED
        dy = y * abs(y) * SPEED + sum(d[1] for d in dpad) * DPAD_SPEED
        if dx or dy:
            out.emit(EV_REL, REL_X, int(round(dx)))
            out.emit(EV_REL, REL_Y, int(round(dy)))
            out.sync()
        ry = axes.get(ABS_RY, 0.0)
        scroll_wait -= 1
        if ry and scroll_wait <= 0:
            scroll_wait = int(6 / max(abs(ry), 0.2))
            out.emit(EV_REL, REL_WHEEL, -1 if ry > 0 else 1)
            out.sync()

        if {BTN_START, BTN_SELECT} <= held:
            combo_since = combo_since or time.monotonic()
            if time.monotonic() - combo_since > 2:
                subprocess.Popen(["/usr/local/bin/ollie-boot-batocera"])
                combo_since = float("inf")
        elif combo_since != float("inf"):
            combo_since = None


if __name__ == "__main__":
    main()
