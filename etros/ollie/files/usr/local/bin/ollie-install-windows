#!/bin/bash
# Install Windows 11 for ARM onto this card's WINDOWS partition, from the
# Windows 11 Arm64 ISO in Downloads. Run as root (through sudo) from Ollie
# OS's "Install Windows 11" icon, in a terminal window.
#
# The card needs Etros's Windows partitions, which Etros Updater makes:
#   partition 3  WINDOWS  (empty; formatted NTFS here)
#   partition 4  WINBOOT  (FAT; the Pi 5's UEFI firmware, put on by Etros)
#
# Here: Windows's install image goes onto WINDOWS, and Windows's installer
# (WinPE) onto WINBOOT, with a script of ours as its start-up. Then the Pi
# 5 is told to start from WINBOOT (autoboot.txt on the BATOCERA partition)
# and restarts: WinPE applies the image, makes Windows's boot files and
# restarts into Windows, which sets itself up with a local account "Ollie"
# and a Back to Etros icon on its desktop.

share=/usr/share/ollie/windows

say() { printf '\n\e[1;36m== %s\e[0m\n' "$*"; }
fail() {
    printf '\n\e[1;31mINSTALL WINDOWS 11 FAILED:\e[0m %s\n\n' "$*"
    read -r -p "Press Enter to close this window."
    cleanup
    exit 1
}
cleanup() {
    umount /mnt/etros-win 2>/dev/null
    umount /mnt/etros-winboot 2>/dev/null
}
trap cleanup EXIT

say "INSTALL WINDOWS 11"
echo "This puts Windows 11 for ARM on this card, next to Etros and Ollie OS."
echo "Windows 11 on the Pi 5 has no internet (no Wi-Fi or Ethernet driver) and is slow."

# The card, from the BATOCERA partition Ollie OS has at /boot.
boot_dev=$(findmnt -no SOURCE /boot)
case "$boot_dev" in
    /dev/mmcblk*p1|/dev/nvme*p1) disk=${boot_dev%p1}; win=${disk}p3; winboot=${disk}p4 ;;
    /dev/sd?1|/dev/vd?1) disk=${boot_dev%1}; win=${disk}3; winboot=${disk}4 ;;
    *) fail "can't tell which card Ollie OS started from ($boot_dev)." ;;
esac
if [ "$(blkid -s LABEL -o value "$winboot" 2>/dev/null)" != WINBOOT ]; then
    fail "this card has no room for Windows 11 yet. On a computer, run Etros Updater on the card and choose \"Make room for Windows 11\"."
fi

# The ISO: the newest one in Downloads (or My ROMs' Not sorted) named for ARM.
isos=()
while IFS= read -r f; do isos+=("$f"); done < <(
    ls -t /userdata/downloads/*.iso /userdata/downloads/*/*.iso /userdata/downloads/*/*/*.iso 2>/dev/null)
iso=
for f in "${isos[@]}"; do
    case "${f,,}" in *arm64*|*arm*|*aarch64*) iso=$f; break ;; esac
done
[ -z "$iso" ] && [ "${#isos[@]}" -gt 0 ] && iso=${isos[0]}
if [ -z "$iso" ]; then
    fail "there's no Windows 11 ISO in Downloads. In the web browser, search for \"Download Windows 11 Arm64\", download it from microsoft.com into Downloads, and try again."
fi
echo "Windows 11 from: $iso"

say "Getting the tools (wimlib, 7-Zip, NTFS)"
need=()
command -v wimlib-imagex >/dev/null || need+=(wimtools)
command -v 7z >/dev/null || need+=(p7zip-full)
command -v mkntfs >/dev/null || need+=(ntfs-3g)
if [ "${#need[@]}" -gt 0 ]; then
    if ! { apt-get update -q && apt-get install -y -q "${need[@]}"; }; then
        fail "couldn't install ${need[*]} (is Ollie OS connected to the internet?)."
    fi
fi

# Windows for PCs can't run on the Pi 5: the ISO must start ARM computers.
listing=$(7z l "$iso" 2>/dev/null) || fail "$(basename "$iso") can't be read as a disc image."
if ! grep -qi 'efi[/\\]boot[/\\]bootaa64.efi' <<< "$listing"; then
    fail "$(basename "$iso") is Windows for PCs (x64). The Pi 5 needs Windows 11 Arm64: download that one from microsoft.com."
fi
wim=install.wim
grep -qi 'sources[/\\]install.esd' <<< "$listing" && wim=install.esd

echo
echo "Everything on the WINDOWS partition ($win) will be erased."
read -r -p "Type yes to install Windows 11: " answer
[ "${answer,,}" = yes ] || fail "stopped; nothing was changed."

say "Preparing the Windows partition"
mkntfs -Q -L WINDOWS "$win" || fail "couldn't format $win."
mkdir -p /mnt/etros-win /mnt/etros-winboot
mount -t ntfs-3g "$win" /mnt/etros-win || fail "couldn't open $win."
mount "$winboot" /mnt/etros-winboot || fail "couldn't open $winboot."

say "Copying Windows's install image (a few GB, this takes a while)"
mkdir -p /mnt/etros-win/etros-win
7z e -y -bsp1 "$iso" "sources/$wim" -o/mnt/etros-win/etros-win || fail "couldn't copy $wim from the ISO."
# The edition: Windows 11 Pro, or Home, or the first there is.
info=$(wimlib-imagex info "/mnt/etros-win/etros-win/$wim")
index=$(awk '/^Index:/ {i=$2} /^Name:/ && /Windows 11 Pro$/ {print i; exit}' <<< "$info")
[ -z "$index" ] && index=$(awk '/^Index:/ {i=$2} /^Name:/ && /Windows 11 Home$/ {print i; exit}' <<< "$info")
[ -z "$index" ] && index=1
echo "Edition: $(awk -v i="$index" '/^Index:/ {n=$2} /^Name:/ && n==i {sub(/^Name: */, ""); print; exit}' <<< "$info")"

say "Copying Windows's installer to WINBOOT"
rm -rf /mnt/etros-winboot/efi /mnt/etros-winboot/EFI /mnt/etros-winboot/boot /mnt/etros-winboot/sources
7z x -y -bsp1 "$iso" -o/mnt/etros-winboot 'efi/*' 'boot/*' 'sources/boot.wim' 'bootmgr.efi' ||
    fail "couldn't copy Windows's installer from the ISO."
# Our script as the installer's start-up (WinPE runs startnet.cmd).
sed 's/$/\r/' "$share/startnet.cmd" > /tmp/startnet.cmd
wimlib-imagex update /mnt/etros-winboot/sources/boot.wim 2 \
    --command="add /tmp/startnet.cmd /Windows/System32/startnet.cmd" >/dev/null ||
    fail "couldn't set up Windows's installer."
printf '%s\r\n' "$index" > /mnt/etros-winboot/etros-win-index.txt
printf '%s\r\n' "$wim" > /mnt/etros-winboot/etros-win-image.txt
cp "$share/unattend.xml" /mnt/etros-winboot/unattend.xml
sed 's/$/\r/' "$share/Back to Etros.bat" > "/mnt/etros-winboot/Back to Etros.bat"
rm -f /mnt/etros-winboot/etros-win-installed.txt /mnt/etros-winboot/etros-win-failed.txt
sync
cleanup

say "Restarting into Windows's installer"
mount -o remount,rw /boot || fail "couldn't change the card's start-up."
printf '[all]\nboot_partition=4\n' > /boot/autoboot.txt
sync
mount -o remount,ro /boot
echo "The Pi 5 now restarts and installs Windows 11: about 30 to 60 minutes,"
echo "with a few restarts. Don't switch it off. Windows then starts by itself."
echo "To come back to Etros, use the Back to Etros icon on Windows's desktop."
sleep 10
systemctl reboot
