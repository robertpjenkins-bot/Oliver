#!/bin/sh
# Ollie OS setup, run as root before the desktop starts, every boot. Each
# step checks before it changes anything.

# The files Etros copies in come from a FAT partition, which has no
# permissions to carry over.
chmod 0755 /usr/local/sbin/ollie-setup /usr/local/sbin/ollie-check /usr/local/bin/ollie-* /usr/local/bin/etros-sort-roms \
    /etc/systemd/system-generators/ollie-generator
chmod 0644 /etc/fstab /etc/systemd/system/ollie-*.service /etc/chromium/policies/managed/ollie.json \
    /etc/xdg/autostart/ollie-wallpaper.desktop /etc/X11/xorg.conf.d/99-ollie-pi5.conf /usr/share/ollie/* /usr/share/ollie/desktop/* 2>/dev/null

# The desktop user, logged in automatically.
# (Ollie OS for ARM logs "ollie" in through SDDM, Raspberry Pi OS through
# LightDM; admin tasks need no password for the wheel group on Ollie OS.)
if ! id ollie >/dev/null 2>&1; then
    groups=
    for g in wheel sudo video render input audio netdev plugdev users gpio; do
        getent group "$g" >/dev/null && groups="$groups,$g"
    done
    useradd -m -s /bin/bash -G "${groups#,}" ollie
    passwd -d ollie
fi
echo 'ollie ALL=(root) NOPASSWD: /usr/local/bin/ollie-boot-batocera' > /etc/sudoers.d/ollie
chmod 0440 /etc/sudoers.d/ollie
if test -f /etc/lightdm/lightdm.conf; then
    if grep -qE '^#?autologin-user=' /etc/lightdm/lightdm.conf; then
        sed -i -E 's/^#?autologin-user=.*/autologin-user=ollie/' /etc/lightdm/lightdm.conf
    else
        sed -i 's/^\[Seat:\*\]$/[Seat:*]\nautologin-user=ollie/' /etc/lightdm/lightdm.conf
    fi
fi
# Arch Linux's Ollie OS logs in through SDDM, into KDE Plasma.
if command -v sddm >/dev/null 2>&1; then
    mkdir -p /etc/sddm.conf.d
    session=plasma
    [ -f /usr/share/wayland-sessions/plasma.desktop ] || session=plasmax11
    printf '[Autologin]\nUser=ollie\nSession=%s\nRelogin=true\n' "$session" > /etc/sddm.conf.d/20-ollie-autologin.conf
fi
rm -f /etc/xdg/autostart/piwiz.desktop
id rpi-first-boot-wizard >/dev/null 2>&1 && userdel -r rpi-first-boot-wizard 2>/dev/null

# Shared storage with Batocera.
if mountpoint -q /userdata; then
    # Older Etros didn't always mount it, and then downloads were saved into
    # Ollie OS's own /userdata folder, hidden now under the real one. Move
    # them to the shared Downloads, where Etros sorts them.
    mkdir -p /run/ollie-under
    if mount --bind / /run/ollie-under 2>/dev/null; then
        under=/run/ollie-under/userdata
        for f in "$under"/downloads/* "$under"/downloads/.[!.]* "$under"/roms/*/*; do
            test -e "$f" || continue
            case "$f" in
                "$under"/roms/*) dest=/userdata/roms/$(basename "$(dirname "$f")") ;;
                *) dest=/userdata/downloads ;;
            esac
            mkdir -p "$dest"
            test -e "$dest/$(basename "$f")" || mv "$f" "$dest/"
        done
        umount /run/ollie-under
    fi
    mkdir -p /userdata/downloads "/userdata/downloads/My ROMs" /userdata/ollie
    chmod 1777 /userdata/downloads "/userdata/downloads/My ROMs"
    chown ollie: /userdata/ollie
fi

# Home: Downloads is Batocera's downloads folder, and right next to it is
# My ROMs, where ROMs go to be sorted into their consoles (etros-sort-roms,
# run by ollie-myroms.service).
H=/home/ollie
mkdir -p "$H/Desktop" "$H/.config/libfm" "$H/.config/gtk-3.0"
# Each is a real folder with the shared storage mounted into it (a bind
# mount), not a link: links show up as links, or as broken ones, in the file
# manager, and some programs' save windows don't follow them.
place() {  # place TARGET FOLDER: FOLDER shows what's in TARGET
    mountpoint -q "$2" && return 0
    if test -L "$2"; then
        rm -f "$2"
    elif test -d "$2" && test -n "$(ls -A "$2" 2>/dev/null)"; then
        mv "$2" "$2.old"  # keep anything that was there
    fi
    mkdir -p "$2"
    chown ollie: "$2"
    mount --bind "$1" "$2"
}
if mountpoint -q /userdata; then
    mkdir -p /userdata/roms
    # So ROMs can also be put straight into a console's folder.
    chmod 0777 /userdata/roms
    find /userdata/roms -mindepth 1 -maxdepth 1 -type d -exec chmod 0777 {} +
    place /userdata/downloads "$H/Downloads"
    place "/userdata/downloads/My ROMs" "$H/My ROMs"
    place /userdata/roms "$H/All my games"
    # The file manager's sidebar: My ROMs right under Downloads.
    printf 'file://%s/Downloads Downloads\nfile://%s/My%%20ROMs My ROMs\nfile://%s/All%%20my%%20games All my games\n' \
        "$H" "$H" "$H" > "$H/.config/gtk-3.0/bookmarks"
fi

# The desktop: folders are links to the folders themselves, which open with a
# double-click; programs are launchers, which run without asking first
# (quick_exec, for the user and for everyone).
rm -f "$H"/Desktop/downloads.desktop "$H"/Desktop/roms.desktop "$H"/Desktop/my-roms.desktop
if mountpoint -q /userdata; then
    place /userdata/downloads "$H/Desktop/Downloads"
    place "/userdata/downloads/My ROMs" "$H/Desktop/My ROMs"
    place /userdata/roms "$H/Desktop/All my games"
fi
for f in /usr/share/ollie/desktop/*.desktop; do
    case "$(basename "$f")" in
        downloads.desktop|roms.desktop|my-roms.desktop) ;;
        *) cp "$f" "$H/Desktop/" ;;
    esac
done
rm -f "$H/Desktop/install-windows.desktop"  # from an earlier Etros
chmod 0755 "$H"/Desktop/*.desktop
printf '[config]\nquick_exec=1\n' > "$H/.config/libfm/libfm.conf"
conf=/etc/xdg/libfm/libfm.conf
if test -f "$conf"; then
    if grep -q '^quick_exec=' "$conf"; then
        sed -i 's/^quick_exec=.*/quick_exec=1/' "$conf"
    else
        sed -i 's/^\[config\]$/[config]\nquick_exec=1/' "$conf"
    fi
fi
chown ollie: "$H/Desktop" "$H"/Desktop/*.desktop
chown -R ollie: "$H/.config"

# Bobby: your own picture wins over the built-in one.
for f in /userdata/ollie/bobby.png /userdata/ollie/bobby.jpg /userdata/ollie/bobby.jpeg; do
    if test -f "$f"; then
        cp "$f" /usr/share/ollie/bobby.png
        break
    fi
done
for conf in /etc/xdg/pcmanfm/*/desktop-items-*.conf "$H"/.config/pcmanfm/*/desktop-items-*.conf; do
    test -f "$conf" || continue
    sed -i -E -e 's|^wallpaper=.*|wallpaper=/usr/share/ollie/bobby.png|' \
              -e 's|^wallpaper_mode=.*|wallpaper_mode=crop|' "$conf"
    # Downloads, My ROMs and All my games are folders with the shared storage
    # mounted into them, so the desktop would show each again as a drive.
    if grep -q '^show_mounts=' "$conf"; then
        sed -i 's|^show_mounts=.*|show_mounts=0|' "$conf"
    else
        echo 'show_mounts=0' >> "$conf"
    fi
done

# The root file system was copied in at its original size; grow it into
# the rest of its partition once.
if ! test -e /var/lib/ollie/resized; then
    mkdir -p /var/lib/ollie
    resize2fs "$(findmnt -no SOURCE /)" && touch /var/lib/ollie/resized
fi
exit 0
