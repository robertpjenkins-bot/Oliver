#!/bin/sh
# Chromium with its profile kept on the storage partition (bookmarks survive
# a restart; the rest of Ollie OS is wiped every boot) and scaled down on
# small screens like the R36S.
width=$(xdpyinfo 2>/dev/null | sed -n 's/.*dimensions: *\([0-9]*\)x.*/\1/p')
scale=1
test -n "$width" && test "$width" -le 800 && scale=0.75
mkdir -p /userdata/ollie/chromium 2>/dev/null
exec chromium --user-data-dir=/userdata/ollie/chromium \
    --disk-cache-dir=/tmp/chromium-cache --disk-cache-size=67108864 \
    --force-device-scale-factor="$scale" --start-maximized \
    --no-first-run --password-store=basic "$@"
