#!/usr/bin/env python3
"""Drive the Ollie OS desktop with a gamepad: the R36S has no mouse or
keyboard, and on the Pi 5 it saves reaching for one.

Labels are Nintendo-style, as printed on the R36S: A is the right face
button, B the bottom one.

    left stick / d-pad   pointer           A   left click
    right stick          scroll            Y   right click
    L / R                page up / down    B   back (Alt+Left)
    START                Enter             X   on-screen keyboard
    SELECT               Escape
    hold SELECT + START for two seconds: back to Etros
"""
import asyncio
import subprocess
import time

import evdev
from evdev import ecodes as e

DEADZONE = 0.18
SPEED = 14.0      # pixels per tick at full tilt
DPAD_SPEED = 5.0
SCROLL_EVERY = 6  # ticks between scroll steps at full tilt
TICK = 1 / 60

BUTTONS = {
    e.BTN_EAST: ("click", e.BTN_LEFT),
    e.BTN_WEST: ("click", e.BTN_RIGHT),
    e.BTN_SOUTH: ("keys", [e.KEY_LEFTALT, e.KEY_LEFT]),
    e.BTN_NORTH: ("keys", [e.KEY_LEFTMETA, e.KEY_K]),
    e.BTN_TL: ("keys", [e.KEY_PAGEUP]),
    e.BTN_TR: ("keys", [e.KEY_PAGEDOWN]),
    e.BTN_START: ("keys", [e.KEY_ENTER]),
    e.BTN_SELECT: ("keys", [e.KEY_ESC]),
}
DPAD = {e.BTN_DPAD_UP: (0, -1), e.BTN_DPAD_DOWN: (0, 1),
        e.BTN_DPAD_LEFT: (-1, 0), e.BTN_DPAD_RIGHT: (1, 0)}


class Pad:
    def __init__(self):
        self.axes = {}     # code -> value in -1..1
        self.dpad = set()  # held d-pad directions as (dx, dy)
        self.held = set()
        self.combo_since = None


def is_gamepad(dev):
    caps = dev.capabilities()
    keys = set(caps.get(e.EV_KEY, []))
    return bool(keys & {e.BTN_SOUTH, e.BTN_EAST, e.BTN_DPAD_UP}) and dev.name != "ollie-padmouse"


def normalise(dev, code, value):
    info = dev.absinfo(code)
    span = (info.max - info.min) or 1
    v = (value - info.min) / span * 2 - 1
    if abs(v) < DEADZONE:
        return 0.0
    return (v - DEADZONE * (1 if v > 0 else -1)) / (1 - DEADZONE)


def tap(ui, keys):
    for k in keys:
        ui.write(e.EV_KEY, k, 1)
    ui.syn()
    for k in reversed(keys):
        ui.write(e.EV_KEY, k, 0)
    ui.syn()


async def read_pad(dev, pad, ui):
    try:
        async for ev in dev.async_read_loop():
            if ev.type == e.EV_ABS:
                if ev.code in (e.ABS_HAT0X, e.ABS_HAT0Y):
                    axis = 0 if ev.code == e.ABS_HAT0X else 1
                    pad.dpad = {d for d in pad.dpad if d[axis] == 0}
                    if ev.value:
                        pad.dpad.add((ev.value, 0) if axis == 0 else (0, ev.value))
                else:
                    pad.axes[ev.code] = normalise(dev, ev.code, ev.value)
            elif ev.type == e.EV_KEY:
                if ev.value:
                    pad.held.add(ev.code)
                else:
                    pad.held.discard(ev.code)
                if ev.code in DPAD:
                    (pad.dpad.add if ev.value else pad.dpad.discard)(DPAD[ev.code])
                elif ev.code in BUTTONS:
                    kind, what = BUTTONS[ev.code]
                    if kind == "click":
                        ui.write(e.EV_KEY, what, 1 if ev.value else 0)
                        ui.syn()
                    elif ev.value == 1 and not {e.BTN_START, e.BTN_SELECT} <= pad.held:
                        tap(ui, what)
    except OSError:
        pass  # unplugged


async def move(pad, ui):
    scroll_tick = 0
    while True:
        await asyncio.sleep(TICK)
        x, y = pad.axes.get(e.ABS_X, 0.0), pad.axes.get(e.ABS_Y, 0.0)
        dx = x * abs(x) * SPEED + sum(d[0] for d in pad.dpad) * DPAD_SPEED
        dy = y * abs(y) * SPEED + sum(d[1] for d in pad.dpad) * DPAD_SPEED
        if dx or dy:
            ui.write(e.EV_REL, e.REL_X, int(round(dx)))
            ui.write(e.EV_REL, e.REL_Y, int(round(dy)))
            ui.syn()
        ry = pad.axes.get(e.ABS_RY, 0.0)
        scroll_tick += 1
        if ry and scroll_tick >= SCROLL_EVERY / max(abs(ry), 0.2):
            scroll_tick = 0
            ui.write(e.EV_REL, e.REL_WHEEL, -1 if ry > 0 else 1)
            ui.syn()
        if {e.BTN_START, e.BTN_SELECT} <= pad.held:
            pad.combo_since = pad.combo_since or time.monotonic()
            if time.monotonic() - pad.combo_since > 2:
                subprocess.Popen(["/usr/local/bin/ollie-boot-batocera"])
                pad.combo_since = float("inf")
        elif pad.combo_since != float("inf"):
            pad.combo_since = None


async def main():
    keys = [e.BTN_LEFT, e.BTN_RIGHT, e.KEY_LEFTALT, e.KEY_LEFT, e.KEY_LEFTMETA,
            e.KEY_K, e.KEY_PAGEUP, e.KEY_PAGEDOWN, e.KEY_ENTER, e.KEY_ESC]
    ui = evdev.UInput({e.EV_KEY: keys, e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]},
                      name="ollie-padmouse")
    pad = Pad()
    asyncio.ensure_future(move(pad, ui))
    watched = {}
    while True:
        for path in evdev.list_devices():
            if path in watched and not watched[path].done():
                continue
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            if is_gamepad(dev):
                print("using", dev.name, flush=True)
                watched[path] = asyncio.ensure_future(read_pad(dev, pad, ui))
            else:
                dev.close()
        await asyncio.sleep(2)


if __name__ == "__main__":
    asyncio.run(main())
