#!/bin/sh
# Ollie OS start-up, after the network is up.

# Pick the DRM device that drives a screen; on the Pi 5 the first one is the
# render-only GPU, which X would otherwise try and fail to use.
for card in /sys/class/drm/card[0-9]; do
    if ls -d "$card"-* >/dev/null 2>&1; then
        mkdir -p /etc/X11/xorg.conf.d
        cat > /etc/X11/xorg.conf.d/20-ollie.conf <<CONF
Section "Device"
    Identifier "screen"
    Driver "modesetting"
    Option "kmsdev" "/dev/dri/$(basename "$card")"
EndSection
CONF
        break
    fi
done

mkdir -p /userdata/downloads /userdata/ollie
chown ollie:ollie /userdata/ollie
chmod 1777 /userdata/downloads

/usr/local/bin/ollie-wifi-from-batocera &
/usr/local/bin/ollie-padmouse > /tmp/padmouse.log 2>&1 &
exit 0
