<!--
  Etros Metroid: an EmulationStation theme after Super Metroid.
  Deep-space background, the in-game energy HUD along the top, the pink and
  blue pause-screen map in the corner, and orange title lettering.
  The art in ./art is drawn by etros/scripts/make-art.py at build time.
-->
<theme>
	<formatVersion>6</formatVersion>

	<!-- EmulationStation's own loading screen -->
	<view name="splash">
		<image name="background">
			<path>./art/splash.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
		</image>
		<text name="label">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.022</fontSize>
			<color>58D8F8FF</color>
			<pos>0 0.84</pos>
			<size>1 0.05</size>
		</text>
	</view>

	<view name="system, basic, detailed, video, grid">
		<image name="background" extra="true">
			<path>./art/background.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="hud" extra="true">
			<path>./art/hud.png</path>
			<pos>0 0</pos>
			<size>1 0.09</size>
			<zIndex>5</zIndex>
		</image>
		<image name="minimap" extra="true">
			<path>./art/minimap.png</path>
			<pos>0.975 0.008</pos>
			<origin>1 0</origin>
			<maxSize>0.12 0.074</maxSize>
			<zIndex>6</zIndex>
		</image>
		<helpsystem name="help">
			<pos>0.02 0.955</pos>
			<textColor>F0F0F8FF</textColor>
			<iconColor>F87800FF</iconColor>
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.018</fontSize>
		</helpsystem>
	</view>

	<view name="system">
		<image name="etroslogo" extra="true">
			<path>./art/logo.png</path>
			<pos>0.5 0.17</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 0.16</maxSize>
			<zIndex>10</zIndex>
		</image>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.40</pos>
			<size>1 0.24</size>
			<color>08144080</color>
			<logoSize>0.30 0.14</logoSize>
			<maxLogoCount>3</maxLogoCount>
			<logoScale>1.3</logoScale>
			<minLogoOpacity>0.35</minLogoOpacity>
			<zIndex>40</zIndex>
		</carousel>
		<text name="logoText">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.042</fontSize>
			<color>F87800FF</color>
			<forceUppercase>true</forceUppercase>
		</text>
		<text name="systemInfo">
			<pos>0 0.66</pos>
			<size>1 0.06</size>
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.022</fontSize>
			<color>58D8F8FF</color>
			<backgroundColor>00000000</backgroundColor>
			<alignment>center</alignment>
		</text>
	</view>

	<view name="basic, detailed, video">
		<text name="systemname" extra="true">
			<text>${system.fullName}</text>
			<pos>0.5 0.02</pos>
			<origin>0.5 0</origin>
			<size>0.5 0.05</size>
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.03</fontSize>
			<color>F87800FF</color>
			<alignment>center</alignment>
			<forceUppercase>true</forceUppercase>
			<zIndex>7</zIndex>
		</text>
		<textlist name="gamelist">
			<pos>0.03 0.12</pos>
			<size>0.52 0.80</size>
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.024</fontSize>
			<lineSpacing>1.9</lineSpacing>
			<alignment>left</alignment>
			<horizontalMargin>0.012</horizontalMargin>
			<primaryColor>F0F0F8FF</primaryColor>
			<secondaryColor>58D8F8FF</secondaryColor>
			<selectorColor>F87800FF</selectorColor>
			<selectedColor>02041400</selectedColor>
			<selectorHeight>0.045</selectorHeight>
			<forceUppercase>true</forceUppercase>
			<zIndex>20</zIndex>
		</textlist>
	</view>

	<view name="detailed, video">
		<image name="md_image">
			<pos>0.77 0.13</pos>
			<origin>0.5 0</origin>
			<maxSize>0.38 0.40</maxSize>
			<zIndex>30</zIndex>
		</image>
		<video name="md_video">
			<pos>0.77 0.13</pos>
			<origin>0.5 0</origin>
			<maxSize>0.38 0.40</maxSize>
			<zIndex>31</zIndex>
		</video>
		<text name="md_description">
			<pos>0.58 0.56</pos>
			<size>0.39 0.36</size>
			<fontSize>0.026</fontSize>
			<color>F0F0F8FF</color>
			<zIndex>30</zIndex>
		</text>
		<text name="md_name"><visible>false</visible></text>
		<text name="md_lbl_rating"><visible>false</visible></text>
		<text name="md_lbl_releasedate"><visible>false</visible></text>
		<text name="md_lbl_developer"><visible>false</visible></text>
		<text name="md_lbl_publisher"><visible>false</visible></text>
		<text name="md_lbl_genre"><visible>false</visible></text>
		<text name="md_lbl_players"><visible>false</visible></text>
		<text name="md_lbl_lastplayed"><visible>false</visible></text>
		<text name="md_lbl_playcount"><visible>false</visible></text>
		<rating name="md_rating"><visible>false</visible></rating>
		<datetime name="md_releasedate"><visible>false</visible></datetime>
		<text name="md_developer"><visible>false</visible></text>
		<text name="md_publisher"><visible>false</visible></text>
		<text name="md_genre"><visible>false</visible></text>
		<text name="md_players"><visible>false</visible></text>
		<datetime name="md_lastplayed"><visible>false</visible></datetime>
		<text name="md_playcount"><visible>false</visible></text>
	</view>

	<!-- Menus look like the pause screen: dark blue, orange selection -->
	<view name="menu">
		<menuBackground name="menubg">
			<color>020414F2</color>
			<scrollbarColor>F87800FF</scrollbarColor>
		</menuBackground>
		<menuText name="menutitle">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<color>F87800FF</color>
		</menuText>
		<menuText name="menutext">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.024</fontSize>
			<color>F0F0F8FF</color>
			<selectorColor>F87800FF</selectorColor>
			<selectedColor>020414FF</selectedColor>
			<separatorColor>2870E880</separatorColor>
		</menuText>
		<menuText name="menufooter">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.016</fontSize>
			<color>58D8F8FF</color>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.018</fontSize>
			<color>58D8F8FF</color>
		</menuTextSmall>
		<menuGroup name="menugroup">
			<fontPath>./fonts/PressStart2P-Regular.ttf</fontPath>
			<fontSize>0.018</fontSize>
			<color>E848A8FF</color>
			<separatorColor>2870E8FF</separatorColor>
		</menuGroup>
	</view>
</theme>
