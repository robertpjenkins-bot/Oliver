#!/bin/bash
# Restart into Ollie OS. The choice lasts one boot: restarting or switching
# off in Ollie OS brings the device back to Batocera.

# Cards made with Ollie OS carry its Etros files in /boot/etros/ollie.
if ! test -d /boot/etros/ollie; then
    echo "Ollie OS is not on this card" >&2
    exit 1
fi

# Ollie OS as Arch Linux, not built yet: build it, or say it's on its way.
if [ -f /userdata/etros/ollie-is-arch.txt ] && [ ! -f /userdata/etros/ollie-rootfs.img ]; then
    msg="Ollie OS (Arch Linux) is still being set up: Etros says when it's ready."
    running=/userdata/system/etros/arch-setup.running
    if ! { [ -e "$running" ] && kill -0 "$(cat "$running")" 2>/dev/null; }; then
        setsid /usr/bin/etros-setup-arch < /dev/null > /dev/null 2>&1 &
        msg="Setting up Ollie OS (Arch Linux): 30 to 60 minutes. Etros says when it's ready."
    fi
    curl -s -o /dev/null -d "$msg" http://localhost:1234/notify 2>/dev/null
    echo "$msg" >&2
    exit 1
fi

mount -o remount,rw /boot || exit 1
echo ollie > /boot/etros/next-boot
sync
mount -o remount,ro /boot

shutdown -r now
