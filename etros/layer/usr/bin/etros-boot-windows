#!/bin/bash
# Restart into Windows 11 (Raspberry Pi 5). The Pi 5 starts from the
# WINBOOT partition (its UEFI firmware, then Windows) while autoboot.txt on
# the BATOCERA partition says boot_partition=4; Windows's Back to Etros icon
# takes it away again.

say() {
    echo "$1"
    curl -s -o /dev/null -d "$1" http://localhost:1234/notify 2>/dev/null
}

case "$(tr -d '\0' < /proc/device-tree/compatible 2>/dev/null)" in
    *bcm2712*) ;;
    *) say "Windows 11 needs the Raspberry Pi 5."; exit 1 ;;
esac

part=$(awk '$2 == "/boot" { print $1; exit }' /proc/mounts)
case "$part" in
    /dev/mmcblk*p1|/dev/nvme*p1) winboot=${part%p1}p4 ;;
    /dev/sd?1|/dev/vd?1) winboot=${part%1}4 ;;
    *) winboot= ;;
esac
if [ -z "$winboot" ] || [ "$(blkid -s LABEL -o value "$winboot" 2>/dev/null)" != WINBOOT ]; then
    say "This card has no room for Windows 11: run Etros Updater on a computer and choose Make room for Windows 11."
    exit 1
fi
mkdir -p /tmp/etros-winboot
if ! mount -o ro "$winboot" /tmp/etros-winboot; then
    say "Couldn't open the Windows start-up partition."
    exit 1
fi
installed=no
[ -f /tmp/etros-winboot/etros-win-installed.txt ] && installed=yes
umount /tmp/etros-winboot
if [ "$installed" != yes ]; then
    say "Windows 11 isn't installed yet: Boot into Ollie OS, then double-click Install Windows 11."
    exit 1
fi

mount -o remount,rw /boot || exit 1
printf '[all]\nboot_partition=4\n' > /boot/autoboot.txt
sync
mount -o remount,ro /boot
shutdown -r now
