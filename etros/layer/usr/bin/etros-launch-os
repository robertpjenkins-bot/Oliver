#!/bin/bash
# Start an old operating system from Etros's OS folder (/userdata/roms/os)
# in DOSBox-X: DOS, Windows 3.1, 95 and 98, and other systems of that age.
#
# Each one gets its own 2 GB hard disk (saves/os/<name>/c.img), so what's
# installed stays installed. While that disk has no system on it, the CD
# (or floppy) is started, to install from it; after that the hard disk is
# started, with the CD still in drive D. A CD that can't be started is
# opened at a DOS prompt in drive D instead.
#
# DOSBox-X is in Batocera for the Pi 5 but not for the R36S.

image=$1
log=/userdata/system/logs/etros-os.log
mkdir -p /userdata/system/logs
exec >> "$log" 2>&1
echo "=== $(date) $image"

say() {
    echo "$1"
    curl -s -o /dev/null -d "$1" http://localhost:1234/notify 2>/dev/null
}

dosbox=$(command -v dosbox-x || true)
if [ -z "$dosbox" ]; then
    say "Old operating systems need DOSBox-X, which only the Raspberry Pi 5 has."
    exit 1
fi

name=$(basename "${image%.*}")
dir=/userdata/saves/os/$name
mkdir -p "$dir"
disk=$dir/c.img
conf=$dir/dosbox-x.conf

if [ ! -f "$disk" ]; then
    # IMGMAKE: an empty 2 GB hard disk with one FAT16 partition.
    "$dosbox" -silent -nogui -nomenu -c "imgmake \"$disk\" -t hd_2gig" -c exit </dev/null
fi

# Does the hard disk start a system yet? (a boot sector on its partition)
installed=no
if [ -f "$disk" ]; then
    start=$(od -An -tu4 -j454 -N4 "$disk" | tr -d ' ')
    if [ "${start:-0}" -gt 0 ] &&
        [ "$(od -An -tx1 -j$((start * 512 + 510)) -N2 "$disk" | tr -d ' ')" = 55aa ] &&
        od -An -c -j$((start * 512 + 3)) -N8 "$disk" | grep -qE 'M S W I N|M S D O S|I B M|F R D O S'; then
        installed=yes
    fi
fi

case "${image,,}" in
    *.iso|*.cue) media="cd" ;;
    *) media="floppy" ;;
esac

{
    cat <<EOF
[sdl]
output=opengl
autolock=true
[dosbox]
working directory option=noprompt
machine=svga_s3
memsize=64
[cpu]
core=dynamic
cputype=pentium_mmx
cycles=max
[sblaster]
sbtype=sb16
[ide, secondary]
enable=true
[autoexec]
EOF
    if [ "$installed" = yes ]; then
        echo "imgmount c \"$disk\" -t hdd"
        [ "$media" = cd ] && echo "imgmount d \"$image\" -t iso -ide 2m"
        echo "boot c:"
    elif [ "$media" = cd ]; then
        echo "imgmount c \"$disk\" -t hdd"
        echo "imgmount d \"$image\" -t iso -ide 2m"
        # A CD that starts a system (an install CD) is started; otherwise
        # BOOT fails and this stays at a DOS prompt in drive D.
        echo "imgmount a -bootcd d"
        echo "boot a:"
        echo "d:"
    else
        echo "imgmount c \"$disk\" -t hdd"
        echo "imgmount a \"$image\" -t floppy"
        echo "boot a:"
    fi
} > "$conf"

echo "--- installed=$installed media=$media"
exec "$dosbox" -conf "$conf" -nomenu
