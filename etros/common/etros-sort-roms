#!/usr/bin/env python3
"""Move downloaded ROMs into the folders Batocera reads them from.

Files are sorted by extension. An extension that several systems share (.bin,
.iso, .cue, .chd...) says nothing about which console a game is for, so those
files are left in the downloads folder rather than guessed at; move them by
hand into /userdata/roms/<system>. A .zip holding ROMs of a single known type
goes to that system, still zipped, since Batocera's emulators read zips.
Arcade zips cannot be told apart from other zips, so put those in
/userdata/roms/mame yourself.

Runs on both Ollie OS and Batocera, so it only uses the standard library.
"""
import argparse
import os
import shutil
import subprocess
import sys
import time
import zipfile

SYSTEMS = {
    "nes": "nes", "unf": "nes", "unif": "nes", "fds": "fds",
    "sfc": "snes", "smc": "snes", "fig": "snes", "swc": "snes",
    "gb": "gb", "gbc": "gbc", "gba": "gba",
    "n64": "n64", "z64": "n64", "v64": "n64",
    "nds": "nds",
    "md": "megadrive", "gen": "megadrive", "smd": "megadrive",
    "sms": "mastersystem", "gg": "gamegear", "sg": "sg1000", "32x": "sega32x",
    "pce": "pcengine", "sgx": "supergrafx",
    "a26": "atari2600", "a52": "atari5200", "a78": "atari7800",
    "lnx": "lynx", "j64": "jaguar", "jag": "jaguar",
    "ngp": "ngp", "ngc": "ngpc",
    "ws": "wonderswan", "wsc": "wonderswancolor",
    "vb": "virtualboy", "col": "colecovision", "int": "intellivision",
    "pbp": "psp", "cso": "psp",
    "d64": "c64", "t64": "c64", "prg": "c64",
    "z80": "zxspectrum", "tzx": "zxspectrum",
    "mx1": "msx1", "mx2": "msx2",
    "p8": "pico8",
    "exe": "windows", "msi": "windows",
}

# Browsers write these while a download is still running.
PARTIAL = (".crdownload", ".part", ".download", ".tmp")


def extension(name):
    lower = name.lower()
    if lower.endswith(".p8.png"):
        return "p8"
    return os.path.splitext(lower)[1].lstrip(".")


# What ROM downloads carry besides the game: they don't say which console.
EXTRAS = {"txt", "nfo", "diz", "url", "htm", "html", "pdf", "jpg", "jpeg", "png", "gif", "bmp",
          "md", "doc", "rtf", "xml", "dat", "sfv", "md5", "sha1", "ini", "cfg", "srm", "sav"}


def sevenzip_names(path):
    """The file names in a .7z, read with Python alone: Raspberry Pi OS
    doesn't come with a 7z program. Handles archives whose header is
    stored plain or packed with LZMA or LZMA2, as 7-Zip writes them."""
    import lzma
    import struct

    with open(path, "rb") as f:
        start = f.read(32)
        if len(start) < 32 or start[:6] != b"7z\xbc\xaf\x27\x1c":
            return None
        offset, size = struct.unpack_from("<QQ", start, 12)
        f.seek(32 + offset)
        header = f.read(size)

        class Reader:
            def __init__(self, data):
                self.d, self.i = data, 0

            def byte(self):
                self.i += 1
                return self.d[self.i - 1]

            def num(self):  # 7z's variable-length number
                first = self.byte()
                mask, value = 0x80, 0
                for n in range(8):
                    if not first & mask:
                        return value | ((first & (mask - 1)) << (8 * n))
                    value |= self.byte() << (8 * n)
                    mask >>= 1
                return value

            def take(self, n):
                self.i += n
                return self.d[self.i - n:self.i]

            def bits(self, count):  # a defined-bits vector, maybe "all defined"
                if self.byte():
                    return [True] * count
                out, b, mask = [], 0, 0
                for _ in range(count):
                    if not mask:
                        b, mask = self.byte(), 0x80
                    out.append(bool(b & mask))
                    mask >>= 1
                return out

        def streams_info(r):
            """Pack position, pack sizes and folders (coders, unpack sizes)."""
            info = {"pos": 0, "packs": [], "folders": []}
            while True:
                t = r.byte()
                if t == 0x00:
                    return info
                if t == 0x06:  # PackInfo
                    info["pos"] = r.num()
                    n = r.num()
                    while True:
                        t2 = r.byte()
                        if t2 == 0x00:
                            break
                        if t2 == 0x09:
                            info["packs"] = [r.num() for _ in range(n)]
                        elif t2 == 0x0A:
                            for ok in r.bits(n):
                                if ok:
                                    r.take(4)
                elif t == 0x07:  # UnPackInfo
                    assert r.byte() == 0x0B
                    nf = r.num()
                    assert r.byte() == 0  # not external
                    for _ in range(nf):
                        coders, outs = [], 0
                        for _ in range(r.num()):
                            flags = r.byte()
                            cid = r.take(flags & 0x0F)
                            nout = 1
                            if flags & 0x10:
                                r.num()
                                nout = r.num()
                            props = r.take(r.num()) if flags & 0x20 else b""
                            coders.append((cid, props))
                            outs += nout
                        for _ in range(outs - 1):  # bind pairs
                            r.num(); r.num()
                        info["folders"].append({"coders": coders, "outs": outs})
                    assert r.byte() == 0x0C
                    for fo in info["folders"]:
                        fo["sizes"] = [r.num() for _ in range(fo["outs"])]
                    t2 = r.byte()
                    if t2 == 0x0A:
                        for ok in r.bits(nf):
                            if ok:
                                r.take(4)
                        t2 = r.byte()
                    assert t2 == 0x00
                elif t == 0x08:  # SubStreamsInfo: not needed for names
                    counts = [1] * len(info["folders"])
                    while True:
                        t2 = r.byte()
                        if t2 == 0x00:
                            break
                        if t2 == 0x0D:
                            counts = [r.num() for _ in info["folders"]]
                        elif t2 == 0x09:
                            for c in counts:
                                for _ in range(c - 1):
                                    r.num()
                        elif t2 == 0x0A:
                            total = sum(counts)
                            for ok in r.bits(total):
                                if ok:
                                    r.take(4)
                else:
                    raise ValueError("7z: unexpected %#x" % t)

        r = Reader(header)
        t = r.byte()
        if t == 0x17:  # the header itself is packed
            info = streams_info(r)
            folder = info["folders"][0]
            cid, props = folder["coders"][0]
            if cid == b"\x03\x01\x01":  # LZMA
                lc, lp, pb = props[0] % 9, (props[0] // 9) % 5, props[0] // 45
                dict_size = struct.unpack_from("<I", props, 1)[0]
                filt = {"id": lzma.FILTER_LZMA1, "dict_size": dict_size, "lc": lc, "lp": lp, "pb": pb}
            elif cid == b"\x21":  # LZMA2
                filt = {"id": lzma.FILTER_LZMA2}
            elif cid == b"\x00":  # stored
                filt = None
            else:
                return None
            f.seek(32 + info["pos"])
            packed = f.read(info["packs"][0])
            if filt is None:
                header = packed
            else:
                dec = lzma.LZMADecompressor(lzma.FORMAT_RAW, filters=[filt])
                header = dec.decompress(packed, max_length=folder["sizes"][-1])
            r = Reader(header)
            t = r.byte()
        if t != 0x01:
            return None
        names = []
        while True:
            t = r.byte()
            if t == 0x00:
                break
            if t == 0x02:  # archive properties
                while r.byte() != 0x00:
                    r.take(r.num())
            elif t in (0x03, 0x04):
                streams_info(r)
            elif t == 0x05:  # FilesInfo
                n = r.num()
                dirs = [False] * n
                while True:
                    p = r.byte()
                    if p == 0x00:
                        break
                    data = Reader(r.take(r.num()))
                    if p == 0x11:  # names
                        data.byte()  # not external
                        raw = data.d[data.i:]
                        names = [s for s in raw.decode("utf-16-le").split("\x00")][:n]
                    elif p == 0x15:  # attributes: a folder has 0x10
                        defined = data.bits(n)
                        data.byte()
                        for k in range(n):
                            if defined[k]:
                                attr = struct.unpack("<I", data.take(4))[0]
                                dirs[k] = bool(attr & 0x10)
                return [nm for nm, d in zip(names, dirs) if not d]
        return names


def archive_names(path):
    """The file names inside a .zip, .7z or .rar, or None if it can't be read."""
    ext = extension(path)
    if ext == "zip":
        try:
            with zipfile.ZipFile(path) as z:
                return [n for n in z.namelist() if not n.endswith("/")]
        except (zipfile.BadZipFile, OSError):
            return None
    if ext == "7z":
        try:
            names = sevenzip_names(path)
        except Exception:  # a damaged or unusual archive: try a program below
            names = None
        if names:
            return names
    # Otherwise (and for .rar) a program, if there is one: 7z or bsdtar.
    for cmd in (["7z", "l", "-ba", "-slt", path], ["7zr", "l", "-ba", "-slt", path], ["bsdtar", "-tf", path]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode != 0:
            continue
        if cmd[0] == "bsdtar":
            return [n for n in r.stdout.splitlines() if n and not n.endswith("/")]
        return [l[len("Path = "):] for l in r.stdout.splitlines()
                if l.startswith("Path = ") and l[len("Path = "):] != path]
    return None


def archive_system(path):
    """The system for an archive whose games all share one known ROM
    extension (readme files and pictures beside them don't count)."""
    names = archive_names(path)
    if not names:
        return None
    systems = {SYSTEMS.get(extension(n)) for n in names if extension(n) not in EXTRAS}
    if len(systems) == 1:
        return systems.pop()
    return None


def system_for(path):
    ext = extension(path)
    if ext in ("zip", "7z", "rar"):
        return archive_system(path)
    return SYSTEMS.get(ext)


def sort_downloads(downloads, roms, dry_run=False, out=sys.stdout, settle=0):
    """Sort the files in downloads. With settle, files changed in the last
    settle seconds are left for next time: they may still be arriving."""
    moved = left = 0
    if not os.path.isdir(downloads):
        return moved, left
    now = time.time()
    for name in sorted(os.listdir(downloads)):
        src = os.path.join(downloads, name)
        if not os.path.isfile(src) or name.startswith(".") or name.lower().endswith(PARTIAL):
            continue
        if settle and now - os.path.getmtime(src) < settle:
            continue
        system = system_for(src)
        if system is None:
            left += 1
            continue
        dest_dir = os.path.join(roms, system)
        dest = os.path.join(dest_dir, name)
        if os.path.exists(dest):
            print(f"kept {name}: {system} already has a file with that name", file=out)
            left += 1
            continue
        print(f"{name} -> roms/{system}", file=out)
        if not dry_run:
            os.makedirs(dest_dir, exist_ok=True)
            shutil.move(src, dest)
        moved += 1
    return moved, left


# Downloads/My ROMs has a folder per console: anything put in one goes to
# that console, whatever its extension. These are the names shown, and the
# Batocera folder each one fills.
CONSOLE_FOLDERS = {
    "NES": "nes", "SNES": "snes", "Nintendo 64": "n64",
    "Game Boy": "gb", "Game Boy Color": "gbc", "Game Boy Advance": "gba",
    "Nintendo DS": "nds",
    "Sega Genesis - Mega Drive": "megadrive", "Sega Master System": "mastersystem",
    "Sega Game Gear": "gamegear", "Sega CD": "segacd", "Sega Saturn": "saturn",
    "Dreamcast": "dreamcast",
    "PlayStation": "psx", "PSP": "psp",
    "Arcade": "mame", "Neo Geo": "neogeo",
    "PC Engine - TurboGrafx-16": "pcengine",
    "Atari 2600": "atari2600", "Atari Lynx": "lynx",
    "DOS": "dos", "ScummVM": "scummvm",
    "Windows": "windows", "Old operating systems (OS)": "os",
}
NOT_SORTED = "Not sorted - move these into a console folder"
README = """MY ROMS

Put a ROM here and Etros moves it to the right console by itself, in a few
seconds. It works out the console from the file (.sfc is SNES, .gba is Game
Boy Advance, and so on).

Some files could be for many consoles: .bin, .iso, .cue, .chd, .7z and arcade
.zip. Put those in the console's folder here instead (PlayStation, Arcade...).
Anything in a console folder goes to that console, and a game that is a folder
of files moves as one.

Files Etros can't place go into "%s".
""" % NOT_SORTED


def _settled(path, now, settle):
    """Nothing in path (a file or a folder) changed in the last settle seconds."""
    if not settle:
        return True
    newest = os.path.getmtime(path)
    if os.path.isdir(path):
        for top, dirs, files in os.walk(path):
            for n in dirs + files:
                try:
                    newest = max(newest, os.path.getmtime(os.path.join(top, n)))
                except OSError:
                    pass
    return now - newest >= settle


def _busy(name):
    return name.startswith(".") or name.lower().endswith(PARTIAL)


def _move(src, roms, system, out, dry_run):
    dest_dir = os.path.join(roms, system)
    dest = os.path.join(dest_dir, os.path.basename(src))
    if os.path.exists(dest):
        print(f"kept {os.path.basename(src)}: {system} already has one with that name", file=out)
        return False
    print(f"{os.path.basename(src)} -> roms/{system}", file=out)
    if not dry_run:
        os.makedirs(dest_dir, exist_ok=True)
        shutil.move(src, dest)
    return True


def sort_my_roms(base, roms, dry_run=False, out=sys.stdout, settle=0):
    """Sort Downloads/My ROMs: console folders first, then loose files (also
    inside downloaded folders). Returns how many games moved."""
    now = time.time()
    moved = 0
    if not dry_run:
        # This runs as root; the folders must be open to the person dropping
        # ROMs in (Ollie OS's desktop user, or a computer on the network).
        for name in [NOT_SORTED, *CONSOLE_FOLDERS]:
            folder = os.path.join(base, name)
            if not os.path.isdir(folder):
                os.makedirs(folder)
                os.chmod(folder, 0o777)
        readme = os.path.join(base, "READ ME.txt")
        if not os.path.exists(readme):
            with open(readme, "w") as f:
                f.write(README)

    for name, system in CONSOLE_FOLDERS.items():
        folder = os.path.join(base, name)
        if not os.path.isdir(folder):
            continue
        for entry in sorted(os.listdir(folder)):
            src = os.path.join(folder, entry)
            if _busy(entry) or not _settled(src, now, settle):
                continue
            moved += _move(src, roms, system, out, dry_run)

    # What an older sorter couldn't place may be recognised now (a .7z, say).
    stuck = os.path.join(base, NOT_SORTED)
    if os.path.isdir(stuck):
        for name in sorted(os.listdir(stuck)):
            src = os.path.join(stuck, name)
            if os.path.isfile(src) and not _busy(name) and _settled(src, now, settle):
                system = system_for(src)
                if system:
                    moved += _move(src, roms, system, out, dry_run)

    skip = set(CONSOLE_FOLDERS) | {NOT_SORTED}
    for top, dirs, files in os.walk(base):
        if top == base:
            dirs[:] = [d for d in dirs if d not in skip]
        for name in sorted(files):
            src = os.path.join(top, name)
            if (top == base and name == "READ ME.txt") or _busy(name) or not _settled(src, now, settle):
                continue
            system = system_for(src)
            if system and _move(src, roms, system, out, dry_run):
                moved += 1
            elif not system and not dry_run:
                dest = os.path.join(base, NOT_SORTED, name)
                if not os.path.exists(dest):
                    print(f"{name}: can't tell which console, moved to \"{NOT_SORTED}\"", file=out)
                    shutil.move(src, dest)
    # Downloaded folders left empty after sorting.
    if not dry_run:
        for entry in os.listdir(base):
            path = os.path.join(base, entry)
            if entry not in skip and os.path.isdir(path):
                for top, _, _ in sorted(os.walk(path), reverse=True):
                    try:
                        os.rmdir(top)
                    except OSError:
                        pass
    return moved


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--downloads", default="/userdata/downloads")
    p.add_argument("--roms", default="/userdata/roms")
    p.add_argument("-n", "--dry-run", action="store_true")
    p.add_argument("--watch", action="store_true",
                   help="keep going, sorting whatever arrives (for the My ROMs folder)")
    p.add_argument("--settle", type=float, default=0,
                   help="leave files changed in the last this many seconds")
    p.add_argument("--on-move", help="command to run after moving something")
    p.add_argument("--my-roms", action="store_true",
                   help="DOWNLOADS is the My ROMs folder: with a folder per console")
    args = p.parse_args()

    def once(settle):
        if args.my_roms:
            return sort_my_roms(args.downloads, args.roms, args.dry_run, settle=settle)
        moved, left = sort_downloads(args.downloads, args.roms, args.dry_run, settle=settle)
        print(f"moved {moved}, left {left} in {args.downloads}")
        return moved

    if not args.watch:
        once(args.settle)
        return
    os.makedirs(args.downloads, exist_ok=True)
    while True:
        try:
            moved = once(args.settle)
            sys.stdout.flush()
            if moved and args.on_move:
                subprocess.run(args.on_move, shell=True)
        except OSError as e:
            print(f"etros-sort-roms: {e}", file=sys.stderr)
        time.sleep(3)


if __name__ == "__main__":
    main()
