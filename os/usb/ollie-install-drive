#!/bin/bash
# Ollie OS Drive Writer: makes Ollie OS right on a drive, from SteamOS or any
# Linux (not from Ollie OS itself). Pick the drive (it is erased), and Ollie OS
# is installed onto all of it, ready to start, with all of the drive's room
# for Steam and everything you save.
#
# No GitHub and no ISO. Arch Linux comes from the Arch Linux servers (or a
# copy of it found in Downloads, such as the one Annie OS Maker leaves
# there), and is made into Ollie OS on the drive by the Ollie OS recipe
# inside this app: the same recipe the ISO is built from (os/build.sh, with
# os/build-drive.sh), finished by Ollie OS's own installer, so the drive
# starts on the Steam Machine, Dells, Intel Macs and older BIOS computers.
# Arch's packages are downloaded onto the drive itself. What it needs on this
# computer for the while (about 4 GB, in the Ollie-OS-Drive-Writer folder in
# your home folder) is removed when it is done. At the end it checks the
# drive, fixes what is wrong, and saves the report in Downloads.
#
#   ollie-install-drive
#
# Writing to a drive needs this computer's admin rights: on SteamOS that is
# your password (set one with passwd in Konsole).
# For tests: OLLIE_DRIVE=/dev/... and OLLIE_DRIVE_YES=1 (no questions);
# OLLIE_DRIVE_BOOTSTRAP=FILE, an Arch Linux bootstrap to use as it is, or a
# folder with an Arch Linux in it, used in place (and changed).
set -uo pipefail

bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' reset=$'\e[0m'
say() { printf '\n%s==>%s %s%s%s\n' "$teal$bold" "$reset" "$bold" "$*" "$reset"; }
die() {
    printf '\n%sError:%s %s\n\nPress Enter to close.' "$red$bold" "$reset" "$*" >&2
    read -r _ || true
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
readonly NEED_BYTES=$((32 * 1000 * 1000 * 1000))
readonly BOOTSTRAP=archlinux-bootstrap-x86_64.tar.zst
# Started from the desktop, some systems leave chroot's folder out of PATH.
PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"

# Runs as root of a namespace of its own: unpacks Arch Linux, gives it what a
# running system has (this computer's drives among it), and in it the recipe
# installs Ollie OS onto the drive (os/build.sh with OLLIE_BUILD_DISK). Every
# mount is in this namespace only and goes with it.
build_inside() { # build_inside BOOTSTRAP ROOT SRC TMP CACHE DISK TIMEZONE
    local bootstrap=$1 root=$2 src=$3 tmp=$4 cache=$5 disk=$6 tz=$7 opts
    printf '\e[1;36m==> Unpacking Arch Linux\e[0m\n'
    rm -rf --one-file-system "${root:?}" && mkdir -p "$root" "$tmp" "$cache" && chmod 1777 "$tmp" || return 1
    mount --make-rprivate / || return 1
    if [[ -d $bootstrap ]]; then
        mount --bind "$bootstrap" "$root" || return 1
    else
        opts=(--numeric-owner)
        tar --help 2>/dev/null | grep -q -- --warning= && opts+=(--warning=no-unknown-keyword)
        case "$bootstrap" in *.zst) opts+=(--zstd) ;; *.gz) opts+=(--gzip) ;; esac
        tar -x --strip-components=1 "${opts[@]}" -f "$bootstrap" -C "$root" || return 1
        mount --bind "$root" "$root" || return 1
    fi
    mkdir -p "$root/src" "$root/var/cache/pacman/pkg" &&
        mount -t proc proc "$root/proc" &&
        mount --rbind /sys "$root/sys" &&
        mount --rbind /dev "$root/dev" &&
        mount -t tmpfs -o mode=0755 tmpfs "$root/run" &&
        mount --bind "$tmp" "$root/tmp" &&
        mount --bind "$src" "$root/src" &&
        mount --bind "$cache" "$root/var/cache/pacman/pkg" || return 1
    if [[ -d /run/udev ]]; then
        mkdir -p "$root/run/udev" && mount --bind /run/udev "$root/run/udev" || return 1
    fi
    rm -f "${root:?}/etc/resolv.conf"
    cp -L /etc/resolv.conf "$root/etc/resolv.conf" 2>/dev/null
    # The Arch servers for everywhere (the same as in the Arch Linux container).
    sed -i '/^## Worldwide/,/^$/ s/^#Server/Server/' "$root/etc/pacman.d/mirrorlist"
    # shellcheck disable=SC2016 # pacman's own $repo and $arch
    grep -q '^Server' "$root/etc/pacman.d/mirrorlist" ||
        echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' >>"$root/etc/pacman.d/mirrorlist"
    chroot "$root" /usr/bin/env -i HOME=/root TERM="${TERM:-dumb}" LANG=C.UTF-8 \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/bin OLLIE_BUILD_DISK="$disk" OLLIE_INSTALL_TIMEZONE="$tz" \
        bash -c 'pacman-key --init && pacman-key --populate archlinux && cd /src && exec bash os/build.sh'
}

# --- As root: install Ollie OS onto the drive ------------------------------------------
if [[ "${1:-}" == --root ]]; then
    work=${2:?} bootstrap=${3:?} disk=${4:?} tz=${5:-UTC} owner=${6:?}
    [[ $EUID -eq 0 ]] || die "this part runs as root"
    # Run from a copy in /tmp (root cannot read inside the AppImage): it goes.
    [[ "${BASH_SOURCE[0]}" == /tmp/ollie-install-drive.* ]] && rm -f -- "${BASH_SOURCE[0]}"
    src=$work/src root=$work/arch-root tmp=$work/build-tmp cache=$work/pkg-cache log=$work/drive-writer.log
    # Nothing of the drive may stay in use, and this computer must not open
    # it while Ollie OS is written to it (SteamOS opens drives plugged in by
    # itself): its parts are closed now, and every few seconds until done.
    free_drive() {
        local part
        for part in $(lsblk -lnpo NAME "$disk" | tail -n +2); do
            umount "$part" 2>/dev/null
            swapoff "$part" 2>/dev/null
        done
    }
    free_drive
    if lsblk -lnpo MOUNTPOINTS "$disk" | grep -q .; then
        die "a part of the drive is still in use: close what has files open on it (or eject it in the file manager and plug it in again), then try again."
    fi
    (while sleep 3; do free_drive; done) &
    watcher=$!
    finish() {
        kill "$watcher" 2>/dev/null
        # The Arch Linux it worked in and the recipe go; only the report stays.
        rm -rf --one-file-system "${src:?}" "${root:?}" "${tmp:?}" "${cache:?}" "${log:?}" 2>/dev/null
        free_drive
        return 0
    }
    trap finish EXIT
    rm -rf --one-file-system "${src:?}" && mkdir -p "$src" && tar -xzf "$work/ollie-os-source.tar.gz" -C "$src" ||
        die "could not unpack the Ollie OS recipe (is this computer's disk full?)."

    start=$(date +%s)
    unshare --mount --pid --fork --kill-child -- bash -c "$(declare -f build_inside)"'; build_inside "$@"' build_inside \
        "$bootstrap" "$root" "$src" "$tmp" "$cache" "$disk" "$tz" </dev/null >"$log" 2>&1 &
    pid=$!
    # Its steps as they come (the recipe's and the installer's, not every
    # line), and how far the install is.
    last=""
    while kill -0 "$pid" 2>/dev/null; do
        sleep 3
        now="$(grep -a -E $'^\e\\[1;36m==> |^\e\\[36m\e\\[1m==>|^PROGRESS [0-9]+ ' "$log" 2>/dev/null | tail -n 1 | sed 's/\x1b\[[0-9;]*m//g')"
        [[ -n $now && $now != "$last" ]] || continue
        last=$now
        mins=$((($(date +%s) - start) / 60))
        if [[ $now == PROGRESS* ]]; then
            read -r _ pct text <<<"$now"
            printf '\r  %3d%%  %-56.56s %3d min' "$pct" "$text" "$mins"
        else
            printf '\n  %-62.62s %3d min\n' "${now#==> }" "$mins"
        fi
    done
    wait "$pid"
    rc=$?
    echo
    report=$src/os/out/Ollie-OS-check.txt
    if [[ -s $report ]]; then
        cp -f "$report" "$work/Ollie-OS-check.txt" && chown "$owner" "$work/Ollie-OS-check.txt"
    fi
    sed 's/\x1b\[[0-9;]*m//g' "$log" >"$work/Ollie-OS-Drive-Writer.log" && chown "$owner" "$work/Ollie-OS-Drive-Writer.log"
    sync
    if ((rc != 0 && rc != 3)); then
        echo
        grep -a -v '^PROGRESS ' "$work/Ollie-OS-Drive-Writer.log" | tail -n 15
    fi
    exit "$rc"
fi

# --- A terminal to talk in -----------------------------------------------------------
if [[ ! -t 0 && -z "${OLLIE_DRIVE_IN_TERMINAL:-}" ]]; then
    export OLLIE_DRIVE_IN_TERMINAL=1
    self="${APPIMAGE:-$(realpath -- "$0")}"
    for term in konsole gnome-terminal kgx xfce4-terminal xterm; do
        have "$term" || continue
        case "$term" in
        konsole) exec konsole --hold -e "$self" "$@" ;;
        gnome-terminal | kgx) exec "$term" -- "$self" "$@" ;;
        *) exec "$term" -hold -e "$self" "$@" ;;
        esac
    done
    msg="No terminal program found. Run this from a terminal instead."
    have kdialog && kdialog --error "$msg"
    have zenity && zenity --error --text="$msg"
    exit 1
fi

printf '\n%s  Ollie OS Drive Writer%s  (makes Ollie OS from Arch Linux, right on a drive)\n' "$bold" "$reset"
if [[ -x /usr/local/bin/ollie-first-setup ]]; then
    echo "  (This is Ollie OS: \"Install Ollie OS\" in its apps menu installs it onto a drive from here.)"
fi
for tool in curl tar zstd gzip unshare chroot sha256sum lsblk findmnt mount sudo; do
    have "$tool" || die "this computer is missing $tool."
done

# --- 1. The recipe -------------------------------------------------------------------
here="$(cd "$(dirname "$0")" && pwd)"
recipe=""
for f in "${OLLIE_BUILD_SOURCE:-}" "$here/../share/ollie-build/ollie-os-source.tar.gz" "$here/ollie-os-source.tar.gz"; do
    [[ -n $f && -f $f ]] && { recipe=$f; break; }
done
[[ -n $recipe ]] || die "this copy of the Drive Writer has no Ollie OS recipe inside (ollie-os-source.tar.gz)."

# --- 2. The drive ------------------------------------------------------------------------
# Never a drive this computer itself runs from.
system=""
for m in / /home /boot /boot/efi /efi /var /usr /run/archiso/bootmnt; do
    s="$(findmnt -no SOURCE --mountpoint "$m" 2>/dev/null | sed 's/\[.*//')"
    [[ -n $s ]] && system+=" $(lsblk -sno NAME,TYPE "$s" 2>/dev/null | awk '$2 == "disk" {gsub(/[^A-Za-z0-9]/, "", $1); print $1}') "
done
contents() { # contents DISK: what is on it now, in a few words
    local fs labels
    fs="$(lsblk -nro FSTYPE "$1" | sort -u | tr '\n' ' ')" labels="$(lsblk -nro LABEL "$1" | tr '\n' ' ')"
    if [[ "$labels" == *OLLIE_BOOT* ]]; then echo "has Ollie OS on it"
    elif [[ "$fs" == *apfs* || "$fs" == *hfsplus* ]]; then echo "has macOS on it"
    elif [[ "$fs" == *ntfs* ]]; then echo "has Windows files on it"
    elif [[ -z "${fs// /}" ]]; then echo "empty"
    else echo "has files on it ($fs)"
    fi
}
disk="${OLLIE_DRIVE:-}"
if [[ -z $disk ]]; then
    say "Drives to install Ollie OS onto (32 GB or more; the one this computer runs from is not listed)"
    echo
    disks=()
    while read -r name type; do
        [[ $type == disk ]] || continue
        case "$name" in loop* | zram* | sr* | ram* | nbd*) continue ;; esac
        [[ "$system" == *" $name "* ]] && continue
        bytes="$(lsblk -bdno SIZE "/dev/$name")"
        ((bytes >= NEED_BYTES)) || continue
        disks+=("/dev/$name")
        tran="$(lsblk -dno TRAN "/dev/$name" | xargs)"
        printf '  %d) %-12s %8s  %-4s %-28s %s\n' "${#disks[@]}" "/dev/$name" "$(lsblk -dno SIZE "/dev/$name" | xargs)" \
            "${tran^^}" "$(lsblk -dno MODEL "/dev/$name" | xargs | cut -c1-28)" "$(contents "/dev/$name")"
    done < <(lsblk -dnro NAME,TYPE)
    ((${#disks[@]} > 0)) || die "no drive of 32 GB or more was found. Plug in the drive for Ollie OS, then run this again."
    echo
    read -rp "Install Ollie OS onto which drive? [1-${#disks[@]}] " pick
    [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#disks[@]})) || die "no such drive; nothing was changed."
    disk="${disks[pick - 1]}"
fi
[[ -b $disk && "$(lsblk -dno TYPE "$disk")" == disk ]] || die "$disk is not a drive."
[[ "$system" != *" ${disk#/dev/} "* ]] || die "$disk is the drive this computer runs from."

echo
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$disk"
printf '\n%sEVERYTHING on %s (%s, %s) will be erased%s, and Ollie OS gets all of it.\n' \
    "$red$bold" "$disk" "$(lsblk -dno SIZE "$disk" | xargs)" "$(contents "$disk")" "$reset"
if [[ -z "${OLLIE_DRIVE_YES:-}" ]]; then
    read -rp "Type ERASE to install Ollie OS onto it: " answer
    [[ "$answer" == ERASE ]] || die "cancelled; nothing was changed."
fi
tz="$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')"

# --- 3. Room on this computer, for the while ------------------------------------------------
work="${OLLIE_DRIVE_DIR:-$HOME/Ollie-OS-Drive-Writer}"
mkdir -p "$work" || die "could not make $work."
free_kb="$(df -Pk "$work" | awk 'NR == 2 {print $4}')"
if ((${free_kb:-0} < 5 * 1024 * 1024)); then
    die "not enough free space on this computer: it needs about 5 GB for the while (Ollie OS itself goes onto the drive), $work has $((free_kb / 1024 / 1024)) GB free."
fi
cp -f "$recipe" "$work/ollie-os-source.tar.gz" || die "could not copy the recipe to $work."

# --- 4. Arch Linux: a copy found on this computer, or from the Arch servers ------------------
# A copy is used if it is recent (Arch's monthly "bootstrap" download; one
# much older may not take today's packages), else downloaded fresh and
# checked against the Arch servers' checksums.
bootstrap="${OLLIE_DRIVE_BOOTSTRAP:-}" downloaded="" found=""
if [[ -z $bootstrap ]]; then
    found="$(find "$work" "$HOME/Downloads" "$HOME/Desktop" "$here" -maxdepth 1 -type f \
        \( -name 'archlinux-bootstrap*x86_64.tar.zst' -o -name 'archlinux-bootstrap*x86_64.tar.gz' \) \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1 | cut -d ' ' -f 2-)"
    if [[ -n $found && -n "$(find "$found" -mtime -100 2>/dev/null)" ]]; then
        say "Using the Arch Linux found on this computer: $found"
        if { case "$found" in *.zst) zstd -tq "$found" ;; *) gzip -t "$found" ;; esac; } 2>/dev/null; then
            bootstrap=$found
        else
            echo "  (It is damaged; downloading Arch Linux instead.)"
        fi
    fi
fi
if [[ -z $bootstrap ]]; then
    say "Downloading Arch Linux from the Arch Linux servers (about 150 MB)"
    part="$work/$BOOTSTRAP.part"
    find "$work" -maxdepth 1 -name "$BOOTSTRAP.part" -mtime +0 -exec rm -f {} + 2>/dev/null
    for base in ${OLLIE_BUILD_ARCH_MIRRORS:-https://geo.mirror.pkgbuild.com https://fastly.mirror.pkgbuild.com https://mirror.rackspace.com/archlinux https://mirrors.kernel.org/archlinux}; do
        sum="$(curl -fsSL --retry 3 "$base/iso/latest/sha256sums.txt" 2>/dev/null | awk -v f="$BOOTSTRAP" '$2 == f {print $1}')"
        [[ -n $sum ]] || continue
        if curl -fL --retry 5 -C - -o "$part" "$base/iso/latest/$BOOTSTRAP"; then
            if [[ "$(sha256sum "$part" | cut -d ' ' -f 1)" == "$sum" ]] && mv -f "$part" "$work/$BOOTSTRAP"; then
                bootstrap="$work/$BOOTSTRAP" downloaded=1
                break
            fi
            rm -f -- "${part:?}" # damaged: start over from the next server
        fi
    done
    if [[ -z $bootstrap && -n $found ]]; then
        echo "  (Could not download it; using the older copy found on this computer: $found)"
        bootstrap=$found
    fi
    [[ -n $bootstrap ]] || die "could not download Arch Linux from the Arch servers. Is the internet connected? Run this again to retry."
fi

# --- 5. Installing (as root) ------------------------------------------------------------------
say "Writing to a drive needs this computer's admin rights"
copy="$(mktemp /tmp/ollie-install-drive.XXXXXX)"
cat -- "${BASH_SOURCE[0]}" >"$copy"
if [[ $EUID -ne 0 ]]; then
    sudo -v || die "that password did not work. On SteamOS, set one with  passwd  in Konsole, then try again."
fi
say "Making Ollie OS on $disk (30 to 90 minutes; it is fine to leave it running)"
echo "  Arch Linux's packages are downloaded onto the drive, then set up as Ollie OS. The steps show below."
if [[ $EUID -eq 0 ]]; then
    bash "$copy" --root "$work" "$bootstrap" "$disk" "${tz:-UTC}" "$(id -u):$(id -g)"
else
    sudo bash "$copy" --root "$work" "$bootstrap" "$disk" "${tz:-UTC}" "$(id -u):$(id -g)"
fi
rc=$?
rm -f -- "$copy"

# --- 6. The report, and this computer cleaned up ------------------------------------------------
mkdir -p "$HOME/Downloads"
saved=""
if [[ -s "$work/Ollie-OS-check.txt" ]]; then
    mv -f "$work/Ollie-OS-check.txt" "$HOME/Downloads/Ollie-OS-Drive-check.txt" && saved="$HOME/Downloads/Ollie-OS-Drive-check.txt"
fi
if ((rc != 0 && rc != 3)); then
    mv -f "$work/Ollie-OS-Drive-Writer.log" "$HOME/Downloads/Ollie-OS-Drive-Writer-problem.txt" 2>/dev/null
    [[ -n $downloaded ]] && echo "  (Arch Linux stays in $work, so trying again is quicker.)"
    die "Ollie OS could not be made on the drive (see above; all of it is in Downloads, Ollie-OS-Drive-Writer-problem.txt). Run this again to retry."
fi
rm -f -- "$work/Ollie-OS-Drive-Writer.log" "$work/ollie-os-source.tar.gz" "$work/$BOOTSTRAP" "$work/$BOOTSTRAP.part"
rmdir -- "$work" 2>/dev/null
echo "  (What it put on this computer is removed.)"

echo
[[ -n $saved ]] && cat "$saved"
if ((rc == 3)); then
    printf '\n%s  Ollie OS is on %s, but the check found problems (above).%s Run the Drive Writer again to fix them.\n' "$yellow$bold" "$disk" "$reset"
else
    printf '\n%s  Done: Ollie OS is installed on %s, and checked.%s\n' "$green$bold" "$disk" "$reset"
fi
[[ -n $saved ]] && echo "  The check is saved in Downloads: $(basename "$saved")"
cat <<EOF

  Plug the drive into the computer for Ollie OS and start from it:
    Dell: tap F12 at the Dell logo and pick the drive ("UEFI: ..." or "OLLIE_BOOT").
    Mac:  hold Option while it starts and pick "EFI Boot".
    Steam Machine: hold Volume Down and pick the drive.
  On its first start it asks you to make a username and password.

Press Enter to close.
EOF
read -r _ || true
