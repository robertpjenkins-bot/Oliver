#!/bin/bash
# Windows Boot Updater: on an Ollie OS installed on a drive, plugged into a
# computer that has Windows 10 (or 11), puts Windows on Ollie OS's start-up
# menu (ollie-windows-boot) and adds "Restart into Windows" to the apps menu.
# No password: Ollie OS's admin rights need none. What it adds comes with it,
# in share/ollie-apps/airootfs, as in Ollie OS's own system image.
#
#   ollie-windows-updater
set -uo pipefail

readonly TITLE="Windows Boot Updater"
bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
say() { printf '\n%s==>%s %s%s%s\n' "$teal$bold" "$reset" "$bold" "$*" "$reset"; }
die() {
    printf '\n%sError:%s %s\n\nPress Enter to close.' "$red$bold" "$reset" "$*" >&2
    read -r _ || true
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
here="$(cd "$(dirname "$0")" && pwd)"
files="${OLLIE_APPS_SHARE:-$here/../share/ollie-apps}/airootfs"

# --- A terminal to talk in -----------------------------------------------------------
if [[ ! -t 0 && -z "${OLLIE_WINDOWS_IN_TERMINAL:-}" ]]; then
    export OLLIE_WINDOWS_IN_TERMINAL=1
    self="${APPIMAGE:-$(realpath -- "$0")}"
    for term in konsole gnome-terminal kgx xfce4-terminal xterm; do
        have "$term" || continue
        case "$term" in
        konsole) exec konsole --hold -e "$self" "$@" ;;
        gnome-terminal | kgx) exec "$term" -- "$self" "$@" ;;
        *) exec "$term" -hold -e "$self" "$@" ;;
        esac
    done
    have kdialog && kdialog --title "$TITLE" --error "No terminal program found. Run this from a terminal instead."
    exit 1
fi

printf '\n%s  %s%s  (puts Windows on Ollie OS'"'"'s start-up menu)\n' "$bold" "$TITLE" "$reset"
[[ -x /usr/local/bin/ollie-first-setup ]] || die "this is not Ollie OS. Run $TITLE on Ollie OS, on the computer that has Windows."
sudo -n true 2>/dev/null ||
    die "this Ollie OS asks for a password for admin tasks, and $TITLE never asks for one. Bring Ollie OS up to date with the Ollie OS Updater, then try again."
[[ -d $files ]] || die "this copy of $TITLE has nothing inside to add."

say "Adding Restart into Windows to Ollie OS"
# (Inside this app only you can read: root installs from a copy outside it.)
tmp="$(mktemp -d)"
trap 'rm -rf "${tmp:?}"' EXIT
cp -a "$files/." "$tmp/" || die "could not unpack $TITLE (is the disk full?)."
while IFS= read -r -d '' path; do
    rel="${path#"$tmp/"}" mode=0644
    [[ -x $path ]] && mode=0755
    sudo -n install -D -m "$mode" "$path" "/$rel" || die "could not add /$rel to Ollie OS."
done < <(find "$tmp" -type f -print0)
have kbuildsycoca6 && kbuildsycoca6 >/dev/null 2>&1

say "Putting Windows on Ollie OS's start-up menu"
sudo -n /usr/local/bin/ollie-windows-boot || die "Windows could not be put on the start-up menu (see above)."

printf '\n%s  Done.%s When the computer starts from the Ollie OS drive, pick\n' "$green$bold" "$reset"
cat <<'EOF2'
  "Windows Boot Manager" in its menu (4 seconds; the arrow keys stop it).
  From Ollie OS: apps menu > System > Restart into Windows.

  If Windows asks for a BitLocker recovery key when started this way, start it
  the computer's own way instead (Dell: tap F12, pick Windows Boot Manager).

Press Enter to close.
EOF2
read -r _ || true
