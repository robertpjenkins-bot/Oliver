#!/bin/bash
# Ollie OS Updater: pick an Ollie OS ISO you already have, and it is brought
# up to the newest Ollie OS, with the fixes that make an installed Ollie OS
# start on any computer (Dells too). Everything happens on this computer: the
# newest Ollie OS files are inside this app, so nothing big is downloaded.
#
# The result is a new ISO next to the old one (the old one is kept), with the
# same ID, so its boot menus and USB Maker work as before. USB Maker picks the
# newest ISO in the folder by itself.
#
# No administrator password is needed: the system image is rebuilt from a
# stream of the old one, keeping every file's owner and permissions. It needs
# about 4 GB of free space for a while.
#
#   ollie-update [ISO]
set -uo pipefail

readonly MIB=$((1024 * 1024)) GIB=$((1024 * 1024 * 1024))
bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
say() { printf '\n%s==>%s %s%s%s\n' "$teal$bold" "$reset" "$bold" "$*" "$reset"; }
die() {
    printf '\n%sError:%s %s\n\nPress Enter to close.' "$red$bold" "$reset" "$*" >&2
    read -r _ || true
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

here="$(dirname "$(readlink -f "$0")")"
# The newest Ollie OS files, and the tools to open and repack an ISO, inside the app.
files="${OLLIE_UPDATE_FILES:-$here/../share/ollie-update/airootfs}"
tools="${OLLIE_UPDATE_TOOLS:-$here/../lib/ollie-update/bin}"
for t in xorriso unsquashfs mksquashfs; do
    if [[ -x "$tools/$t" ]]; then
        printf -v "T_$t" '%s' "$tools/$t"
    elif have "$t"; then
        printf -v "T_$t" '%s' "$(command -v "$t")"
    else
        printf -v "T_$t" '%s' ""
    fi
done

# --- A terminal to talk in -------------------------------------------------------
if [[ ! -t 0 && -z "${OLLIE_UPDATE_IN_TERMINAL:-}" ]]; then
    export OLLIE_UPDATE_IN_TERMINAL=1
    self="${APPIMAGE:-$(realpath -- "$0")}"
    for term in konsole gnome-terminal kgx xfce4-terminal xterm; do
        have "$term" || continue
        case "$term" in
        konsole) exec konsole --hold -e "$self" "$@" ;;
        gnome-terminal | kgx) exec "$term" -- "$self" "$@" ;;
        *) exec "$term" -hold -e "$self" "$@" ;;
        esac
    done
    exit 1
fi

printf '\n%s  Ollie OS Updater%s  (makes your Ollie OS ISO the newest one, Dell-ready)\n' "$bold" "$reset"
[[ -d "$files" ]] || die "this copy of the Updater has no Ollie OS files inside."
[[ -n "$T_xorriso" && -n "$T_unsquashfs" && -n "$T_mksquashfs" ]] || die "this copy of the Updater is missing its ISO tools."

# --- 1. Which ISO --------------------------------------------------------------------
iso="${1:-}"
if [[ -z "$iso" ]]; then
    mapfile -t isos < <(find "$HOME/Downloads" "$HOME/Desktop" "$HOME" "$(dirname "${APPIMAGE:-$0}")" \
        -maxdepth 3 -type f -iname 'ollie-os*.iso' -size +500M -printf '%T@ %p\n' 2>/dev/null |
        sort -rn | cut -d' ' -f2- | awk '!seen[$0]++')
    if ((${#isos[@]} == 0)); then
        die "no Ollie OS ISO found in Downloads, on the Desktop or in your home folder. Download it first (Ollie OS Get ISO does that), then run this again."
    elif ((${#isos[@]} == 1)); then
        iso="${isos[0]}"
    else
        say "Which Ollie OS ISO? (newest first)"
        echo
        for i in "${!isos[@]}"; do
            printf '  %d) %s  (%s MB, %s)\n' $((i + 1)) "${isos[i]}" "$(($(stat -c %s "${isos[i]}") / MIB))" \
                "$(date -r "${isos[i]}" '+%d %b %H:%M')"
        done
        echo
        read -rp "Which one? [1-${#isos[@]}] " pick || die "no answer."
        [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#isos[@]})) || die "no such ISO."
        iso="${isos[pick - 1]}"
    fi
fi
[[ -f "$iso" ]] || die "no ISO file at $iso."
iso="$(realpath -- "$iso")"
say "ISO: $iso"

# --- 2. What is new ------------------------------------------------------------------------
work="$(mktemp -d "${TMPDIR:-/tmp}/ollie-update.XXXXXX")"
trap 'rm -rf "$work" 2>/dev/null' EXIT
# The system image out of the ISO, checked against the checksum the ISO
# carries: a damaged or half-downloaded ISO is caught here, not later.
read_image() {
    "$T_xorriso" -osirrox on -indev "$iso" -extract /arch/x86_64/airootfs.sfs "$work/old.sfs" \
        -extract /arch/x86_64/airootfs.sha512 "$work/old.sha512" >/dev/null 2>&1 ||
        die "this is not an Ollie OS ISO, or it is incomplete. Download it again (Ollie OS Get ISO does that)."
    if [[ -s "$work/old.sha512" ]]; then
        echo "  Checking the ISO is undamaged..."
        [[ "$(sha512sum "$work/old.sfs" | awk '{print $1}')" == "$(awk '{print $1; exit}' "$work/old.sha512")" ]] ||
            die "this ISO is damaged or incomplete (its system image does not match its checksum), so it cannot be updated. Download it again (Ollie OS Get ISO does that), then run this again."
    fi
    # Every path in the old image, for quick lookups.
    "$T_unsquashfs" -d '' -ls "$work/old.sfs" 2>/dev/null | sed -n 's|^/||p' >"$work/old.list"
}
read_image
changed=()
while IFS= read -r -d '' f; do
    rel="${f#"$files"/}"
    if [[ -L "$f" ]]; then
        # A link the ISO does not have yet.
        "$T_unsquashfs" -lls "$work/old.sfs" "$rel" 2>/dev/null | grep -q -- "-> $(readlink "$f")\$" || changed+=("$rel")
    elif ! cmp -s "$f" <("$T_unsquashfs" -cat "$work/old.sfs" "$rel" 2>/dev/null); then
        changed+=("$rel")
    fi
done < <(find "$files" \( -type f -o -type l \) -print0 | sort -z)
if ((${#changed[@]} == 0)); then
    printf '\n  %sThis ISO is already the newest Ollie OS.%s It installs Ollie OS that starts on any computer, Dells too.\n\n' "$green$bold" "$reset"
    exit 0
fi
echo
echo "  Newer in this Updater (${#changed[@]} file(s)), including:"
printf '%s\n' "${changed[@]}" | grep -qx usr/local/bin/ollie-install &&
    echo "    - the installer: an installed Ollie OS starts on any computer, Dells and Macs too"
printf '%s\n' "${changed[@]}" | grep -qx usr/local/bin/ollie-install-gui &&
    echo "    - Install Ollie OS as a window, like Batocera's \"Install on a new disk\""
printf '%s\n' "${changed[@]}" | sed -n 's|^usr/local/bin/|    - |p' | grep -vx -e '    - ollie-install' -e '    - ollie-install-gui' -e '    - ollie-selftest-.*' | head -n 8
echo
# OLLIE_UPDATE_YES=1: started by Get ISO / Installer, which carry on afterwards.
auto="${OLLIE_UPDATE_YES:-}"
if [[ -z "$auto" ]]; then
    read -rp "Make an updated ISO next to this one? (the old one is kept) [Y/n] " a || a=n
    [[ "$a" != [nN]* ]] || { echo "Nothing changed."; exit 0; }
fi

# --- 3. Room ------------------------------------------------------------------------------
# The old and new system images and the new ISO: about 6 GB, for a while.
need=$((4 * GIB))
best="" best_free=0
for d in "${TMPDIR:-/tmp}" /var/tmp "$HOME" "$(dirname "$iso")"; do
    [[ -d "$d" && -w "$d" ]] || continue
    f="$(df --output=avail -B1 "$d" 2>/dev/null | tail -n1 | tr -d ' ')"
    ((f > best_free)) && { best="$d"; best_free="$f"; }
done
((best_free > need)) || die "not enough free space: updating needs about 4 GB for a while, the most free anywhere here is $((best_free / GIB)) GB. Free some space and try again."
if [[ "$best" != "$(dirname "$work")" ]]; then
    rm -rf "$work"
    work="$(mktemp -d "$best/ollie-update.XXXXXX")"
    read_image
fi
out_free="$(df --output=avail -B1 "$(dirname "$iso")" | tail -n1 | tr -d ' ')"
iso_bytes="$(stat -c %s "$iso")"
((out_free > iso_bytes + 256 * MIB)) || die "not enough room next to the ISO for the updated one (it needs about $(((iso_bytes + 256 * MIB) / GIB + 1)) GB)."
cp -a "$files" "$work/files" || die "could not copy the new Ollie OS files (is the disk full?)."
files="$work/files"

# --- 4. Rebuild, without the administrator password ----------------------------------------
# The old image is streamed straight into the new one as squashfs "pseudo
# file" definitions, with every owner, permission and time kept, and nothing
# unpacked; the newer files take the place of the old ones. The stream
# cannot carry extended attributes, so the few programs that have them
# (file capabilities) get them back from this list, and the result is
# checked against the old image.
readonly CAPS=(
    "usr/bin/kwin_wayland security.capability=0x0100000200008000000000000000000000000000"
    "usr/bin/newuidmap security.capability=0x0100000280000000000000000000000000000000"
    "usr/bin/newgidmap security.capability=0x0100000240000000000000000000000000000000"
    "usr/lib/gstreamer-1.0/gst-ptp-helper security.capability=0x0100000200140000000000000000000000000000"
    "usr/lib/ksysguard/ksgrd_network_helper security.capability=0x0100000200200000000000000000000000000000"
    "usr/lib/ksystemstats_intel_helper security.capability=0x0100000200000000000000004000000000000000"
)
in_old() { grep -qxF -- "$1" "$work/old.list"; }
now="$(date +%s)"
pf="$work/new-files.pf"
: >"$pf"
excludes=()
declare -A made_dirs=()
for rel in "${changed[@]}"; do
    # Folders the old image does not have yet.
    d="$(dirname "$rel")" missing=()
    while [[ "$d" != . && -z "${made_dirs[$d]:-}" ]] && ! in_old "$d"; do
        missing=("$d" "${missing[@]}")
        d="$(dirname "$d")"
    done
    for d in "${missing[@]}"; do
        printf '"%s" D %s 0755 0 0\n' "$d" "$now" >>"$pf"
        made_dirs[$d]=1
    done
    in_old "$rel" && excludes+=("$rel")
    if [[ -L "$files/$rel" ]]; then
        printf '"%s" S %s 0777 0 0 %s\n' "$rel" "$now" "$(readlink "$files/$rel")" >>"$pf"
    else
        mode=0644
        [[ "$rel" == usr/local/bin/* ]] && mode=0755
        printf '"%s" F %s %s 0 0 cat "%s"\n' "$rel" "$now" "$mode" "$files/$rel" >>"$pf"
    fi
done
for c in "${CAPS[@]}"; do
    in_old "${c%% *}" && printf '"%s" x %s\n' "${c%% *}" "${c#* }" >>"$pf"
done

# What went wrong, kept for whoever helps (the work folder is removed on exit).
keep_logs() {
    {
        echo "Ollie OS Updater problem, $(date)"
        echo "ISO: $iso"
        echo "Work folder: $work ($(df -h --output=avail "$work" | tail -n1) free)"
        echo "== reading the old image"; tail -n 20 "$work/read.log"
        echo "== writing the new image"; tail -n 40 "$work/write.log"
        echo "== new files"; cat "$pf"
    } >"$HOME/Ollie-OS-Updater-problem.txt" 2>/dev/null
}

say "Rebuilding the system image (10 to 30 minutes, depending on the computer)"
echo "  No password needed. The newer files:"
printf '    %s\n' "${changed[@]}"
if ! "$T_unsquashfs" -no-xattrs -excludes -pf - "$work/old.sfs" "${excludes[@]}" 2>"$work/read.log" |
    "$T_mksquashfs" - "$work/airootfs.sfs" -pf - -pf "$pf" -noappend -comp xz -Xbcj x86 -b 1M -Xdict-size 1M \
        -no-progress >"$work/write.log" 2>&1; then
    keep_logs
    die "could not rebuild the system image (is the disk full?). Details: $HOME/Ollie-OS-Updater-problem.txt"
fi
if grep -q 'Failed to read\|creating empty file' "$work/write.log"; then
    keep_logs
    echo >&2
    grep 'Failed to read' "$work/write.log" | head -n 5 >&2
    die "could not read part of the files while rebuilding; nothing was changed. Details: $HOME/Ollie-OS-Updater-problem.txt"
fi
# Same special program permissions as before, or the new image is not used.
xold="$("$T_unsquashfs" -s "$work/old.sfs" 2>/dev/null | awk '/Number of xattr ids/ {print $NF}')"
xnew="$("$T_unsquashfs" -s "$work/airootfs.sfs" 2>/dev/null | awk '/Number of xattr ids/ {print $NF}')"
[[ "${xold:-0}" == "${xnew:-0}" ]] ||
    die "this ISO has special program permissions this Updater does not know ($xnew of $xold kept); nothing was changed. A newer Updater is needed for it."
rm -f "$work/old.sfs"
(cd "$work" && sha512sum airootfs.sfs >airootfs.sha512)

say "Writing the updated ISO"
uuid="$(blkid -o value -s UUID "$iso" 2>/dev/null)"
label="$(blkid -o value -s LABEL "$iso" 2>/dev/null)"
[[ -n "$uuid" && -n "$label" ]] || die "could not read the ISO's ID (blkid is missing?)."
base="$(basename -- "$iso" .iso)"
base="${base%-updated}"
out="$(dirname "$iso")/$base-updated.iso"
rm -f -- "$out.writing"
"$T_xorriso" -indev "$iso" -outdev "$out.writing" -boot_image any replay \
    -volid "$label" -volume_date uuid "${uuid//-/}" \
    -update "$work/airootfs.sfs" /arch/x86_64/airootfs.sfs \
    -update "$work/airootfs.sha512" /arch/x86_64/airootfs.sha512 >/dev/null 2>&1 ||
    { rm -f -- "$out.writing"; die "could not write the updated ISO."; }
[[ "$(blkid -o value -s UUID "$out.writing")" == "$uuid" ]] ||
    { rm -f -- "$out.writing"; die "the updated ISO came out wrong; nothing was changed."; }
mv -f -- "$out.writing" "$out"
sha256sum "$out" | sed 's|  .*/|  |' >"$out.sha256"

printf '\n  %sDone:%s %s\n' "$green$bold" "$reset" "$out"
echo "  It is the newest Ollie OS: an installed Ollie OS starts on any computer, Dells too."
echo "  Your old ISO is still there: $iso"

# --- 5. Straight on to USB Maker -----------------------------------------------------------
[[ -n "$auto" ]] && exit 0
maker="$(find "$(dirname "$iso")" "$HOME/Downloads" -maxdepth 2 -type f -iname 'Ollie-OS-USB-Maker*.AppImage' ! -iname '*Zip*' 2>/dev/null | head -n1)"
if [[ -n "${OLLIE_USB_MAKER:-}" && -x "$OLLIE_USB_MAKER" ]]; then maker="$OLLIE_USB_MAKER"; fi
if [[ -n "$maker" ]]; then
    echo
    read -rp "Put it on a drive now with USB Maker? [Y/n] " a || a=n
    if [[ "$a" != [nN]* ]]; then
        chmod +x -- "$maker" 2>/dev/null || true
        export OLLIE_USB_IN_TERMINAL=1
        exec "$maker" "$out"
    fi
fi
echo
