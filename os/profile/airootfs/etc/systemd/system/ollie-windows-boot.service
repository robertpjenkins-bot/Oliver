# Switched on when Ollie OS was installed with "Add Windows to the start-up
# menu" (the Drive Writer): at each start, until it has, it looks for
# Windows on the computer and puts it on the start-up menu
# (ollie-windows-boot), so that works on whichever computer has Windows.
[Unit]
Description=Put Windows on Ollie OS's start-up menu, when this computer has it
ConditionPathExists=!/boot/EFI/Microsoft/Boot/bootmgfw.efi
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=-/usr/local/bin/ollie-windows-boot

[Install]
WantedBy=multi-user.target
