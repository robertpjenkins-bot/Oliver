#!/bin/bash
# Ollie OS's settings for grown-ups: Screen Time, the Inappropriate Typing
# Scanner, Firefox's password and the parent PIN, in /etc/ollie/parent.conf. Changing them needs
# admin rights (Ollie OS Settings runs it with sudo; it asks for the PIN
# itself); reading them does not.
#   ollie-parent get                     the settings
#   ollie-parent left                    minutes of screen time left today ("off": no limit)
#   ollie-parent screen-time MINUTES     the daily limit (0: none)
#   ollie-parent extra MINUTES           more time for today only
#   ollie-parent scanner on|off
#   ollie-parent asked                   someone was asked about the scanner
#   ollie-parent pin                     a new PIN, from the input (empty: none)
#   ollie-parent firefox-password        Firefox's password, from the input (empty: none)
#   ollie-parent firefox-asked           someone was asked about Firefox's password
#   ollie-parent bedtime school|weekend HH:MM|off   bedtime on school nights
#                                        (Sunday to Thursday) or weekends
#   ollie-parent wake HH:MM              when bedtime ends in the morning (07:00)
#   ollie-parent bedtime-left            minutes until bedtime tonight, "bed" when
#                                        it is bedtime, or "off"
#   ollie-parent later MINUTES           a later bedtime, tonight only
set -uo pipefail
readonly CONF=/etc/ollie/parent.conf STATE=/var/lib/ollie/screen-time
setting() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n 1; }
put() { # put KEY VALUE
    mkdir -p /etc/ollie
    [[ -f $CONF ]] || printf 'SCREEN_TIME=0\nSCANNER=off\nASKED=no\nPIN_MD5=\n' >"$CONF"
    if grep -q "^$1=" "$CONF"; then
        sed -i "s|^$1=.*|$1=$2|" "$CONF"
    else
        echo "$1=$2" >>"$CONF"
    fi
    chmod 0644 "$CONF"
}
number() { [[ ${1:-} =~ ^[0-9]{1,4}$ ]] || { echo "not a number of minutes: ${1:-}" >&2; exit 2; }; }
today() { cat "$STATE/$1-$(date +%F)" 2>/dev/null || echo 0; }

case "${1:-}" in
get) cat "$CONF" 2>/dev/null ;;
left)
    limit="$(setting SCREEN_TIME)"
    if [[ ! $limit =~ ^[0-9]+$ ]] || ((limit == 0)); then
        echo off
    else
        left=$((limit + $(today extra) - $(today used)))
        echo $((left > 0 ? left : 0))
    fi
    ;;
screen-time) number "${2:-}" && put SCREEN_TIME "$2" ;;
extra)
    number "${2:-}"
    mkdir -p "$STATE"
    echo $(($(today extra) + $2)) >"$STATE/extra-$(date +%F)"
    ;;
scanner)
    case "${2:-}" in on | off) ;; *) echo "on or off" >&2; exit 2 ;; esac
    put SCANNER "$2"
    put ASKED yes
    systemctl restart ollie-typing-scanner.service 2>/dev/null
    ;;
asked) put ASKED yes ;;
pin)
    IFS= read -r pin || pin=""
    if [[ -z $pin ]]; then
        put PIN_MD5 ""
    else
        put PIN_MD5 "$(printf 'ollie-os:%s' "$pin" | md5sum | cut -d' ' -f1)"
    fi
    ;;
firefox-password)
    IFS= read -r pw || pw=""
    if [[ -z $pw ]]; then
        put FIREFOX_SHA256 ""
    else
        put FIREFOX_SHA256 "$(printf 'ollie-firefox:%s' "$pw" | sha256sum | cut -d' ' -f1)"
    fi
    put FIREFOX_ASKED yes
    ;;
firefox-asked) put FIREFOX_ASKED yes ;;
bedtime)
    [[ ${2:-} =~ ^(school|weekend)$ && ${3:-} =~ ^(off|([01][0-9]|2[0-3]):[0-5][0-9])$ ]] || { echo "school|weekend HH:MM|off" >&2; exit 2; }
    key=BEDTIME_SCHOOL
    [[ $2 == weekend ]] && key=BEDTIME_WEEKEND
    put "$key" "${3/off/}"
    ;;
wake) [[ ${2:-} =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || exit 2; put WAKE "$2" ;;
later)
    number "${2:-}"
    mkdir -p "$STATE"
    # (Tonight: the evening's date, also after midnight.)
    night="$(date +%F)"
    (($(date +%-H) < 12)) && night="$(date -d yesterday +%F)"
    echo $(($(cat "$STATE/later-$night" 2>/dev/null || echo 0) + $2)) >"$STATE/later-$night"
    ;;
bedtime-left)
    # A night's bedtime: school nights are Sunday to Thursday evenings.
    bedtime_of() { # bedtime_of DATE: HH:MM or nothing
        case "$(date -d "$1" +%u)" in 5 | 6) setting BEDTIME_WEEKEND ;; *) setting BEDTIME_SCHOOL ;; esac
    }
    mins() { echo $((10#${1%%:*} * 60 + 10#${1##*:})); }
    wake="$(setting WAKE)"
    wake=$(mins "${wake:-07:00}")
    now=$(mins "$(date +%H:%M)")
    if ((now < wake)); then
        # Early morning: still last night.
        night="$(date -d yesterday +%F)"
        [[ -n "$(bedtime_of "$night")" ]] && echo bed || echo off
        exit 0
    fi
    night="$(date +%F)"
    bed="$(bedtime_of "$night")"
    [[ -n $bed ]] || { echo off; exit 0; }
    left=$(($(mins "$bed") + $(cat "$STATE/later-$night" 2>/dev/null || echo 0) - now))
    if ((left <= 0)); then echo bed; else echo "$left"; fi
    ;;
*) sed -n '2,23s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
