#!/bin/bash
# Sticker Maker: stickers from pictures, drawings or emoji (sticker.qml),
# saved in Pictures/Stickers, and put on the desktop: drawn into the
# desktop's background (~/.local/share/ollie/stickers); the background
# without them is kept, to take them all off again.
set -uo pipefail
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
pics="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Stickers"
data="$HOME/.local/share/ollie/stickers"
mkdir -p "$pics" "$data" "$HOME/.config/ollie"
# The desktop's background now (a picture, or a wallpaper package's biggest picture).
wall="$(sed -n 's/^Image=//p' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null | head -n 1)"
wall="${wall#file://}"
if [[ -d $wall ]]; then
    wall="$(ls -S "$wall"/contents/images/*.{png,jpg} 2>/dev/null | head -n 1)"
fi
[[ -f $wall ]] || wall="$(ls -S /usr/share/wallpapers/OllieOS/contents/images/*.png 2>/dev/null | head -n 1)"
while IFS= read -r line; do
    case "$line" in
    *"OLLIE-ACTION trophy "*) # a trophy event (ollie-trophy count|max|add ...)
        read -r -a t <<<"${line#*OLLIE-ACTION trophy }"
        (/usr/local/bin/ollie-trophy "${t[@]}" >/dev/null 2>&1 &)
        ;;
    *"OLLIE-ACTION wallpaper "*) plasma-apply-wallpaperimage "${line#*OLLIE-ACTION wallpaper }" >/dev/null 2>&1 ;;
    *"OLLIE-ACTION restore "*) plasma-apply-wallpaperimage "${line#*OLLIE-ACTION restore }" >/dev/null 2>&1 ;;
    esac
done < <(qml6 /usr/local/share/ollie/sticker.qml -- "wall=$wall" "out=$pics" "data=$data" "config=$HOME/.config/ollie/stickers.ini" 2>&1)
