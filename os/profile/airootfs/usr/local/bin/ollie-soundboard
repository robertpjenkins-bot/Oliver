#!/bin/bash
# Sound Board: big buttons that play sounds (soundboard.qml): six fun ones,
# made here once with ffmpeg, and your own, recorded with the microphone
# (pw-record) into ~/.local/share/ollie/soundboard.
set -uo pipefail
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
dir="$HOME/.local/share/ollie/soundboard"
sounds="$dir/fun" mine="$dir/mine"
mkdir -p "$sounds" "$mine" "$HOME/.config/ollie"
make() { # make NAME SECONDS EXPRESSION (commas in it written \\,)
    [[ -s "$sounds/$1.ogg" ]] && return
    ffmpeg -loglevel error -y -f lavfi -i "aevalsrc=$3:s=44100:d=$2" \
        -af "afade=t=out:st=$(awk -v d="$2" 'BEGIN {print d - 0.05}'):d=0.05" -c:a libvorbis -q:a 4 "$sounds/$1.ogg"
}
make laser 0.45 '0.6*sin(2*PI*(1600*t-1500*t*t))'
make boing 0.8 '0.6*sin(2*PI*t*(220+160*exp(-4*t)*sin(2*PI*9*t)))*exp(-2.5*t)'
make drum 0.5 '(0.9*sin(2*PI*t*(140-120*t))+0.25*(random(0)-0.5))*exp(-9*t)'
make coin 0.45 '0.4*sin(2*PI*(if(lt(t\,0.08)\,988\,1319))*t)*exp(-4*t)'
make siren 1.6 '0.4*sin(2*PI*(800*t+150*sin(2*PI*1.5*t)/(2*PI*1.5)*2*PI))'
make silly 0.9 '0.5*sin(2*PI*t*(85+25*sin(2*PI*22*t)))*(1-exp(-30*t))*exp(-1.5*t)'
rec=""
play() { pw-play "$1" 2>/dev/null || paplay "$1" 2>/dev/null; }
while IFS= read -r line; do
    case "$line" in
    *"OLLIE-ACTION trophy "*) # a trophy event (ollie-trophy count|max|add ...)
        read -r -a t <<<"${line#*OLLIE-ACTION trophy }"
        (/usr/local/bin/ollie-trophy "${t[@]}" >/dev/null 2>&1 &)
        ;;
    *"OLLIE-ACTION play "*) (play "${line#*OLLIE-ACTION play }" &) ;;
    *"OLLIE-ACTION record "*)
        [[ -n $rec ]] && kill "$rec" 2>/dev/null
        pw-record --channels 1 "${line#*OLLIE-ACTION record }" 2>/dev/null &
        rec=$!
        ;;
    *"OLLIE-ACTION stop"*) [[ -n $rec ]] && kill -INT "$rec" 2>/dev/null; rec="" ;;
    esac
done < <(qml6 /usr/local/share/ollie/soundboard.qml -- "config=$HOME/.config/ollie/soundboard.ini" "sounds=$sounds" "mine=$mine" 2>&1)
[[ -n $rec ]] && kill -INT "$rec" 2>/dev/null
exit 0
