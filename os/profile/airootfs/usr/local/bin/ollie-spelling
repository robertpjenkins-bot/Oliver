#!/bin/bash
# Spelling Bee (spelling.qml). What it keeps is in ~/.config/ollie/spelling.ini;
# Ollie's voice (ollie-say) cheers and reads out loud.
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
export QML_XHR_ALLOW_FILE_READ=1
mkdir -p "$HOME/.config/ollie"
while IFS= read -r line; do
    case "$line" in
    *"OLLIE-ACTION say "*) (/usr/local/bin/ollie-say "${line#*OLLIE-ACTION say }" &) ;;
    # The words themselves: spoken even with Ollie's voice switched off, slowly.
    *"OLLIE-ACTION speak "*) (pkill -u "$UID" -f '^espeak-ng -v en-us -s 120' 2>/dev/null; espeak-ng -v en-us -s 120 -- "${line#*OLLIE-ACTION speak }" >/dev/null 2>&1 &) ;;
    esac
done < <(qml6 /usr/local/share/ollie/spelling.qml -- "config=$HOME/.config/ollie/spelling.ini" 2>&1)
