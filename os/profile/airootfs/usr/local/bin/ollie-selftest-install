#!/bin/bash
# Self-test of the installer, run at start-up only when the kernel command
# line has ollie.selftest=install (the build's tests do that, in a virtual
# machine with an empty 30 GB disk). It installs Ollie OS onto that disk the
# way a person would, answering the installer's questions, prints what the
# installed system will start with, then switches the machine off. The test
# then starts the installed system from the disk.
set -uo pipefail
say() { echo "OLLIE-INSTALL-TEST: $*" | tee /dev/console /dev/ttyS0 2>/dev/null; }

# The only drive, the way the Install Ollie OS window runs it (no questions,
# progress lines).
disk="/dev/$(lsblk -dnro NAME,TYPE | awk '$2 == "disk" && $1 !~ /^(loop|sr|zram)/ {print $1; exit}')"
if OLLIE_INSTALL_DISK="$disk" OLLIE_INSTALL_YES=1 OLLIE_INSTALL_PROGRESS=1 /usr/local/bin/ollie-install </dev/null >/tmp/install.log 2>&1; then
    say "installer finished"
else
    say "installer FAILED:"
fi
tail -n 30 /tmp/install.log | while IFS= read -r l; do say "  $l"; done

root="$(blkid -L OLLIE)"
if [[ -n "$root" ]]; then
    mkdir -p /mnt/check
    mount -o subvol=@ "$root" /mnt/check && mount "$(blkid -L OLLIE_BOOT)" /mnt/check/boot
    say "boot files: $(ls /mnt/check/boot | tr '\n' ' ')"
    say "loader entry: $(grep options /mnt/check/boot/loader/entries/ollie.conf)"
    say "hooks: $(grep -h '^HOOKS' /mnt/check/etc/mkinitcpio.conf /mnt/check/etc/mkinitcpio.conf.d/*.conf 2>/dev/null | tr '\n' ' ')"
    say "kernel: $(file -b /mnt/check/boot/vmlinuz-linux | grep -o 'version [^ ]*')"
    say "modules: $(ls /mnt/check/usr/lib/modules | tr '\n' ' ')"
    say "btrfs in initramfs: $(lsinitcpio /mnt/check/boot/initramfs-linux.img 2>/dev/null | grep -c btrfs)"
    say "progress lines: $(grep -c '^PROGRESS' /tmp/install.log), last: $(grep '^PROGRESS' /tmp/install.log | tail -n 1)"
    say "older computers: $(ls /mnt/check/boot/syslinux 2>/dev/null | tr '\n' ' ')"
    say "first sector: $(dd if="$disk" bs=440 count=1 status=none | strings | head -n 1)"
    say "fstab: $(grep -v '^#' /mnt/check/etc/fstab | tr -s ' \t' ' ' | tr '\n' '|')"
    umount -R /mnt/check
fi
say DONE
sync
systemctl poweroff
