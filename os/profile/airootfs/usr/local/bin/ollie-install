#!/bin/bash
# Install Ollie OS from the live USB onto a drive, erasing it, the way
# Batocera's "Install on a new disk" does: a 512 MB start-up partition and
# Ollie OS (compressed btrfs) in all the rest. It starts on new computers
# (UEFI: Dells, Intel Macs, the Steam Machine) and on older ones set to
# BIOS / Legacy.
#
# Run from the "Install Ollie OS" icon (ollie-install-gui, a window), or in a
# terminal: sudo ollie-install. The window passes its answers in:
#   OLLIE_INSTALL_DISK=/dev/...  OLLIE_INSTALL_YES=1  (no questions)
#   OLLIE_INSTALL_HOSTNAME, OLLIE_INSTALL_TIMEZONE
#   OLLIE_INSTALL_PROGRESS=1     (prints "PROGRESS percent text" lines)
#   OLLIE_INSTALL_WINDOWS=1      (Windows on the start-up menu: at each start,
#                                until it has, the installed Ollie OS looks for
#                                Windows on the computer: ollie-windows-boot)
#   OLLIE_INSTALL_WINDOWS_VERSION=10|11  (install Windows next to Ollie OS:
#                                OLLIE_INSTALL_WINDOWS_GB of the drive is kept
#                                for it, a Windows Setup part (OLLIE_WINSETUP,
#                                10 GB at the end) gets Windows Setup from
#                                OLLIE_INSTALL_WINDOWS_ISO or from Microsoft
#                                (ollie-windows-setup), and the next start runs
#                                it. If getting it fails, Ollie OS is still
#                                installed: "Install Windows" in its apps menu
#                                tries again. Prints "WINDOWS-LATER why" then.)
#   OLLIE_INSTALL_NO_EFI_VARS=1  (leaves this computer's start-up list alone:
#                                 the Drive Writer, installing from SteamOS)
#   OLLIE_INSTALL_FILL=COMMAND   (puts Ollie OS's system on the drive by running
#                                 COMMAND TARGET, instead of copying the live
#                                 USB's: the Drive Writer, which installs it
#                                 from Arch Linux's packages; see os/build-drive.sh)
set -euo pipefail

readonly BOOT_SIZE=512M
readonly NEED_BYTES=$((25 * 1024 * 1024 * 1024 + 64 * 1024 * 1024))
readonly SOURCE=/run/archiso/airootfs
readonly BOOTMNT=/run/archiso/bootmnt
readonly TARGET=/mnt/ollie
readonly SETUP_GB=10 # the Windows Setup part, when Windows is installed too

bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' reset=$'\e[0m'
say() { printf '%s==>%s %s\n' "$teal$bold" "$reset" "$*"; }
# With Windows too, Ollie OS's part of the work is the first half of the bar.
progress() {
    [[ -n "${OLLIE_INSTALL_PROGRESS:-}" ]] || return 0
    if [[ -n $winver ]]; then echo "PROGRESS $(($1 / 2)) $2"; else echo "PROGRESS $1 $2"; fi
}
winver="${OLLIE_INSTALL_WINDOWS_VERSION:-}"
die() {
    printf '%sError:%s %s\n' "$red$bold" "$reset" "$*" >&2
    exit 1
}

cleanup() {
    if mountpoint -q "$TARGET"; then
        umount -R "$TARGET" 2>/dev/null || true
    fi
}
trap cleanup EXIT

[[ $EUID -eq 0 ]] || exec sudo --preserve-env=OLLIE_INSTALL_DISK,OLLIE_INSTALL_YES,OLLIE_INSTALL_HOSTNAME,OLLIE_INSTALL_TIMEZONE,OLLIE_INSTALL_PROGRESS,OLLIE_INSTALL_NO_EFI_VARS,OLLIE_INSTALL_WINDOWS,OLLIE_INSTALL_WINDOWS_VERSION,OLLIE_INSTALL_WINDOWS_GB,OLLIE_INSTALL_WINDOWS_ISO "$0" "$@"
[[ -n "${OLLIE_INSTALL_FILL:-}" || -d "$SOURCE/usr" ]] || die "this only works when started from the Ollie OS live USB."

# The drive the live USB itself is on, so it is never offered as a target.
live_disk=""
# An ISO written to a USB stick is mounted from the whole disk (/dev/sdb), a
# partitioned one from a partition (/dev/sdb1); walk up to the disk either way.
# (/run/ollie-bootdev, from ollie-live-setup, also knows it when the live
# system was copied into memory and archiso let go of the drive.)
if src="$(findmnt -no SOURCE "$BOOTMNT" 2>/dev/null)" || src="$(cat /run/ollie-bootdev 2>/dev/null)"; then
    live_disk="$(lsblk -sno NAME,TYPE "$src" 2>/dev/null |
        awk '$2 == "disk" {gsub(/[^A-Za-z0-9]/, "", $1); print $1; exit}')"
fi

echo
printf '%s  Ollie OS installer%s\n\n' "$bold" "$reset"
disk="${OLLIE_INSTALL_DISK:-}"
if [[ -n "$disk" ]]; then
    [[ -b "$disk" && "$(lsblk -dno TYPE "$disk")" == disk ]] || die "$disk is not a drive."
    [[ "${disk#/dev/}" != "$live_disk" ]] || die "$disk is the drive Ollie OS is running from."
    (($(lsblk -bdno SIZE "$disk") >= NEED_BYTES)) || die "$disk is smaller than 25.1 GB."
else
say "Drives you can install onto (needs at least 25.1 GB):"
echo

declare -a disks=()
while read -r name type; do
    [[ "$type" == disk ]] || continue
    [[ "$name" == "$live_disk" ]] && continue
    case "$name" in loop* | zram* | sr* | ram*) continue ;; esac
    bytes="$(lsblk -bdno SIZE "/dev/$name")"
    ((bytes >= NEED_BYTES)) || continue
    disks+=("$name")
    printf '  %d) /dev/%-10s %8s  %-5s %s\n' "${#disks[@]}" "$name" \
        "$(lsblk -dno SIZE "/dev/$name")" "$(lsblk -dno TRAN "/dev/$name")" "$(lsblk -dno MODEL "/dev/$name")"
done < <(lsblk -dnro NAME,TYPE)

((${#disks[@]} > 0)) || die "no drive of at least 25.1 GB found (the live USB itself is not listed)."
echo
read -rp "Install onto which drive? [1-${#disks[@]}] " pick
[[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#disks[@]})) || die "no such drive."
disk="/dev/${disks[pick - 1]}"
fi

echo
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$disk"
echo
printf '%sEVERYTHING on %s will be erased.%s\n' "$red$bold" "$disk" "$reset"
if [[ -z "${OLLIE_INSTALL_YES:-}" ]]; then
    read -rp "Type ERASE to continue: " answer
    [[ "$answer" == ERASE ]] || die "cancelled, nothing was changed."
fi

# No username or password: the installed system logs in by itself as "ollie",
# whose account has no password, just like the live USB.
echo
hostname="${OLLIE_INSTALL_HOSTNAME:-}" timezone="${OLLIE_INSTALL_TIMEZONE:-}"
[[ -n "${OLLIE_INSTALL_YES:-}" ]] || read -rp "Computer name [ollie]: " hostname
hostname="${hostname:-ollie}"
[[ "$hostname" =~ ^[A-Za-z0-9-]{1,63}$ ]] || die "the computer name may only use letters, digits and -."
[[ -n "${OLLIE_INSTALL_YES:-}" ]] || read -rp "Time zone, e.g. America/New_York or Europe/London [UTC]: " timezone
windows="${OLLIE_INSTALL_WINDOWS:-}" wingb="${OLLIE_INSTALL_WINDOWS_GB:-}" winiso="${OLLIE_INSTALL_WINDOWS_ISO:-}"
disk_gb=$(($(lsblk -bdno SIZE "$disk") / 1000000000))
if [[ -z "${OLLIE_INSTALL_YES:-}" ]]; then
    read -rp "Install Windows on this drive too, next to Ollie OS? [y/N] " answer
    if [[ ${answer,,} == y* ]]; then
        read -rp "Windows 10 or 11? [11] " winver
        winver="${winver:-11}"
        wingb=$(((disk_gb - SETUP_GB) / 2))
        read -rp "How many GB for Windows? [$wingb] " answer
        wingb="${answer:-$wingb}"
        read -rp "A Windows .iso file you have (empty: download it from Microsoft): " winiso
    else
        read -rp "Should Windows be on the start-up menu too, if this computer has it? [y/N] " windows
        [[ ${windows,,} == y* ]] && windows=1 || windows=""
    fi
fi
if [[ -n $winver ]]; then
    [[ $winver == 10 || $winver == 11 ]] || die "Windows must be 10 or 11."
    [[ -d /sys/firmware/efi ]] || die "installing Windows needs the computer to start the new way (UEFI); it started the old way (BIOS / Legacy)."
    [[ $wingb =~ ^[0-9]+$ ]] && ((wingb >= (winver == 11 ? 64 : 32))) || die "Windows $winver needs at least $((winver == 11 ? 64 : 32)) GB."
    # (2 GB to spare: the start-up part, and GB / GiB.)
    root_gb=$((disk_gb - wingb - SETUP_GB - 2))
    ((root_gb >= 26)) || die "not enough room: Ollie OS needs 26 GB besides the $wingb GB for Windows and $SETUP_GB GB for Windows Setup."
    [[ -z $winiso || -e $winiso ]] || die "$winiso is not there."
    windows=1
fi
timezone="${timezone:-UTC}"
[[ -f "/usr/share/zoneinfo/$timezone" ]] || die "unknown time zone '$timezone'."

echo
say "Partitioning $disk"
progress 2 "Preparing the drive"
for part in $(lsblk -lnpo NAME "$disk" | tail -n +2); do
    umount "$part" 2>/dev/null || true
    swapoff "$part" 2>/dev/null || true
done
wipefs -af "$disk" >/dev/null
sgdisk --zap-all "$disk" >/dev/null
if [[ -n $winver ]]; then
    # Ollie OS, then the space for Windows (left empty: Windows Setup makes
    # its parts there), then Windows Setup at the end.
    sgdisk -n "1:0:+$BOOT_SIZE" -t 1:ef00 -c 1:OLLIE_BOOT \
        -n "2:0:+$((root_gb * 1000000000 / 1048576))M" -t 2:8304 -c 2:OLLIE_ROOT \
        -n "3:-${SETUP_GB}G:0" -t 3:0700 -c 3:OLLIE_WINSETUP "$disk" >/dev/null
else
    sgdisk -n "1:0:+$BOOT_SIZE" -t 1:ef00 -c 1:OLLIE_BOOT \
        -n "2:0:0" -t 2:8304 -c 2:OLLIE_ROOT "$disk" >/dev/null
fi
partprobe "$disk" 2>/dev/null || true
udevadm settle

# /dev/sda -> /dev/sda1, /dev/nvme0n1 and /dev/mmcblk0 -> ...p1
if [[ "$disk" =~ [0-9]$ ]]; then sep=p; else sep=; fi
boot_part="${disk}${sep}1"
root_part="${disk}${sep}2"

say "Formatting"
mkfs.fat -F 32 -n OLLIE_BOOT "$boot_part" >/dev/null
mkfs.btrfs -f -L OLLIE "$root_part" >/dev/null

mkdir -p "$TARGET"
mount "$root_part" "$TARGET"
btrfs subvolume create "$TARGET/@" >/dev/null
btrfs subvolume create "$TARGET/@home" >/dev/null
umount "$TARGET"

opts=noatime,compress=zstd:3
mount -o "$opts,subvol=@" "$root_part" "$TARGET"
mount --mkdir -o "$opts,subvol=@home" "$root_part" "$TARGET/home"
mount --mkdir "$boot_part" "$TARGET/boot"

if [[ -n "${OLLIE_INSTALL_FILL:-}" ]]; then
    say "Installing Ollie OS's programs"
    progress 5 "Installing Ollie OS's programs"
    "$OLLIE_INSTALL_FILL" "$TARGET" || die "installing Ollie OS's programs failed (see above)."
elif [[ -n "${OLLIE_INSTALL_PROGRESS:-}" ]]; then
    say "Copying Ollie OS (this takes a few minutes)"
    progress 5 "Copying Ollie OS"
    # rsync's overall percentage, as 5 to 75 of the whole install.
    rsync -aAXH --info=progress2 --no-inc-recursive --exclude=/boot/ "$SOURCE/" "$TARGET/" |
        stdbuf -o0 tr '\r' '\n' | awk -v half="${winver:+1}" '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%$/) {p = int(5 + $i * 70 / 100); if (half) p = int(p / 2); if (p != last) {print "PROGRESS " p " Copying Ollie OS"; fflush(); last = p}}}'
    ((PIPESTATUS[0] == 0)) || die "copying Ollie OS failed (is the drive faulty?)."
else
    say "Copying Ollie OS (this takes a few minutes)"
    rsync -aAXH --info=progress2 --exclude=/boot/ "$SOURCE/" "$TARGET/"
fi

# The image keeps its kernel on the USB's boot partition, not inside itself.
# The linux package keeps a copy next to its modules too, for when the
# drive is no longer mounted.
if [[ -f "$BOOTMNT/arch/boot/x86_64/vmlinuz-linux" ]]; then
    cp "$BOOTMNT/arch/boot/x86_64/vmlinuz-linux" "$TARGET/boot/vmlinuz-linux"
else
    cp "$(ls "$TARGET"/usr/lib/modules/*/vmlinuz | head -n1)" "$TARGET/boot/vmlinuz-linux"
fi

# The Fixer's good copy of the system (about 2 GB): the image Ollie OS was
# started from, so damaged programs can be put back without internet.
for sfs in "$BOOTMNT/arch/x86_64/airootfs.sfs" /run/ollie-bootdir/arch/x86_64/airootfs.sfs \
    /run/archiso/copytoram/airootfs.sfs; do
    if [[ -f "$sfs" ]]; then
        say "Keeping a copy of the original system for The Fixer"
        install -D -m 0644 "$sfs" "$TARGET/var/lib/ollie/fixer/airootfs.sfs"
        break
    fi
done

say "Setting up the installed system"
progress 80 "Setting up Ollie OS on the drive"
# Undo what makes the image a live USB.
rm -f "$TARGET/etc/mkinitcpio.conf.d/archiso.conf" \
    "$TARGET/etc/systemd/system/multi-user.target.wants/ollie-live-setup.service" \
    "$TARGET/usr/share/applications/ollie-install.desktop"
# One start-up image with every driver (no autodetect), so the drive starts
# on any computer it is plugged into, not only the one it was installed on.
cat >"$TARGET/etc/mkinitcpio.d/linux.preset" <<'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
default_options="-S autodetect"
EOF

# root has no password, so without this a start-up problem ends at "root
# account is locked" instead of a repair prompt. Also inside the initramfs.
for unit in emergency rescue; do
    install -D -m 0644 /dev/stdin "$TARGET/etc/systemd/system/$unit.service.d/ollie-shell.conf" <<'EOF'
[Service]
Environment=SYSTEMD_SULOGIN_FORCE=1
EOF
done
cat >"$TARGET/etc/mkinitcpio.conf.d/ollie.conf" <<'EOF'
FILES=(/etc/systemd/system/emergency.service.d/ollie-shell.conf /etc/systemd/system/rescue.service.d/ollie-shell.conf)
EOF

genfstab -U "$TARGET" >"$TARGET/etc/fstab"
echo "$hostname" >"$TARGET/etc/hostname"
ln -sf "/usr/share/zoneinfo/$timezone" "$TARGET/etc/localtime"
sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' "$TARGET/etc/locale.gen"
echo LANG=en_US.UTF-8 >"$TARGET/etc/locale.conf"

root_uuid="$(blkid -s UUID -o value "$root_part")"

arch-chroot "$TARGET" /bin/bash -euo pipefail -s "${OLLIE_INSTALL_NO_EFI_VARS:-}" <<'CHROOT'
locale-gen >/dev/null
useradd -m -G wheel,video,audio,input,storage -s /bin/bash -c "Ollie" ollie
passwd -d ollie >/dev/null
passwd -l root >/dev/null
mkinitcpio -P
if [[ -n "$1" ]]; then
    bootctl install --esp-path=/boot --no-variables
else
    bootctl install --esp-path=/boot 2>/dev/null || bootctl install --esp-path=/boot --no-variables
fi
CHROOT
if [[ -n $windows ]]; then
    mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
    ln -sfn /etc/systemd/system/ollie-windows-boot.service \
        "$TARGET/etc/systemd/system/multi-user.target.wants/ollie-windows-boot.service"
fi

cat >"$TARGET/boot/loader/loader.conf" <<'EOF'
default ollie.conf
timeout 2
editor no
EOF
cat >"$TARGET/boot/loader/entries/ollie.conf" <<EOF
title   Ollie OS
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=$root_uuid rootflags=subvol=@ rw quiet splash
EOF
# Without "quiet", to see what goes wrong if starting ever fails.
cat >"$TARGET/boot/loader/entries/ollie-fallback.conf" <<EOF
title   Ollie OS (show start-up messages)
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=$root_uuid rootflags=subvol=@ rw
EOF

# Older computers (BIOS / Legacy, older Dells): SYSLINUX on the start-up
# partition, its boot code in the drive's first sector, and the partition
# marked "legacy BIOS bootable". New computers use systemd-boot as before.
progress 95 "Making it start on older computers too"
if [[ -d /usr/lib/syslinux/bios ]] && have_extlinux=$(command -v extlinux); then
    install -d "$TARGET/boot/syslinux"
    cp /usr/lib/syslinux/bios/{ldlinux.c32,libcom32.c32,libutil.c32,menu.c32} "$TARGET/boot/syslinux/"
    cat >"$TARGET/boot/syslinux/syslinux.cfg" <<EOF
DEFAULT ollie
PROMPT 0
TIMEOUT 20
UI menu.c32
MENU TITLE Ollie OS
LABEL ollie
    MENU LABEL Ollie OS
    LINUX /vmlinuz-linux
    INITRD /initramfs-linux.img
    APPEND root=UUID=$root_uuid rootflags=subvol=@ rw quiet splash
LABEL messages
    MENU LABEL Ollie OS (show start-up messages)
    LINUX /vmlinuz-linux
    INITRD /initramfs-linux.img
    APPEND root=UUID=$root_uuid rootflags=subvol=@ rw
EOF
    if "$have_extlinux" --install "$TARGET/boot/syslinux" >/dev/null 2>&1; then
        dd if=/usr/lib/syslinux/bios/gptmbr.bin of="$disk" bs=440 count=1 conv=notrunc status=none
        sgdisk --attributes=1:set:2 "$disk" >/dev/null
    else
        echo "(Could not add the start-up code for older computers; new computers are not affected.)"
    fi
fi

# --- Windows, next to it ---------------------------------------------------------------
if [[ -n $winver ]]; then
    say "Getting Windows $winver Setup ready"
    # "Install Windows" in the apps menu, to try again if this does not work.
    install -m 0644 /usr/local/share/ollie/ollie-windows-install.desktop "$TARGET/usr/share/applications/"
    args=(--version "$winver" --part "${disk}${sep}3" --work "$TARGET/var/tmp" --root "$TARGET")
    [[ -n $winiso ]] && args+=(--iso "$winiso")
    [[ -n "${OLLIE_INSTALL_NO_EFI_VARS:-}" ]] && args+=(--no-efi-vars)
    winlog="$(mktemp)"
    if ! /usr/local/bin/ollie-windows-setup "${args[@]}" 2>"$winlog" | while read -r word pct text; do
        case "$word" in
        PROGRESS) if [[ -n "${OLLIE_INSTALL_PROGRESS:-}" ]]; then echo "PROGRESS $((50 + pct / 2)) $text"; else echo "    $text ($pct%)"; fi ;;
        *) echo "$word $pct $text" ;;
        esac
    done; then
        why="$(sed -n 's/^Error: //p' "$winlog" | tail -n 1)"
        echo "WINDOWS-LATER ${why:-getting Windows Setup ready did not work.}"
    fi
    rm -f "$winlog"
fi

sync
[[ -n "${OLLIE_INSTALL_PROGRESS:-}" ]] && echo "PROGRESS 100 Done"
say "Done. Ollie OS is installed on $disk."
echo "    Remove the live USB and restart. On its first start it asks you to create a username and password."
