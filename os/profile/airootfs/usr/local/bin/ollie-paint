#!/bin/bash
# Ollie Paint: draw with the mouse (paint.qml). Drawings are saved in
# Pictures/Drawings.
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
out="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Drawings"
mkdir -p "$out"
while IFS= read -r line; do
    case "$line" in
    *"OLLIE-ACTION saved "*)
        f="${line#*OLLIE-ACTION saved }"
        (notify-send -a "Ollie Paint" -i ollie-paint "Drawing saved" "${f##*/} is in Pictures, Drawings." >/dev/null 2>&1 &)
        (/usr/local/bin/ollie-trophy count drawing >/dev/null 2>&1 &)
        ;;
    esac
done < <(qml6 /usr/local/share/ollie/paint.qml -- "out=$out" 2>&1)
