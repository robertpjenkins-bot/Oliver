#!/bin/bash
# Ollie OS Settings: Steam's Game Mode, the FPS counter, Speed Boost, the
# start-up sound, colours, and (for grown-ups, behind the parent PIN) Screen
# Time, the Inappropriate Typing Scanner and Firefox's password. The window is settings.qml; it
# says what to change on its console (OLLIE-ACTION ...), and this does it.
set -uo pipefail
# The window says what to do in its console messages (console.log). Qt sends
# those to the system journal when its output is not a terminal (always,
# started from the desktop): here they must come, plain.
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
cfg="$HOME/.config/ollie" mango="$HOME/.config/MangoHud/MangoHud.conf"
mkdir -p "$cfg"
flag() { [[ -e "$cfg/$1" ]] && echo off || echo on; }
setting() { sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n 1; }
fps=on
grep -qx 'no_display' "$mango" 2>/dev/null && fps=off
args=(
    "steam=$(flag steam-in-window)" "fps=$fps" "overlay=$(/usr/local/bin/ollie-overlay --which)" "voice=$(flag no-voice)" "boost=$(flag no-speed-boost)" "sound=$(flag no-startup-sound)"
    "mode=$(setting MODE "$cfg/colours")" "colour=$(setting COLOUR "$cfg/colours")" "gold=$([[ -e $cfg/gold-unlocked ]] && echo on || echo off)"
    "easyread=$(cat "$cfg/easyread" 2>/dev/null)" "language=$(cat "$cfg/language" 2>/dev/null)" "screensaver=$(setting MINUTES "$cfg/screensaver")"
    "padmouse=$(setting MOUSE "$cfg/controller.conf")" "seasons=$(setting SEASONS "$cfg/seasons")" "birthday=$(setting BIRTHDAY "$cfg/seasons")"
    "bedschool=$(setting BEDTIME_SCHOOL /etc/ollie/parent.conf)" "bedweekend=$(setting BEDTIME_WEEKEND /etc/ollie/parent.conf)" "wake=$(setting WAKE /etc/ollie/parent.conf)"
    "screentime=$(setting SCREEN_TIME /etc/ollie/parent.conf)" "scanner=$(setting SCANNER /etc/ollie/parent.conf)"
    "pin=$(setting PIN_MD5 /etc/ollie/parent.conf)" "left=$(/usr/local/bin/ollie-parent left)"
    "updates=$(cat /etc/ollie/update-checker 2>/dev/null || echo off)"
    "firefox=$([[ -n "$(setting FIREFOX_SHA256 /etc/ollie/parent.conf)" ]] && echo on || echo off)"
)
onoff() { # onoff FILE on|off: the setting is on when FILE is not there
    if [[ $2 == on ]]; then rm -f "$cfg/$1"; else touch "$cfg/$1"; fi
}
while IFS= read -r line; do
    [[ $line == *"OLLIE-ACTION "* ]] || continue
    read -r -a a <<<"${line#*OLLIE-ACTION }"
    case "${a[0]}" in
    steam) onoff steam-in-window "${a[1]}" ;;
    boost) onoff no-speed-boost "${a[1]}" ;;
    sound) onoff no-startup-sound "${a[1]}" ;;
    voice) onoff no-voice "${a[1]}" ;;
    overlay) /usr/local/bin/ollie-overlay "${a[1]}" ;;
    updates)
        if [[ ${a[1]} == on ]]; then
            /usr/local/bin/ollie-update-checker --enable && systemctl --user start ollie-update-checker.timer 2>/dev/null
        else
            /usr/local/bin/ollie-update-checker --disable && systemctl --user stop ollie-update-checker.timer 2>/dev/null
        fi
        ;;
    fps)
        mkdir -p "${mango%/*}"
        touch "$mango"
        sed -i '/^no_display$/d' "$mango"
        [[ ${a[1]} == off ]] && echo no_display >>"$mango"
        ;;
    colours) /usr/local/bin/ollie-colours "${a[1]}" "${a[2]}" ${a[3]:+--background} ;;
    screen-time) sudo -n /usr/local/bin/ollie-parent screen-time "${a[1]}" ;;
    extra) sudo -n /usr/local/bin/ollie-parent extra "${a[1]}" ;;
    bedtime) sudo -n /usr/local/bin/ollie-parent bedtime "${a[1]:-}" "${a[2]:-}" ;;
    wake) sudo -n /usr/local/bin/ollie-parent wake "${a[1]:-}" ;;
    scanner) sudo -n /usr/local/bin/ollie-parent scanner "${a[1]}" ;;
    pin) printf '%s\n' "${a[1]:-}" | sudo -n /usr/local/bin/ollie-parent pin ;;
    firefox-password)
        if [[ ${a[1]:-} == remove ]]; then
            printf '\n' | sudo -n /usr/local/bin/ollie-parent firefox-password
        else
            /usr/local/bin/ollie-firefox --set &
        fi
        ;;
    notes) /usr/local/bin/ollie-scanner-notes --unlocked & ;; # Settings asked for the PIN already
    pad-mouse)
        if [[ ${a[1]:-} =~ ^(on|off)$ ]]; then
            hub="$(setting HUB_BUTTON "$cfg/controller.conf")"
            printf 'HUB_BUTTON=%s\nMOUSE=%s\n' "${hub:-316}" "${a[1]}" >"$cfg/controller.conf"
        fi
        ;;
    seasons | birthday)
        key=SEASONS
        [[ ${a[0]} == birthday ]] && key=BIRTHDAY
        if [[ ${a[1]:-} =~ ^(on|off|[01][0-9]-[0-3][0-9])$ ]]; then
            touch "$cfg/seasons"
            sed -i "/^$key=/d" "$cfg/seasons"
            echo "$key=${a[1]}" >>"$cfg/seasons"
            (/usr/local/bin/ollie-seasons >/dev/null 2>&1 &)
        fi
        ;;
    easyread) [[ ${a[1]:-} =~ ^(on|off)$ ]] && /usr/local/bin/ollie-easyread "${a[1]}" ;;
    language) [[ ${a[1]:-} =~ ^[a-z]{2}$ ]] && /usr/local/bin/ollie-language "${a[1]}" ;;
    screensaver) [[ ${a[1]:-} =~ ^([0-9]{1,2}|off)$ ]] && printf 'MINUTES=%s\n' "${a[1]}" >"$cfg/screensaver" ;;
    pad-setup) (setsid env -u QT_FORCE_STDERR_LOGGING -u QT_MESSAGE_PATTERN -u QT_LOGGING_RULES /usr/local/bin/ollie-gamehub --setup >/dev/null 2>&1 &) ;;
    recovery) (setsid env -u QT_FORCE_STDERR_LOGGING -u QT_MESSAGE_PATTERN -u QT_LOGGING_RULES /usr/local/bin/ollie-recovery >/dev/null 2>&1 &) ;;
    esac
done < <(qml6 /usr/local/share/ollie/settings.qml -- "${args[@]}" 2>&1)
