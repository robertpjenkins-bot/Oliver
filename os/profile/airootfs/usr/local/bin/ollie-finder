#!/bin/bash
# Ollie Finder: type a few letters, and every app and file of yours with
# them in its name shows up at once; Enter (or a click) opens it. It looks
# through the apps menu and the home folder (not hidden folders) when it
# opens; the window is finder.qml, which says on its console what to open
# (OLLIE-ACTION open app|file PATH). Its secrets: "ollie" unlocks the Ollie
# Gold colours (OLLIE-ACTION secret gold).
set -uo pipefail
export QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' QT_LOGGING_RULES='qml.debug=true;js.debug=true;default.debug=true'
export QML_XHR_ALLOW_FILE_READ=1
index="${XDG_RUNTIME_DIR:-/tmp}/ollie-finder-$$.txt"
trap 'rm -f -- "$index"' EXIT
{
    # Apps: "app<TAB>name<TAB>its .desktop file", the first of each name.
    for d in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications \
        "$HOME/.local/share/flatpak/exports/share/applications" /var/lib/flatpak/exports/share/applications; do
        for f in "$d"/*.desktop; do
            [[ -f $f ]] || continue
            grep -qiE '^(NoDisplay|Hidden)=true' "$f" && continue
            name="$(sed -n 's/^Name=//p' "$f" | head -n 1)"
            [[ -n $name ]] && printf 'app\t%s\t%s\n' "$name" "$f"
        done
    done | awk -F'\t' '!seen[$2]++'
    # Files and folders in the home folder (not hidden ones; at most 60000).
    find "$HOME" -mindepth 1 -maxdepth 8 \( -name '.*' -o -name 'node_modules' -o -name '__pycache__' \) -prune -o \
        \( -type d -printf 'folder\t%f\t%p\n' \) -o \( -type f -printf 'file\t%f\t%p\n' \) 2>/dev/null | head -n 60000
} >"$index"
while IFS= read -r line; do
    case "$line" in
    *"OLLIE-ACTION trophy "*) # a trophy event (ollie-trophy count|max|add ...)
        read -r -a t <<<"${line#*OLLIE-ACTION trophy }"
        (/usr/local/bin/ollie-trophy "${t[@]}" >/dev/null 2>&1 &)
        ;;
    *"OLLIE-ACTION open app "*)
        f="${line#*OLLIE-ACTION open app }"
        (setsid gio launch "$f" >/dev/null 2>&1 || setsid kioclient exec "$f" >/dev/null 2>&1 &)
        ;;
    *"OLLIE-ACTION open file "*) (setsid xdg-open "${line#*OLLIE-ACTION open file }" >/dev/null 2>&1 &) ;;
    *"OLLIE-ACTION secret gold"*)
        cfg="$HOME/.config/ollie"
        mkdir -p "$cfg" && touch "$cfg/gold-unlocked"
        (/usr/local/bin/ollie-trophy count secret >/dev/null 2>&1 &)
        mode="$(sed -n 's/^MODE=//p' "$cfg/colours" 2>/dev/null | tail -n 1)"
        (/usr/local/bin/ollie-colours "${mode:-dark}" gold --background &)
        ;;
    *"OLLIE-ACTION show "*) (setsid xdg-open "$(dirname "${line#*OLLIE-ACTION show }")" >/dev/null 2>&1 &) ;;
    esac
done < <(qml6 /usr/local/share/ollie/finder.qml -- "index=$index" "home=$HOME" 2>&1)
