#!/bin/bash
# Ollie's voice: says the words given, in Ollie's high, happy voice
# (espeak-ng), in the pet, the games and the learning apps. Ollie OS
# Settings switches it off (~/.config/ollie/no-voice).
#   ollie-say WORDS...
[[ -e "$HOME/.config/ollie/no-voice" ]] && exit 0
command -v espeak-ng >/dev/null || exit 0
# One at a time: a new one stops the last.
pkill -u "$UID" -f '^espeak-ng -v en-us\+f3' 2>/dev/null
exec espeak-ng -v en-us+f3 -p 75 -s 155 -a 140 -- "$*" >/dev/null 2>&1
