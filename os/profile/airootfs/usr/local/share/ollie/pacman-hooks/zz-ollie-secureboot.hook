# (Put in /etc/pacman.d/hooks by the installer, when it set up Secure Boot.)
# After a new Linux or start-up menu: signed again with this Ollie OS's key,
# so the computer still starts with Secure Boot on (/usr/local/lib/ollie/secureboot).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/systemd/boot/efi/systemd-bootx64.efi

[Action]
Description = Signing Ollie OS's start-up for Secure Boot...
When = PostTransaction
Exec = /usr/local/lib/ollie/secureboot resign
