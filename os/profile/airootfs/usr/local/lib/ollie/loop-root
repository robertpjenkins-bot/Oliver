#!/bin/sh
# In the start-up image (initramfs) of an Ollie OS installed into a system
# file on a drive (ollie-install-folder): finds that drive, mounts it at
# /run/ollie-host (which stays mounted once the system runs), and opens the
# file as a drive of its own (/dev/loopN), which the system then starts from
# (root=UUID=... on the kernel command line).
#
# Where the file is: /etc/ollie-loop-root.conf, put into the start-up image
#   HOST_UUID=  the drive's ID       HOST_FS=  its format (exfat, ntfs3, ext4...)
#   HOST_OPTS=  mount options        FILE=     the file's path on the drive
conf=/etc/ollie-loop-root.conf
[ -f "$conf" ] || exit 0
value() { sed -n "s/^$1=//p" "$conf" | head -n 1; }
uuid="$(value HOST_UUID)" fs="$(value HOST_FS)" opts="$(value HOST_OPTS)" file="$(value FILE)"

# A USB drive can take a while to appear.
i=0
while [ ! -e "/dev/disk/by-uuid/$uuid" ] && [ "$i" -lt 90 ]; do
    sleep 1
    i=$((i + 1))
done
if [ ! -e "/dev/disk/by-uuid/$uuid" ]; then
    echo "Ollie OS: the drive with Ollie OS's system file ($uuid) is not plugged in." >/dev/console
    exit 1
fi

mkdir -p /run/ollie-host
if ! mount -t "$fs" ${opts:+-o "$opts"} "/dev/disk/by-uuid/$uuid" /run/ollie-host; then
    echo "Ollie OS: the drive with Ollie OS's system file could not be opened. If Windows uses it too, start Windows and shut it down with Shift held (Fast Startup leaves it locked)." >/dev/console
    exit 1
fi
if [ ! -f "/run/ollie-host/$file" ]; then
    echo "Ollie OS: its system file is not on the drive any more: $file" >/dev/console
    exit 1
fi
losetup -f "/run/ollie-host/$file"
