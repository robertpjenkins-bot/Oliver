#!/bin/bash
# Annie OS Maker: builds the Annie OS ISO on this computer and saves it in
# Downloads. For Linux and SteamOS (desktop mode). It never asks for a
# password.
#
# How: it gets Arch Linux's bootstrap (a small Arch system in a folder:
# already unpacked from an earlier run, already in Downloads, or downloaded
# there) and runs Arch's own ISO builder, mkarchiso, inside it. All of that happens
# as "root" of a user namespace of its own, which any user may make: really
# the person running the Maker, so nothing outside its own folder is touched.
#
# The first time it runs it installs itself into Downloads/Annie OS Maker
# (with an entry in the apps menu) and keeps everything there: the Arch
# Linux it builds with (in work/) and the log. The ISO goes in Downloads.
#
# Downloads and builds that fail are tried again, three times each, before
# it gives up. The whole output of the last run is in
# Downloads/Annie OS Maker/work/last-build.log.
#
# Environment, for testing:
#   ANNIE_MAKER_MIRRORS     space-separated Arch mirrors (each the part before /$repo/os/$arch)
#   ANNIE_MAKER_BOOTSTRAP   use this bootstrap tarball instead of downloading one
#   ANNIE_MAKER_OUT         save the ISO here instead of where the Maker is installed
#   ANNIE_MAKER_INSTALL_TO  install into this folder instead of Downloads
#   ANNIE_MAKER_NEED_GB     free space to insist on (30 GB)
set -u

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
profile_src=$here/profile
downloads=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
[ "$downloads" = "$HOME" ] && downloads=$HOME/Downloads
# Where it is installed: Downloads holds "Annie OS Maker" and the ISOs it
# makes.
place_at() {
	place=$1
	install_dir="$place/Annie OS Maker"
	cache=$install_dir/work
	builder=$cache/builder
	log=$cache/last-build.log
}
if [ -e "$here/.installed" ]; then
	place_at "$(dirname "$here")"
else
	place_at "$downloads"
fi
# Where Makers before this one kept their work.
old_cache=${XDG_CACHE_HOME:-$HOME/.cache}/annie-os-maker
read -ra mirrors <<< "${ANNIE_MAKER_MIRRORS:-https://geo.mirror.pkgbuild.com https://fastly.mirror.pkgbuild.com https://mirror.rackspace.com/archlinux https://mirrors.kernel.org/archlinux}"
tries=3

say() { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }

# --- Inside the namespace ----------------------------------------------------
#
# Run as "$0 __inside". Unpacks the bootstrap if needed, enters it, installs
# archiso and builds the ISO into $builder/build/out.

in_root() {
	chroot "$builder" /usr/bin/env -i HOME=/root TERM="${TERM:-dumb}" LANG=C.UTF-8 \
		PATH=/usr/local/sbin:/usr/local/bin:/usr/bin "$@"
}

retry() {
	local i
	for i in $(seq 1 $tries); do
		"$@" && return 0
		[ "$i" -lt $tries ] && { note "That didn't work; trying again in 15 seconds ($((i + 1)) of $tries)."; sleep 15; }
	done
	return 1
}

inside() {
	set -o pipefail
	local bootstrap=$1

	if [ ! -x "$builder/usr/bin/pacman" ]; then
		say "Unpacking Arch Linux"
		rm -rf -- "$builder"
		mkdir -p -- "$builder"
		local owner=(--numeric-owner)
		# With only one user to be, every file has to be that user's.
		[ -n "${ANNIE_SINGLE_ID:-}" ] && owner=(--no-same-owner)
		# (GNU tar can't keep the bootstrap's file capabilities here, and
		# needn't: only the ISO's own files matter.)
		tar --help 2>/dev/null | grep -q -- --warning= && owner+=(--warning=no-unknown-keyword)
		tar -x --zstd --strip-components=1 "${owner[@]}" -f "$bootstrap" -C "$builder" ||
			{ echo "Couldn't unpack $bootstrap"; return 1; }
	fi

	# These mounts exist only in this namespace and vanish with it.
	mount --make-rprivate /
	mount --bind "$builder" "$builder" &&
		mount -t proc proc "$builder/proc" &&
		mount --rbind /sys "$builder/sys" &&
		mount --rbind /dev "$builder/dev" &&
		mount -t tmpfs tmpfs "$builder/run" &&
		mount -t tmpfs -o mode=1777 tmpfs "$builder/tmp" ||
		{ echo "Couldn't set up Arch Linux's folder"; return 1; }
	rm -f "$builder/etc/resolv.conf"
	cp -L /etc/resolv.conf "$builder/etc/resolv.conf" 2>/dev/null || true

	local m
	for m in "${mirrors[@]}"; do
		# shellcheck disable=SC2016 # pacman's own $repo and $arch
		printf 'Server = %s/$repo/os/$arch\n' "$m"
	done > "$builder/etc/pacman.d/mirrorlist"
	# Downloading as another user, the sandbox and the free space check
	# can't work in a user namespace.
	fix_pacman_conf "$builder/etc/pacman.conf"

	# Both are quick when already done, and mend a keyring left half made.
	say "Setting up Arch Linux's signing keys"
	{ in_root pacman-key --init && in_root pacman-key --populate archlinux; } >/dev/null ||
		{ echo "Couldn't set up the signing keys"; return 1; }

	say "Getting Arch's ISO builder (archiso)"
	# grub and qemu-img make the ready-to-use disk file.
	retry in_root pacman -Syu --noconfirm --needed archiso grub qemu-img ||
		{ echo "Couldn't install archiso. Is this computer connected to the internet?"; return 1; }

	# Make Arch's tools work here: we are root, but only of this namespace.
	# - pacstrap/arch-chroot -N set up a chroot with bind mounts rather
	#   than the ones only real root may make; mkarchiso picks -N for anyone
	#   but root, so pick it always.
	# - Their own namespace needs no new user mapping: this one has it.
	sed -i 's/if (( EUID != 0 )); then/if true; then/' "$builder/usr/bin/mkarchiso"
	# shellcheck disable=SC2016 # $pid_unshare is pacstrap's own
	sed -i 's/^mount_unshare=.*/mount_unshare="$pid_unshare --mount"/' \
		"$builder/usr/bin/pacstrap" "$builder/usr/bin/arch-chroot"
	install -Dm 0755 "$here/mksquashfs-owners" "$builder/usr/local/bin/mksquashfs"
	install -Dm 0755 "$here/annie-make-disk" "$builder/usr/local/bin/annie-make-disk"
	if [ -n "${ANNIE_SINGLE_ID:-}" ]; then
		touch "$builder/usr/local/bin/.annie-single-id"
	else
		rm -f "$builder/usr/local/bin/.annie-single-id"
	fi

	say "Copying the Annie OS recipe"
	rm -rf -- "$builder/build"
	mkdir -p -- "$builder/build"
	cp -a -- "$profile_src" "$builder/build/profile"
	fix_pacman_conf "$builder/build/profile/pacman.conf"

	say "Checking that Arch Linux has every package Annie OS uses"
	local rc
	check_packages
	rc=$?
	[ $rc -eq 0 ] || return $rc

	say "Building Annie OS (downloads about 2 GB; the longest part)"
	retry build_iso || { echo "Building the ISO failed (see the messages above)"; return 1; }

	say "Making Annie OS ready to use: a disk file for GNOME Boxes"
	in_root env ANNIE_DISK_GB="${ANNIE_DISK_GB:-64}" /usr/local/bin/annie-make-disk || { echo "Making the disk file failed (see the messages above)"; return 1; }
	in_root gpgconf --homedir /etc/pacman.d/gnupg --kill all >/dev/null 2>&1
	return 0
}

fix_pacman_conf() {
	sed -i 's/^DownloadUser/#DownloadUser/; s/^CheckSpace/#CheckSpace/' "$1"
	grep -q '^DisableSandbox' "$1" || sed -i '/^\[options\]/a DisableSandbox' "$1"
}

# Find packages Arch no longer carries before downloading anything: leave
# out the ones Annie OS can do without (optional-packages.txt), and return 2
# (no point trying again) when one it needs is gone.
check_packages() {
	local conf=/build/profile/pacman.conf
	local list=$builder/build/profile/packages.x86_64
	local optional=$builder/build/profile/optional-packages.txt
	local wanted missing required=() p
	retry in_root pacman --config "$conf" -Sy >/dev/null ||
		{ echo "Couldn't get Arch Linux's package lists. Is this computer connected to the internet?"; return 1; }
	mapfile -t wanted < <(sed 's/#.*//; s/[[:blank:]]//g; /^$/d' "$list")
	mapfile -t missing < <(in_root pacman --config "$conf" -Sp --print-format %n "${wanted[@]}" 2>&1 >/dev/null |
		sed -n 's/^error: target not found: //p')
	if [ ${#missing[@]} -eq 0 ]; then
		note "All ${#wanted[@]} are there."
		return 0
	fi
	for p in "${missing[@]}"; do
		if grep -qx -- "$p" "$optional" 2>/dev/null; then
			note "Arch Linux no longer has $p; Annie OS will do without it."
			sed -i "/^[[:blank:]]*${p//./\\.}[[:blank:]]*\$/d" "$list"
		else
			required+=("$p")
		fi
	done
	if [ ${#required[@]} -gt 0 ]; then
		echo "Arch Linux no longer has these packages Annie OS needs: ${required[*]}"
		echo "Annie OS's recipe has to be updated for them. Please send this message to whoever made it."
		return 2
	fi
	return 0
}

build_iso() {
	rm -rf -- "$builder/build/work" "$builder/build/out"
	in_root mkarchiso -v -w /build/work -o /build/out /build/profile
}

# --- Outside -----------------------------------------------------------------

# Show the window people double-clicked into: a terminal, so they can watch.
open_terminal() {
	local t
	for t in konsole gnome-terminal kgx xfce4-terminal xterm; do
		command -v "$t" >/dev/null || continue
		case $t in
		konsole) exec konsole -e "$0" ;;
		gnome-terminal | kgx) exec "$t" -- "$0" ;;
		*) exec "$t" -e "$0" ;;
		esac
	done
}

tell() { # tell error|msgbox TEXT: a window too, if there's a way to show one
	command -v kdialog >/dev/null && kdialog --title "Annie OS Maker" "--$1" "$2" 2>/dev/null &
	true
}

stop() {
	printf '\n\033[1;31m%s\033[0m\n' "$*"
	tell error "$*"
	[ -t 0 ] && read -rp "Press Enter to close. " _
	exit 1
}

# The first time: copy the Maker into Downloads/Annie OS Maker, add it to
# the apps menu, and carry on from there.
install_self() {
	[ -e "$here/.installed" ] && return 0
	[ -n "${ANNIE_MAKER_NO_INSTALL:-}" ] && return 0

	# Always Downloads, without asking (or the folder given for testing).
	place_at "${ANNIE_MAKER_INSTALL_TO:-$downloads}"

	mkdir -p -- "$install_dir" || stop "Couldn't make $install_dir"
	# Unpacked right there already (in Downloads): it's in place, nothing
	# to copy.
	if [ "$(cd "$install_dir" && pwd -P)" != "$(cd "$here" && pwd -P)" ]; then
		printf '\033[1;35mInstalling Annie OS Maker into %s\033[0m\n' "$install_dir"
		rm -rf -- "$install_dir/profile"
		local f
		for f in annie-os-maker annie-os-usb mksquashfs-owners annie-make-disk profile "READ ME.txt" "Annie OS Maker.desktop"; do
			[ -e "$here/$f" ] || continue
			cp -a -- "$here/$f" "$install_dir/" || stop "Couldn't copy $f into $install_dir"
		done
	fi
	touch "$install_dir/.installed" || stop "Couldn't write in $install_dir"
	local apps=${XDG_DATA_HOME:-$HOME/.local/share}/applications
	mkdir -p -- "$apps"
	printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Annie OS Maker' \
		"Comment=Build the Annie OS ISO and save it in $place" \
		"Exec=\"$install_dir/annie-os-maker\"" 'Terminal=true' 'Icon=media-optical' 'Categories=System;' \
		> "$apps/annie-os-maker.desktop"
	printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Annie OS USB Writer' \
		'Comment=Put Annie OS on a USB stick or SD card, for a Steam Machine' \
		"Exec=\"$install_dir/annie-os-usb\"" 'Terminal=true' 'Icon=drive-removable-media-usb' 'Categories=System;' \
		> "$apps/annie-os-usb.desktop"
	echo "From now on, start it from there or from your apps menu (Annie OS Maker)."
	exec "$install_dir/annie-os-maker"
}

# Remove a folder, including files owned by the namespace's other users.
remove() { [ -e "$1" ] && unshare "${map[@]}" rm -rf -- "$1"; }

# Arch Linux's bootstrap: one already in Downloads (where the Maker saves
# it) or in the Maker's own folder is used if it's whole; only when there
# is none is one downloaded, into Downloads. An older one is fine: the
# build brings it up to date first.
find_bootstrap() {
	local sums=$cache/sha256sums.txt m f name want
	rm -f -- "$sums"
	for m in "${mirrors[@]}"; do
		curl -fsSL --retry 2 -o "$sums" "$m/iso/latest/sha256sums.txt" && break
		rm -f -- "$sums"
	done

	note "Looking for Arch Linux in $downloads, $place and $cache"
	while IFS= read -r f; do
		name=${f##*/}
		want=$( [ -f "$sums" ] && awk -v n="$name" '$2 == n { print $1; exit }' "$sums")
		if [ -n "$want" ]; then
			echo "$want  $f" | sha256sum -c --quiet - 2>/dev/null || { note "$f is damaged; skipping it."; continue; }
		elif ! zstd -tq -- "$f" 2>/dev/null; then
			note "$f is damaged; skipping it."
			continue
		fi
		note "Using the Arch Linux already in $f"
		bootstrap=$f
		return 0
	done < <(ls -t -- "$downloads"/archlinux-bootstrap-*x86_64.tar.zst "$place"/archlinux-bootstrap-*x86_64.tar.zst "$cache"/archlinux-bootstrap-*x86_64.tar.zst "$old_cache"/archlinux-bootstrap-*x86_64.tar.zst 2>/dev/null)

	[ -f "$sums" ] || return 1
	want=$(awk '$2 == "archlinux-bootstrap-x86_64.tar.zst" { print $1; exit }' "$sums")
	[ -n "$want" ] || return 1
	local dest=$downloads/archlinux-bootstrap-x86_64.tar.zst
	mkdir -p -- "$downloads"
	for m in "${mirrors[@]}"; do
		note "Downloading it from $m into $downloads"
		curl -fL --retry 3 -C - --progress-bar -o "$dest.part" "$m/iso/latest/archlinux-bootstrap-x86_64.tar.zst" ||
			{ rm -f -- "$dest.part"; continue; }
		if echo "$want  $dest.part" | sha256sum -c --quiet - 2>/dev/null; then
			mv -f -- "$dest.part" "$dest"
			bootstrap=$dest
			return 0
		fi
		rm -f -- "$dest.part"
		note "The download was damaged; trying the next mirror."
	done
	return 1
}

# Only needed when Arch Linux isn't unpacked already from an earlier run.
need_bootstrap() {
	[ -n "${bootstrap:-}" ] && return 0
	if [ -x "$builder/usr/bin/pacman" ]; then
		bootstrap=-
		return 0
	fi
	say "Getting Arch Linux"
	if [ -n "${ANNIE_MAKER_BOOTSTRAP:-}" ]; then
		bootstrap=$ANNIE_MAKER_BOOTSTRAP
	else
		find_bootstrap || stop "Couldn't download Arch Linux. Is this computer connected to the internet?"
	fi
}

main() {
	if [ ! -t 1 ] && [ -z "${ANNIE_MAKER_NO_TERMINAL:-}" ]; then
		open_terminal
	fi
	install_self
	mkdir -p -- "$cache" || stop "Couldn't make $cache"
	exec > >(tee "$log") 2>&1

	printf '\033[1;35mAnnie OS Maker\033[0m\n'
	echo "Builds the Annie OS ISO for VirtualBox and saves it in your Downloads folder."
	echo "This takes 20 minutes to an hour, and needs the internet."

	[ "$(uname -m)" = x86_64 ] || stop "Annie OS can only be made on a 64-bit Intel or AMD computer."
	[ -d "$profile_src" ] || stop "The Annie OS recipe is missing: keep the profile folder next to annie-os-maker."
	local tool
	for tool in curl tar zstd unshare chroot sha256sum; do
		command -v "$tool" >/dev/null || stop "This computer is missing the $tool program."
	done

	# Be every user of the build (best: files keep their real owners), or,
	# where this computer allows only one, be that one.
	if unshare --map-auto --map-root-user true 2>/dev/null; then
		map=(--map-auto --map-root-user)
		unset ANNIE_SINGLE_ID
	elif unshare --map-root-user true 2>/dev/null; then
		map=(--map-root-user)
		export ANNIE_SINGLE_ID=1
	else
		stop "This computer doesn't let programs make their own user namespace, which the Maker needs to work without a password. (On Ubuntu 24.04 and newer, AppArmor blocks it: run sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0 and try again.)"
	fi

	# Bring along the Arch Linux an older Maker unpacked, instead of
	# getting it again.
	local old
	for old in "$old_cache" "$downloads/Annie OS Maker/work"; do
		[ -d "$old/builder" ] && [ ! -e "$builder" ] && [ "$old" != "$cache" ] || continue
		say "Moving the Arch Linux from $old into $cache"
		unshare "${map[@]}" mv -- "$old/builder" "$builder" || note "Couldn't; it will be got again."
	done

	local free_kb
	free_kb=$(df -Pk "$cache" | awk 'NR == 2 { print $4 }')
	local need=${ANNIE_MAKER_NEED_GB:-30}
	if [ "${free_kb:-0}" -lt $((need * 1024 * 1024)) ]; then
		stop "The Maker needs $need GB free in your home folder; there is $((free_kb / 1024 / 1024)) GB."
	fi

	local attempt ok='' rc
	for attempt in $(seq 1 $tries); do
		[ "$attempt" -gt 1 ] && say "Trying the whole build again ($attempt of $tries)"
		[ -x "$builder/usr/bin/pacman" ] || [ "${bootstrap:--}" != - ] || bootstrap=
		need_bootstrap
		unshare "${map[@]}" --mount --pid --fork --kill-child -- "$0" __inside "$bootstrap"
		rc=$?
		if [ $rc -eq 0 ]; then
			ok=1
			break
		fi
		# Trying again can't fix this one (it said why).
		[ $rc -eq 2 ] && stop "Annie OS couldn't be made: see the message just above. It's also saved in $log."
		# A half-unpacked or broken Arch is the likeliest reason; start clean.
		[ "$attempt" -eq 1 ] || remove "$builder"
	done
	[ -n "$ok" ] || stop "Annie OS couldn't be made. The messages above say why; they're also saved in $log."

	local iso disk out
	iso=$(ls -t "$builder"/build/out/*.iso 2>/dev/null | head -n 1)
	disk=$(ls -t "$builder"/build/out/*.qcow2 2>/dev/null | head -n 1)
	[ -n "$iso" ] && [ -n "$disk" ] || stop "The build finished but left no ISO or disk file."
	out=${ANNIE_MAKER_OUT:-$place}
	mkdir -p -- "$out"
	cp -- "$disk" "$out/" || stop "Couldn't save Annie OS in $out (is it full?)"
	cp -- "$iso" "$out/" || stop "Couldn't save the ISO in $out (is it full?)"
	# What Annie OS USB Writer puts on a stick, kept for as many sticks as wanted.
	mkdir -p -- "$install_dir/usb"
	mv -f -- "$builder"/build/out/annie-os-rootfs.img "$builder"/build/out/annie-os-usb-BOOTX64.EFI "$install_dir/usb/" ||
		stop "Couldn't keep the USB stick version in $install_dir/usb (is it full?)"

	say "Cleaning up"
	remove "$builder/build"
	note "(Arch Linux stays in $builder, so the next build is quicker. Delete $cache to free the space.)"

	printf '\n\033[1;32mDone! Annie OS is in %s:\033[0m\n' "$out"
	printf '\033[1;32m    %s\033[0m   Annie OS, ready to use\n' "$(basename "$disk")"
	printf '    %s   the installer ISO, if you want that instead\n' "$(basename "$iso")"
	echo
	echo "In GNOME Boxes: click +, choose \"Install from File\", and pick $(basename "$disk")."
	echo "It starts straight into Annie OS and asks for a password the first time."
	echo "To put it on a USB stick or SD card for a Steam Machine: Annie OS USB Writer"
	echo "(in your apps menu, or annie-os-usb in $install_dir)."

	# Offer the stick straight away.
	local yes=''
	if command -v kdialog >/dev/null && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
		kdialog --title "Annie OS Maker" --yes-label "Put it on a USB stick" --no-label "Not now" --yesno \
			"Annie OS is ready in $out: $(basename "$disk") (open it in GNOME Boxes).

Put Annie OS on a USB stick or SD card too, to start a Steam Machine from?" 2>/dev/null && yes=1
	elif [ -t 0 ]; then
		read -rp "Put Annie OS on a USB stick or SD card now, for a Steam Machine? [y/N] " a
		[[ $a == [yY]* ]] && yes=1
	fi
	[ -n "$yes" ] && exec "$install_dir/annie-os-usb" "$install_dir/usb"
	[ -t 0 ] && read -rp "Press Enter to close. " _
	return 0
}

if [ "${1:-}" = __inside ]; then
	inside "$2"
else
	main
fi
