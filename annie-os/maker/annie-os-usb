#!/bin/bash
# Annie OS USB Writer: puts the Annie OS that Annie OS Maker made onto a USB
# stick or SD card (32 GB is plenty), to start a Steam Machine (or any PC
# with UEFI) from. Everything on the stick is erased; the computer's own
# drive is never touched.
#
# It never asks for a password. Linux lets the person at the computer
# partition, format and copy files onto a removable drive (through UDisks,
# as the file manager does), but not overwrite the whole drive. So the stick
# gets two partitions:
#   ANNIE-EFI   (FAT, 512 MB)  EFI/BOOT/BOOTX64.EFI: GRUB, which opens...
#   annie-usb   (ext4, rest)   annie-os/rootfs.img: Annie OS itself, as one
#                              file, grown to fill the stick
# and Annie OS's start-up files (the annie-usb hook) open that file again
# as the system.
#
#   annie-os-usb [FOLDER]   FOLDER holds annie-os-rootfs.img and
#                           annie-os-usb-BOOTX64.EFI (default: usb/ next to
#                           this program)
#
# ANNIE_USB_TEST_DEV=/dev/loopN offers that device too (for testing).
set -u

# Started from the desktop, some systems leave /usr/sbin (chroot, resize2fs...)
# out of PATH.
export PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
self=$(readlink -f "$0")
here=$(cd "$(dirname "$self")" && pwd)
from=${1:-$here/usb}
rootfs=$from/annie-os-rootfs.img
efi=$from/annie-os-usb-BOOTX64.EFI
udisks=org.freedesktop.UDisks2
title="Annie OS USB Writer"

say() { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
gui() { command -v kdialog >/dev/null && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }
stop() {
	printf '\n\033[1;31m%s\033[0m\n' "$*"
	gui && kdialog --title "$title" --error "$*" 2>/dev/null
	[ -t 0 ] && read -rp "Press Enter to close. " _
	exit 1
}

# UDisks, never letting it ask for a password: if it would need one, the
# call fails and says so.
ud() { # ud OBJECT INTERFACE METHOD SIGNATURE ARGS...; the error is in $ud_error
	local obj=$1 iface=$2 method=$3 err
	shift 3
	err=$(mktemp)
	busctl --system call "$udisks" "$obj" "$udisks.$iface" "$method" "$@" 2>"$err"
	local rc=$?
	ud_error=$(cat "$err")
	rm -f -- "$err"
	return $rc
}
# why WHAT: stop, saying why UDisks said no
why() {
	case $ud_error in
	*NotAuthorized* | *"not authorized"*)
		stop "$1: this computer wants the administrator password for that, which the USB Writer won't ask for." ;;
	*) stop "$1: ${ud_error:-UDisks gave no reason}" ;;
	esac
}
obj() { echo "/org/freedesktop/UDisks2/block_devices/${1#/dev/}"; }

if [ ! -t 1 ] && [ -z "${ANNIE_USB_NO_TERMINAL:-}" ] && [ -z "${ANNIE_IN_TERMINAL:-}" ]; then
	export ANNIE_IN_TERMINAL=1
	for t in konsole gnome-terminal kgx xfce4-terminal xterm; do
		command -v "$t" >/dev/null || continue
		case $t in
		konsole) exec konsole --hold --workdir "$(dirname "$self")" -e "$self" "$@" ;;
		gnome-terminal | kgx) exec "$t" -- "$self" "$@" ;;
		*) exec "$t" -e "$self" "$@" ;;
		esac
	done
fi

printf '\033[1;35m%s\033[0m\n' "$title"
echo "Puts Annie OS on a USB stick or SD card, to start a Steam Machine from."

[ -f "$rootfs" ] && [ -f "$efi" ] ||
	stop "There's no Annie OS to put on a stick yet. Run Annie OS Maker first (it makes it in $from)."
for tool in busctl udisksctl lsblk e2fsck resize2fs findmnt; do
	command -v "$tool" >/dev/null || stop "This computer is missing the $tool program."
done
busctl --system introspect "$udisks" /org/freedesktop/UDisks2/Manager >/dev/null 2>&1 ||
	stop "UDisks isn't running on this computer, so the stick can't be written without a password."

# --- Which stick ------------------------------------------------------------

used=$(( $(du -B1 "$rootfs" | cut -f1) ))
need=$(( used + 1024 * 1024 * 1024 ))   # Annie OS, the EFI partition, room to start
system_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -n 1)

choices=()
names=()
# field NAME LINE: a value from lsblk -P's NAME="value" output (columns can
# be empty, so plain words won't do)
field() { sed -n "s/.*\b$1=\"\([^\"]*\)\".*/\1/p" <<<"$2"; }
while IFS= read -r line; do
	name=$(field NAME "$line")
	size=$(field SIZE "$line")
	rm=$(field RM "$line")
	tran=$(field TRAN "$line")
	type=$(field TYPE "$line")
	model=$(field MODEL "$line")
	[ "$name" = "${ANNIE_USB_TEST_DEV:-}" ] && rm=1 type=disk
	[ "$type" = disk ] || continue
	case $name in /dev/zram*) continue ;; esac
	[ -n "$system_disk" ] && [ "${name##*/}" = "$system_disk" ] && continue
	# Only USB drives and SD cards: never the computer's own drive.
	[ "$rm" = 1 ] || [ "$tran" = usb ] || [[ $name == /dev/mmcblk* ]] || continue
	[ "${size:-0}" -ge "$need" ] || continue
	label="$name  $((size / 1000 / 1000 / 1000)) GB  ${model:-drive}"
	choices+=("$name" "$label" off)
	names+=("$label")
done < <(lsblk -dbnpPo NAME,SIZE,RM,TRAN,TYPE,MODEL)

if [ ${#names[@]} -eq 0 ]; then
	stop "No USB stick or SD card big enough was found. Plug one in ($(( need / 1000 / 1000 / 1000 + 1 )) GB or bigger; 32 GB is good) and run this again."
fi
choices[2]=on

if gui; then
	dev=$(kdialog --title "$title" --radiolist "Which USB stick or SD card should Annie OS go on?
EVERYTHING ON IT WILL BE ERASED." "${choices[@]}" 2>/dev/null) || exit 0
	answer=$(kdialog --title "$title" --inputbox "Everything on $dev will be erased.

Type ERASE to go ahead." 2>/dev/null) || exit 0
else
	echo
	echo "USB sticks and SD cards:"
	for i in "${!names[@]}"; do echo "  $((i + 1)). ${names[$i]}"; done
	read -rp "Which one should Annie OS go on (number)? " n
	dev=${choices[$(( (n - 1) * 3 ))]:-}
	[ -n "$dev" ] && [ "$n" -ge 1 ] 2>/dev/null || stop "No drive chosen."
	echo "Everything on $dev will be erased."
	read -rp "Type ERASE to go ahead: " answer
fi
[ "$answer" = ERASE ] || stop "Nothing was erased (you didn't type ERASE)."

# --- Erase and partition ----------------------------------------------------

say "Erasing $dev"
for part in $(lsblk -lnpo NAME "$dev" | tail -n +2); do
	findmnt -rno TARGET -S "$part" >/dev/null 2>&1 || continue
	udisksctl unmount --no-user-interaction -b "$part" >/dev/null ||
		stop "Couldn't unmount $part. Close anything using the stick and try again."
done
erase() { ud "$(obj "$dev")" Block Format "sa{sv}" gpt 1 auth.no_user_interaction b true >/dev/null; }
erase || { sleep 3; erase; } || why "Couldn't erase $dev"

mib=$((1024 * 1024))
make_part() { # make_part OFFSET SIZE TYPE NAME FSTYPE LABEL: the new partition's object in $part_obj
	local out
	out=$(mktemp)
	ud "$(obj "$dev")" PartitionTable CreatePartitionAndFormat "ttssa{sv}sa{sv}" \
		"$1" "$2" "$3" "$4" 1 auth.no_user_interaction b true \
		"$5" 3 label s "$6" take-ownership b true auth.no_user_interaction b true >"$out" || { rm -f -- "$out"; return 1; }
	part_obj=$(sed -n 's/^o "\(.*\)"$/\1/p' "$out")
	rm -f -- "$out"
	[ -n "$part_obj" ]
}
say "Making its partitions"
make_part $mib $((512 * mib)) c12a7328-f81f-11d2-ba4b-00a0c93ec93b EFI vfat ANNIE-EFI ||
	why "Couldn't make the EFI partition on $dev"
esp_obj=$part_obj
make_part $((513 * mib)) 0 0fc63daf-8483-4772-8e79-3d69d8477de4 annie-usb ext4 annie-usb ||
	why "Couldn't make Annie OS's partition on $dev"
data_obj=$part_obj
esp=/dev/${esp_obj##*/}
data=/dev/${data_obj##*/}

mount_it() { # mount_it DEVICE -> where
	local out
	out=$(udisksctl mount --no-user-interaction -b "$1") || return 1
	sed -n 's/^Mounted .* at \(.*\)$/\1/p' <<<"$out" | sed 's/\.$//'
}
esp_dir=$(mount_it "$esp") && [ -d "$esp_dir" ] || stop "Couldn't open the EFI partition on $dev."
data_dir=$(mount_it "$data") && [ -d "$data_dir" ] || stop "Couldn't open Annie OS's partition on $dev."

# --- Copy -------------------------------------------------------------------

say "Copying Annie OS onto it (the slow part: about $((used / 1000 / 1000 / 1000 + 1)) GB)"
mkdir -p "$esp_dir/EFI/BOOT" "$data_dir/annie-os" || stop "Couldn't write on $dev."
cp -- "$efi" "$esp_dir/EFI/BOOT/BOOTX64.EFI" || stop "Couldn't copy the boot loader onto $dev."
target=$data_dir/annie-os/rootfs.img
# (The file's empty parts aren't written, so this is quicker than its size.)
dd if="$rootfs" of="$target" bs=4M conv=sparse status=progress ||
	stop "Couldn't copy Annie OS onto $dev (is it big enough?)."
sync -f "$target" 2>/dev/null || sync

say "Growing Annie OS to fill the stick"
# Room for the file to grow into, less a little for the stick's own needs.
avail=$(df -B1 --output=avail "$data_dir" | tail -n 1 | tr -d ' ')
held=$(( $(du -B1 "$target" | cut -f1) ))
size_k=$(( (avail + held - 256 * mib) / 1024 ))
e2fsck -fp "$target" >/dev/null 2>&1
if [ "$size_k" -gt $(( $(stat -c %s "$target") / 1024 )) ]; then
	resize2fs "$target" "${size_k}K" >/dev/null 2>&1 || echo "    (Couldn't grow it; Annie OS still works, with less room.)"
fi
echo "    Annie OS has $(( size_k / 1024 / 1024 )) GB on the stick."

say "Finishing"
sync
udisksctl unmount --no-user-interaction -b "$esp" >/dev/null
udisksctl unmount --no-user-interaction -b "$data" >/dev/null ||
	echo "    (Couldn't unmount it; wait a moment before pulling it out.)"

printf '\n\033[1;32mDone! Annie OS is on %s.\033[0m\n' "$dev"
cat <<EOF
To start the Steam Machine from it:
  1. Plug it into the Steam Machine and turn it off.
  2. Turn it on and open its boot menu, then choose the USB stick / SD card.
     (If it won't start: in its firmware settings, turn Secure Boot off.)
  3. Annie OS starts and asks for a password the first time.
SteamOS on the Steam Machine's own drive isn't touched; start without the
stick to get it back.
EOF
gui && kdialog --title "$title" --msgbox "Annie OS is on $dev.

Plug it into the Steam Machine, open its boot menu, and choose it." 2>/dev/null &
[ -t 0 ] && read -rp "Press Enter to close. " _
exit 0
