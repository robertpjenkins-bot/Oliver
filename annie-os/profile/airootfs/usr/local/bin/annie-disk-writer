#!/usr/bin/env python3
"""Annie Disk Writer - format USB drives as exFAT or FAT32, copy files onto
them, or write a disk image (.iso / .img) to them."""
import json
import os
import queue
import re
import shutil
import subprocess
import tempfile
import threading
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

HERE = os.path.dirname(os.path.realpath(__file__))
FAT32_MAX = 4 * 1024 ** 3 - 1


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024


def list_disks():
    out = subprocess.run(["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,MODEL,TRAN,RM,TYPE,MOUNTPOINTS"],
                         capture_output=True, text=True, check=True).stdout
    disks = []
    for d in json.loads(out)["blockdevices"]:
        if d["type"] != "disk" or not d["size"]:
            continue
        if not re.match(r"^/dev/(sd[a-z]+|nvme\d+n\d+|mmcblk\d+|vd[a-z]+)$", d["path"]):
            continue  # zram, loop and other virtual devices
        mounts = set()
        stack = [d]
        while stack:  # partitions, and anything (LVM, encryption) inside them
            node = stack.pop()
            mounts.update(m for m in (node.get("mountpoints") or []) if m)
            stack.extend(node.get("children", []))
        if mounts & {"/", "/boot", "/boot/efi", "/efi", "/home", "/run/archiso/bootmnt"}:
            continue  # the running system: never offer it
        removable = d["rm"] in (True, "1", 1) or d.get("tran") == "usb"
        disks.append({"path": d["path"], "size": int(d["size"]), "removable": removable,
                      "label": f'{d["path"]}  {human(int(d["size"]))}  {(d.get("model") or "").strip()}'
                               f'{"" if removable else "  (internal drive!)"}'})
    return disks


def helper_path():
    """pkexec runs as root, and root often cannot read inside an AppImage's
    FUSE mount, so hand it a private copy of the helper."""
    src = os.path.join(HERE, "annie-disk-helper")
    if not os.path.exists(src):
        src = "/usr/local/bin/annie-disk-helper"
    fd, dst = tempfile.mkstemp(prefix="annie-disk-helper-", dir=os.environ.get("XDG_RUNTIME_DIR"))
    with os.fdopen(fd, "wb") as out, open(src, "rb") as inp:
        out.write(inp.read())
    os.chmod(dst, 0o700)
    return dst


class App:
    def __init__(self, root):
        self.root = root
        root.title("Annie Disk Writer")
        root.minsize(560, 360)
        self.events = queue.Queue()
        self.busy = False
        self.files = []

        f = ttk.Frame(root, padding=14)
        f.pack(fill=tk.BOTH, expand=True)
        ttk.Label(f, text="🦄 Annie Disk Writer", font=("", 16, "bold")).pack(anchor=tk.W)

        row = ttk.Frame(f)
        row.pack(fill=tk.X, pady=(12, 4))
        ttk.Label(row, text="Drive:").pack(side=tk.LEFT)
        self.disk = ttk.Combobox(row, state="readonly", width=50)
        self.disk.pack(side=tk.LEFT, padx=6, fill=tk.X, expand=True)
        ttk.Button(row, text="↻", width=3, command=self.refresh).pack(side=tk.LEFT)

        nb = ttk.Notebook(f)
        nb.pack(fill=tk.BOTH, expand=True, pady=8)

        # --- format + copy tab
        fmt = ttk.Frame(nb, padding=10)
        nb.add(fmt, text="Format & copy files")
        self.fs = tk.StringVar(value="exfat")
        ttk.Radiobutton(fmt, text="exFAT  (big files, works on Windows / Mac / Linux)",
                        value="exfat", variable=self.fs).pack(anchor=tk.W)
        ttk.Radiobutton(fmt, text="FAT32  (works everywhere, files up to 4 GB)",
                        value="fat32", variable=self.fs).pack(anchor=tk.W)
        lr = ttk.Frame(fmt)
        lr.pack(fill=tk.X, pady=6)
        ttk.Label(lr, text="Name:").pack(side=tk.LEFT)
        self.label = ttk.Entry(lr, width=16)
        self.label.insert(0, "ANNIE")
        self.label.pack(side=tk.LEFT, padx=6)
        cr = ttk.Frame(fmt)
        cr.pack(fill=tk.X)
        ttk.Button(cr, text="Add files…", command=self.add_files).pack(side=tk.LEFT)
        ttk.Button(cr, text="Add folder…", command=self.add_folder).pack(side=tk.LEFT, padx=4)
        ttk.Button(cr, text="Clear", command=self.clear_files).pack(side=tk.LEFT)
        self.files_label = ttk.Label(fmt, text="No files chosen (the drive will just be formatted)")
        self.files_label.pack(anchor=tk.W, pady=4)
        ttk.Button(fmt, text="Format drive", command=self.start_format).pack(anchor=tk.E, pady=6)

        # --- image tab
        img = ttk.Frame(nb, padding=10)
        nb.add(img, text="Write image (.iso / .img)")
        ir = ttk.Frame(img)
        ir.pack(fill=tk.X)
        self.image = ttk.Entry(ir)
        self.image.pack(side=tk.LEFT, fill=tk.X, expand=True)
        ttk.Button(ir, text="Choose…", command=self.pick_image).pack(side=tk.LEFT, padx=4)
        ttk.Label(img, text="Use this to make a bootable Annie OS (or any Linux) USB stick.",
                  foreground="#666").pack(anchor=tk.W, pady=6)
        ttk.Button(img, text="Write image", command=self.start_write).pack(anchor=tk.E, pady=6)

        self.bar = ttk.Progressbar(f, maximum=100)
        self.bar.pack(fill=tk.X)
        self.status = ttk.Label(f, text="Pick a drive to begin.")
        self.status.pack(anchor=tk.W, pady=4)

        self.refresh()
        root.after(100, self.poll)

    # --- ui helpers
    def refresh(self):
        try:
            self.disks = list_disks()
        except (OSError, subprocess.CalledProcessError, ValueError) as e:
            self.disks = []
            self.status.config(text=f"Could not list drives: {e}")
        self.disk["values"] = [d["label"] for d in self.disks]
        if self.disks:
            usb = [i for i, d in enumerate(self.disks) if d["removable"]]
            self.disk.current(usb[0] if usb else 0)
        else:
            self.disk.set("")
            self.status.config(text="No drives found. Plug in a USB stick and press ↻.")

    def chosen(self):
        i = self.disk.current()
        if i < 0:
            messagebox.showwarning("Annie Disk Writer", "Pick a drive first.")
            return None
        d = self.disks[i]
        warn = "" if d["removable"] else "\n\n⚠ This looks like an INTERNAL drive, not a USB stick!"
        if not messagebox.askyesno("Erase drive?",
                                   f"Everything on\n\n{d['label']}\n\nwill be erased. Continue?{warn}",
                                   icon=messagebox.WARNING):
            return None
        return d

    def add_files(self):
        self.files += list(filedialog.askopenfilenames(initialdir=os.path.expanduser("~")))
        self.show_files()

    def add_folder(self):
        p = filedialog.askdirectory(initialdir=os.path.expanduser("~"))
        if p:
            self.files.append(p)
        self.show_files()

    def clear_files(self):
        self.files = []
        self.show_files()

    def show_files(self):
        total = sum(tree_size(p) for p in self.files)
        self.files_label.config(text=f"{len(self.files)} item(s), {human(total)} to copy after formatting"
                                if self.files else "No files chosen (the drive will just be formatted)")

    def pick_image(self):
        p = filedialog.askopenfilename(initialdir=os.path.expanduser("~/Downloads"),
                                       filetypes=[("Disk images", "*.iso *.img *.raw"), ("All files", "*")])
        if p:
            self.image.delete(0, tk.END)
            self.image.insert(0, p)

    # --- jobs
    def start_format(self):
        if self.busy:
            return
        fs = self.fs.get()
        if fs == "fat32":
            big = [p for p in all_files(self.files) if os.path.getsize(p) > FAT32_MAX]
            if big:
                messagebox.showerror("Too big for FAT32",
                                     f"{os.path.basename(big[0])} is over 4 GB, which FAT32 cannot hold.\n"
                                     "Choose exFAT instead.")
                return
        d = self.chosen()
        if d:
            label = re.sub(r"[^A-Za-z0-9 _-]", "", self.label.get()) or "ANNIE"
            self.run(self.format_job, d, fs, label, list(self.files))

    def start_write(self):
        if self.busy:
            return
        img = self.image.get()
        if not os.path.isfile(img):
            messagebox.showwarning("Annie Disk Writer", "Choose an image file first.")
            return
        d = self.chosen()
        if d:
            if os.path.getsize(img) > d["size"]:
                messagebox.showerror("Annie Disk Writer", "That image is bigger than the drive.")
                return
            self.run(self.write_job, img, d)

    def run(self, job, *args):
        self.busy = True
        self.bar["value"] = 0

        def wrapper():
            try:
                job(*args)
                self.events.put(("done", None))
            except Exception as e:  # report anything to the user rather than dying silently
                self.events.put(("error", str(e)))
        threading.Thread(target=wrapper, daemon=True).start()

    def privileged(self, *args, total=None):
        helper = helper_path()
        try:
            p = subprocess.Popen(["pkexec", "/bin/bash", helper, *args], stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True)
            result, errors = {}, []
            for line in p.stdout:
                line = line.strip()
                if line.startswith("PROGRESS "):
                    _, pct, msg = line.split(" ", 2)
                    self.events.put(("progress", (int(pct), msg)))
                elif line.startswith("TOTAL "):
                    total = int(line.split()[1])
                elif line.startswith("PARTITION "):
                    result["partition"] = line.split()[1]
                elif total and re.match(r"^\d+ bytes", line):
                    done = int(line.split()[0])
                    self.events.put(("progress", (min(99, done * 100 // total),
                                                  f"Writing… {human(done)} of {human(total)}")))
                elif line.startswith("ERROR"):
                    errors.append(line[6:].strip())
            if p.wait() != 0:
                raise RuntimeError(errors[-1] if errors else
                                   "Permission was refused, or the operation failed.")
            return result
        finally:
            os.unlink(helper)

    def format_job(self, d, fs, label, files):
        res = self.privileged("format", d["path"], fs, label)
        if not files:
            return
        part = res.get("partition")
        self.events.put(("progress", (0, "Opening the drive")))
        out = subprocess.run(["udisksctl", "mount", "-b", part], capture_output=True, text=True)
        m = re.search(r" at (.+?)\.?$", out.stdout.strip())
        if out.returncode != 0 or not m:
            raise RuntimeError(f"Formatted, but could not open the drive to copy files: {out.stderr.strip()}")
        dest = m.group(1)
        todo = list(all_files(files, with_roots=True))
        total = sum(os.path.getsize(src) for src, _ in todo) or 1
        done = 0
        for src, rel in todo:
            target = os.path.join(dest, rel)
            os.makedirs(os.path.dirname(target), exist_ok=True)
            self.events.put(("progress", (done * 100 // total, f"Copying {rel}")))
            shutil.copyfile(src, target)
            done += os.path.getsize(src)
        self.events.put(("progress", (99, "Finishing (safe to remove soon)…")))
        subprocess.run(["sync"])
        subprocess.run(["udisksctl", "unmount", "-b", part], capture_output=True)

    def write_job(self, img, d):
        self.events.put(("progress", (0, "Asking for permission…")))
        self.privileged("write", img, d["path"], total=os.path.getsize(img))

    def poll(self):
        try:
            while True:
                kind, data = self.events.get_nowait()
                if kind == "progress":
                    self.bar["value"], text = data
                    self.status.config(text=text)
                elif kind == "done":
                    self.busy = False
                    self.bar["value"] = 100
                    self.status.config(text="Finished! You can unplug the drive. 🦄")
                    self.refresh()
                elif kind == "error":
                    self.busy = False
                    self.status.config(text="Something went wrong.")
                    messagebox.showerror("Annie Disk Writer", data)
        except queue.Empty:
            pass
        self.root.after(100, self.poll)


def all_files(paths, with_roots=False):
    """Every regular file under paths; with_roots also yields its path on the drive."""
    for p in paths:
        if os.path.isfile(p):
            yield (p, os.path.basename(p)) if with_roots else p
        elif os.path.isdir(p):
            base = os.path.dirname(os.path.abspath(p))
            for dirpath, _, names in os.walk(p):
                for n in names:
                    full = os.path.join(dirpath, n)
                    if os.path.isfile(full) and not os.path.islink(full):
                        yield (full, os.path.relpath(full, base)) if with_roots else full


def tree_size(p):
    return sum(os.path.getsize(f) for f in all_files([p]))


if __name__ == "__main__":
    root = tk.Tk()
    App(root)
    root.mainloop()
