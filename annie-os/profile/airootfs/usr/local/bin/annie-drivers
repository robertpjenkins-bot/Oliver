#!/bin/bash
# Driver Installer: find the hardware in this computer and install the drivers
# it needs.
#
#   annie-drivers          show what was found, ask what to install
#   annie-drivers --all    install everything recommended without asking
#   annie-drivers --list   only show what was found
set -uo pipefail

mode=ask
case "${1:-}" in
--all) mode=all ;;
--list) mode=list ;;
esac
[[ -t 0 ]] || [[ "$mode" != ask ]] || mode=list

green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m' teal=$'\e[36m' bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
have() { command -v "$1" >/dev/null 2>&1; }

# Each found item: a title, why it matters, and its packages.
titles=() reasons=() pkgsets=() recommended=()
add() { # add "title" "reason" "packages" yes|no
    titles+=("$1")
    reasons+=("$2")
    pkgsets+=("$3")
    recommended+=("$4")
}
installed() { # all of the packages are installed
    local p
    for p in $1; do pacman -Q "$p" >/dev/null 2>&1 || return 1; done
}

pci="$(lspci -nn 2>/dev/null)"
usb="$(lsusb 2>/dev/null)"
pci_has() { grep -qiE "$1" <<<"$pci"; }
usb_has() { grep -qiE "$1" <<<"$usb"; }

# On a drive made by the USB Maker the kernel is held back, and kernel
# drivers built for a newer kernel would not load.
kernel_held=false
grep -qE '^IgnorePkg *=.*\blinux\b' /etc/pacman.conf 2>/dev/null && kernel_held=true

# --- Graphics ------------------------------------------------------------------
if pci_has '(VGA|3D|Display).*\[1002:'; then
    add "AMD graphics (Steam Machine, Steam Deck, Radeon)" \
        "Vulkan for games, 32-bit drivers for Steam, video decoding" \
        "mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon" yes
fi
if pci_has '(VGA|3D|Display).*\[8086:'; then
    add "Intel graphics" \
        "Vulkan for games, 32-bit drivers for Steam, video decoding" \
        "mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver" yes
fi
if pci_has '(VGA|3D|Display).*\[10de:'; then
    if $kernel_held; then
        add "NVIDIA graphics" \
            "NVIDIA's driver needs a kernel update, which a USB Maker drive holds back; install Annie OS to a drive to use it" \
            "" no
    else
        add "NVIDIA graphics (GTX 16 / RTX 20 series and newer)" \
            "NVIDIA's own driver: much faster games than the built-in one" \
            "nvidia-open nvidia-utils lib32-nvidia-utils nvidia-settings" yes
    fi
fi

# --- Network ------------------------------------------------------------------------
if pci_has 'Network controller.*\[14e4:'; then
    add "Broadcom Wi-Fi" "Wi-Fi on many older laptops and MacBooks" "broadcom-wl" yes
fi
if usb_has '045e:02(e6|fe|f9)'; then
    add "Xbox Wireless Adapter" \
        "Needs the xone driver, which is not in the app store; plug controllers in with a USB cable or use Bluetooth instead" \
        "" no
fi

# --- Sound --------------------------------------------------------------------------
if pci_has 'Audio device'; then
    add "Sound card firmware" "Speakers and microphones on laptops, Steam Deck and newer PCs" \
        "sof-firmware alsa-firmware alsa-ucm-conf" yes
fi

# --- Printers and scanners ----------------------------------------------------------------
if usb_has 'printer|03f0:|04a9:|04b8:|04f9:|Brother|Canon|Epson|Hewlett'; then
    add "Printer" "Print from any app" "cups print-manager system-config-printer" yes
    usb_has '03f0:|Hewlett' && add "HP printer extras" "HP printers and scanners" "hplip" yes
fi
if usb_has 'scanner|04a9:1|04b8:01'; then
    add "Scanner" "Scan documents and photos" "sane skanlite" yes
fi

# --- Input and other devices ------------------------------------------------------------------
if usb_has '046d:c5(2b|34|48)|Unifying|Logi Bolt'; then
    add "Logitech wireless receiver" "Pair mice and keyboards, see their battery" "solaar" yes
fi
if usb_has '06cb:|27c6:|138a:|04f3:0c'; then
    add "Fingerprint reader" "Log in with your finger" "fprintd" no
fi
if usb_has 'Wacom|056a:'; then
    add "Wacom tablet" "Pressure and buttons for drawing tablets" "xf86-input-wacom kcm-wacomtablet" yes
fi

# --- Virtual machines -----------------------------------------------------------------------
case "$(systemd-detect-virt 2>/dev/null)" in
oracle) add "VirtualBox guest tools" "Shared clipboard and screen resizing" "virtualbox-guest-utils" yes ;;
vmware) add "VMware guest tools" "Shared clipboard and screen resizing" "open-vm-tools" yes ;;
kvm | qemu) add "QEMU guest tools" "Shared clipboard and screen resizing" "spice-vdagent qemu-guest-agent" yes ;;
esac

# --- Always useful ---------------------------------------------------------------------------
add "Firmware updates" "Updates for the BIOS and devices that support it (fwupd)" "fwupd" no
add "Game performance tools" "GameMode and MangoHud (frame rate overlay)" "gamemode lib32-gamemode mangohud lib32-mangohud" no

# --- Show --------------------------------------------------------------------------------------
printf '\n%s  Driver Installer%s\n\n' "$bold" "$reset"
echo "Found in this computer:"
echo
choices=()
for i in "${!titles[@]}"; do
    n=$((i + 1))
    if [[ -z "${pkgsets[i]}" ]]; then
        state="${yellow}not available${reset}"
    elif installed "${pkgsets[i]}"; then
        state="${green}installed${reset}"
    elif [[ "${recommended[i]}" == yes ]]; then
        state="${teal}recommended${reset}"
        choices+=("$n")
    else
        state="${dim}optional${reset}"
    fi
    printf '  %2d) %-48s %s\n' "$n" "${titles[i]}" "$state"
    printf '      %s%s%s\n' "$dim" "${reasons[i]}" "$reset"
done
echo

[[ "$mode" == list ]] && exit 0

if [[ "$mode" == ask ]]; then
    if ((${#choices[@]} > 0)); then
        echo "Press Enter to install the recommended ones (${choices[*]}),"
    else
        echo "Everything recommended is already installed."
    fi
    read -rp "or type numbers (e.g. 1 3), or q to quit: " pick
    [[ "$pick" == [qQ]* ]] && exit 0
    [[ -n "$pick" ]] && read -ra choices <<<"${pick//,/ }"
fi

pkgs=()
for n in "${choices[@]}"; do
    [[ "$n" =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#titles[@]})) || {
        echo "Skipping '$n': no such item."
        continue
    }
    if [[ -z "${pkgsets[n - 1]}" ]]; then
        echo "Skipping ${titles[n - 1]}: ${reasons[n - 1]}"
        continue
    fi
    read -ra p <<<"${pkgsets[n - 1]}"
    pkgs+=("${p[@]}")
done
if ((${#pkgs[@]} == 0)); then
    echo "Nothing to install."
    exit 0
fi

echo
printf '%sInstalling:%s %s\n' "$bold" "$reset" "${pkgs[*]}"
echo "This also brings the rest of the system up to date, so it can take a while."
if sudo pacman -Syu --needed --noconfirm "${pkgs[@]}"; then
    for svc in cups fwupd; do
        if printf '%s\n' "${pkgs[@]}" | grep -qx "$svc"; then
            sudo systemctl enable --now "$svc.service" 2>/dev/null || true
        fi
    done
    echo
    printf '%s%sDone.%s Restart the computer so the new drivers load.\n' "$green" "$bold" "$reset"
else
    echo
    printf '%sThe install did not finish.%s Check the internet connection and try again,\n' "$red" "$reset"
    echo "or run DC - Debug Computer to find out what is wrong."
    exit 1
fi
