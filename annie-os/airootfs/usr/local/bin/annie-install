#!/usr/bin/env bash
# Install Annie OS: runs Arch's own installer, then adds the Annie desktop,
# apps, unicorn wallpaper, Steam and Proton to the new system.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

cat <<'MSG'
=== Install Annie OS ===

Step 1: the Arch installer opens next. Choose your disk, language, user name
and password there. For "Profile" pick  Desktop -> Xfce4  and for the
greeter pick  lightdm-gtk-greeter.  Say NO when it offers to chroot at the end.

Step 2: Annie OS is added on top automatically.

MSG
read -rp "Press Enter to start (Ctrl+C to cancel)… " _

archinstall

# Find the system archinstall just made: the partition holding an Arch root
# that is not the live medium.
target=""
candidate=/run/annie-target
mkdir -p "$candidate"
for dev in $(lsblk -lnpo NAME,FSTYPE | awk '$2 ~ /^(ext4|btrfs|xfs|f2fs)$/ {print $1}'); do
	opts=ro
	[ "$(lsblk -no FSTYPE "$dev")" = btrfs ] && opts=ro,subvol=@
	if mount -o "$opts" "$dev" "$candidate" 2>/dev/null || mount -o ro "$dev" "$candidate" 2>/dev/null; then
		if [ -x "$candidate/usr/bin/pacman" ] && [ -e "$candidate/etc/fstab" ]; then
			target=$dev
		fi
		umount "$candidate"
	fi
	[ -n "$target" ] && break
done
[ -n "$target" ] || { echo "Could not find the new installation. Is the install finished?"; exit 1; }
echo "Adding Annie OS to $target"

mount_opts=""
[ "$(lsblk -no FSTYPE "$target")" = btrfs ] && mount_opts="-o subvol=@"
# shellcheck disable=SC2086
mount $mount_opts "$target" "$candidate"
trap 'umount -R "$candidate" 2>/dev/null || true' EXIT
arch-chroot "$candidate" mount -a 2>/dev/null || true

# Copy everything Annie OS adds on top of Arch.
cp -a /usr/local/bin/annie-* /usr/local/bin/oliver "$candidate/usr/local/bin/" 2>/dev/null || true
rm -f "$candidate/usr/local/bin/annie-install" "$candidate/usr/share/applications/annie-install.desktop"
mkdir -p "$candidate/usr/lib/annie" "$candidate/usr/share/backgrounds/annie" "$candidate/usr/share/annie"
cp -a /usr/lib/annie/. "$candidate/usr/lib/annie/"
rm -f "$candidate/usr/lib/annie/annie-live-setup"
cp -a /usr/share/backgrounds/annie/. "$candidate/usr/share/backgrounds/annie/"
cp -a /usr/share/annie/. "$candidate/usr/share/annie/" 2>/dev/null || true
cp -a /usr/share/applications/annie-*.desktop "$candidate/usr/share/applications/"
rm -f "$candidate/usr/share/applications/annie-install.desktop"
cp -a /usr/share/icons/hicolor/scalable/apps/annie-* "$candidate/usr/share/icons/hicolor/scalable/apps/"
cp -a /etc/xdg/autostart/annie-session.desktop "$candidate/etc/xdg/autostart/"
cp -a /etc/lightdm/lightdm-gtk-greeter.conf "$candidate/etc/lightdm/"
cp -a /etc/skel/.config "$candidate/etc/skel/"
# Users archinstall already created get the Annie desktop too.
for home in "$candidate"/home/*; do
	[ -d "$home" ] || continue
	owner=$(stat -c %u:%g "$home")
	cp -a /etc/skel/.config "$home/"
	chown -R "$owner" "$home/.config"
done

/usr/lib/annie/enable-multilib
cp /etc/pacman.conf "$candidate/etc/pacman.conf"
arch-chroot "$candidate" pacman -Sy --needed --noconfirm $(grep -v '^#' /usr/share/annie/packages.txt)
arch-chroot "$candidate" systemctl enable lightdm NetworkManager

echo
echo "Annie OS is installed. Remove the USB stick and restart. 🦄"
