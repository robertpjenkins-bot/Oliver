#!/usr/bin/env bash
# Privileged half of Annie Drivers: installs the packages it is given.
set -uo pipefail
[ "$(id -u)" -eq 0 ] || { echo "ERROR: must run as root"; exit 1; }
for p in "$@"; do
	[[ "$p" =~ ^[a-z0-9@._+-]+$ ]] || { echo "ERROR: bad package name $p"; exit 1; }
done

/usr/lib/annie/enable-multilib

echo "# Refreshing package lists"
pacman -Sy --noconfirm || { echo "ERROR: could not reach the package servers (is the internet on?)"; exit 1; }

# Install what exists; a package missing from the repos must not stop the rest.
want=()
for p in "$@"; do
	if pacman -Si "$p" >/dev/null 2>&1; then want+=("$p"); else echo "skipping $p (not in the repositories)"; fi
done
echo "# Installing ${want[*]}"
pacman -S --needed --noconfirm "${want[@]}" || { echo "ERROR: installation failed"; exit 1; }
if printf '%s\n' "${want[@]}" | grep -q '^nvidia'; then
	mkinitcpio -P
fi
echo "# Done"
