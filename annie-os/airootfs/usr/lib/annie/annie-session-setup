#!/bin/sh
# Runs at every login. Sets the unicorn wallpaper on every screen, and does
# the one-time Annie OS setup for a new user.
wall=/usr/share/backgrounds/annie/unicorn.png

# xfdesktop names its settings after each monitor, so they can only be set
# once the monitors are known.
sleep 2
props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$')
for m in $(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
	props="$props
/backdrop/screen0/monitor$m/workspace0/last-image"
done
current=$(xfconf-query -c xfce4-desktop -p /backdrop/annie-set 2>/dev/null)
if [ "$current" != done ]; then
	echo "$props" | sort -u | while read -r p; do
		[ -n "$p" ] || continue
		xfconf-query -c xfce4-desktop -p "$p" -n -t string -s "$wall"
		xfconf-query -c xfce4-desktop -p "${p%/last-image}/image-style" -n -t int -s 5
	done
	xfconf-query -c xfce4-desktop -p /backdrop/annie-set -n -t string -s done
fi

stamp="$HOME/.config/annie-os/first-login-done"
[ -e "$stamp" ] && exit 0
mkdir -p "$(dirname "$stamp")"

# The Super (Windows) key opens the app search.
xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/Super_L -n -t string -s xfce4-popup-whiskermenu

# Steam Play: run every Windows game with Proton out of the box.
cfg="$HOME/.local/share/Steam/config/config.vdf"
if [ ! -e "$cfg" ]; then
	mkdir -p "$(dirname "$cfg")"
	cat >"$cfg" <<'VDF'
"InstallConfigStore"
{
	"Software"
	{
		"Valve"
		{
			"Steam"
			{
				"CompatToolMapping"
				{
					"0"
					{
						"name"		"proton_experimental"
						"config"		""
						"priority"		"75"
					}
				}
			}
		}
	}
}
VDF
fi
xdg-user-dirs-update 2>/dev/null
touch "$stamp"
