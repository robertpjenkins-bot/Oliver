#!/bin/sh
# Creates the passwordless "annie" user the live system logs into.
set -e
/usr/lib/annie/enable-multilib
groupadd -rf autologin
if ! id annie >/dev/null 2>&1; then
	useradd -m -c "Annie" -G wheel,autologin,audio,video,input,storage,network annie
	passwd -d annie
fi
echo 'annie ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/annie-live
chmod 440 /etc/sudoers.d/annie-live

# The rainbow cursor for everything, including apps that ignore the desktop's setting.
mkdir -p /usr/share/icons/default
printf '[Icon Theme]\nInherits=AnnieRainbow\n' >/usr/share/icons/default/index.theme

# /etc/os-release belongs to the filesystem package, so brand it at boot
# rather than shipping a file that would collide with it during the build.
rm -f /etc/os-release
cat >/etc/os-release <<'REL'
NAME="Annie OS"
PRETTY_NAME="Annie OS"
ID=annie
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;170;120;255"
LOGO=annie-os
REL
