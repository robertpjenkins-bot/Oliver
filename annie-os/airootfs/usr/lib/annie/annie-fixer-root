#!/usr/bin/env bash
# Privileged half of Annie Fixer. Run through pkexec with a list of task ids.
set -uo pipefail
[ "$(id -u)" -eq 0 ] || { echo "ERROR: must run as root"; exit 1; }

fail() { echo "ERROR: $*"; }

for task in "$@"; do
	case "$task" in
	lock)
		echo "# Unsticking the package installer"
		if pgrep -x pacman >/dev/null; then
			fail "the installer is still running; wait for it to finish"
		else
			rm -f /var/lib/pacman/db.lck
		fi
		;;
	keys)
		echo "# Repairing signing keys"
		rm -rf /etc/pacman.d/gnupg
		pacman-key --init && pacman-key --populate archlinux \
			&& pacman -Sy --noconfirm archlinux-keyring || fail "could not refresh keys (is the internet on?)"
		;;
	update)
		echo "# Updating everything (this can take a while)"
		pacman -Syu --noconfirm || fail "the update did not finish"
		;;
	broken)
		echo "# Looking for damaged packages"
		mapfile -t bad < <(pacman -Qkq 2>/dev/null | awk '{print $1}' | sort -u)
		if [ "${#bad[@]}" -gt 0 ]; then
			echo "reinstalling: ${bad[*]}"
			pacman -S --noconfirm "${bad[@]}" || fail "could not reinstall ${bad[*]}"
		fi
		;;
	space)
		echo "# Clearing old downloads"
		pacman -Sc --noconfirm
		journalctl --vacuum-size=100M
		;;
	network)
		echo "# Restarting the internet"
		rfkill unblock all
		systemctl restart NetworkManager || fail "NetworkManager would not restart"
		;;
	*) fail "unknown task $task" ;;
	esac
done
