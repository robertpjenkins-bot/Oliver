#!/usr/bin/env python3
"""OS Maker installer.

The window behind the Install button on the live desktop: pick a disk,
confirm, and watch osmaker-install-backend copy the OS onto it.
"""

import json
import os
import subprocess
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

BACKEND = "/usr/local/bin/osmaker-install-backend"
LOG = "/tmp/osmaker-install.log"
MIN_SIZE = 12 * 1024 ** 3


def os_name():
    try:
        with open("/etc/osmaker/os-name") as f:
            return f.read().strip() or "this OS"
    except OSError:
        return "this OS"


def human(size):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1000 or unit == "TB":
            return "%.0f %s" % (size, unit) if unit in ("B", "KB") else "%.1f %s" % (size, unit)
        size /= 1000.0


def boot_disk():
    """The USB stick or DVD the live system runs from."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/archiso/bootmnt"],
                             capture_output=True, text=True).stdout.strip()
        if not src:
            return None
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.split()
        return os.path.realpath("/dev/" + parent[0] if parent else src)
    except OSError:
        return None


def disks():
    out = subprocess.run(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,TYPE,RM,RO,TRAN"],
                         capture_output=True, text=True, check=True).stdout
    boot = boot_disk()
    found = []
    for d in json.loads(out)["blockdevices"]:
        if d.get("type") != "disk" or d.get("name", "").startswith(("zram", "loop")):
            continue
        size = int(d.get("size") or 0)
        why_not = None
        if os.path.realpath(d["path"]) == boot:
            why_not = "this is the USB stick the OS is running from"
        elif d.get("ro") in (True, "1", 1):
            why_not = "read-only"
        elif size < MIN_SIZE:
            why_not = "too small (needs 12 GB)"
        kind = "USB drive" if d.get("tran") == "usb" else ("removable" if d.get("rm") in (True, "1", 1) else "internal disk")
        model = (d.get("model") or "").strip() or "Disk"
        found.append({"path": d["path"], "label": "%s — %s, %s (%s)" % (model, human(size), kind, d["path"]), "why_not": why_not})
    return found


class Installer(Gtk.Window):
    def __init__(self):
        super().__init__(title="Install " + os_name())
        self.name = os_name()
        self.set_default_size(620, 480)
        self.set_border_width(24)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT)
        self.add(self.stack)
        self.stack.add_named(self.page_welcome(), "welcome")
        self.stack.add_named(self.page_disk(), "disk")
        self.stack.add_named(self.page_progress(), "progress")
        self.stack.add_named(self.page_done(), "done")
        self.proc = None

    # --- pages ------------------------------------------------------------

    def page(self, title, *body, buttons=()):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        head = Gtk.Label(xalign=0)
        head.set_markup("<span size='x-large' weight='bold'>%s</span>" % GLib.markup_escape_text(title))
        box.pack_start(head, False, False, 0)
        for w in body:
            box.pack_start(w, w.get_vexpand(), w.get_vexpand(), 0)
        if buttons:
            row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
            for b in buttons:
                row.pack_start(b, False, False, 0)
            box.pack_end(row, False, False, 0)
        return box

    def text(self, markup):
        label = Gtk.Label(xalign=0)
        label.set_line_wrap(True)
        label.set_markup(markup)
        return label

    def page_welcome(self):
        nxt = Gtk.Button(label="Next")
        nxt.get_style_context().add_class("suggested-action")
        nxt.connect("clicked", lambda *_: self.show_disks())
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        n = GLib.markup_escape_text(self.name)
        return self.page(
            "Install %s on this computer" % self.name,
            self.text("This puts <b>%s</b> on this computer's disk, exactly as it is on this USB stick: "
                      "your desktop, your apps and your settings. Afterwards the computer can start "
                      "%s without the USB stick, and anything you save will be kept." % (n, n)),
            self.text("<b>⚠ The disk you choose is completely erased.</b> Everything on it — Windows, "
                      "photos, games, other files — will be gone. Back up anything you want to keep first."),
            self.text("It needs a disk of at least 12 GB and takes about 5–15 minutes."),
            buttons=(cancel, nxt))

    def page_disk(self):
        self.disk_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.pw1 = Gtk.Entry(visibility=False, placeholder_text="New password (optional)")
        self.pw2 = Gtk.Entry(visibility=False, placeholder_text="Type it again")
        self.agree = Gtk.CheckButton(label="I understand everything on this disk will be erased")
        self.agree.connect("toggled", lambda *_: self.update_install_button())
        self.error = Gtk.Label(xalign=0)
        back = Gtk.Button(label="Back")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("welcome"))
        self.install_btn = Gtk.Button(label="Erase and install")
        self.install_btn.get_style_context().add_class("destructive-action")
        self.install_btn.connect("clicked", self.confirm)
        pw = Gtk.Box(spacing=8)
        pw.pack_start(self.pw1, True, True, 0)
        pw.pack_start(self.pw2, True, True, 0)
        return self.page(
            "Where should it go?",
            self.disk_box,
            self.text("Password for your account on the installed system. Leave it empty to keep the one "
                      "from your design. You need one to install or update software."),
            pw, self.agree, self.error,
            buttons=(back, self.install_btn))

    def page_progress(self):
        self.bar = Gtk.ProgressBar(show_text=True)
        self.status = self.text("Starting…")
        self.logview = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_min_content_height(160)
        scroll.add(self.logview)
        exp = Gtk.Expander(label="Details")
        exp.add(scroll)
        exp.set_vexpand(True)
        return self.page("Installing %s…" % self.name, self.status, self.bar, exp)

    def page_done(self):
        self.done_title = Gtk.Label(xalign=0)
        self.done_text = self.text("")
        self.done_btn = Gtk.Button()
        self.done_btn.get_style_context().add_class("suggested-action")
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: self.close())
        return self.page("", self.done_title, self.done_text, buttons=(close, self.done_btn))

    # --- actions ----------------------------------------------------------

    def show_disks(self):
        for c in self.disk_box.get_children():
            self.disk_box.remove(c)
        self.radios = []
        group = None
        try:
            found = disks()
        except (OSError, subprocess.CalledProcessError, ValueError) as e:
            found = []
            self.disk_box.pack_start(self.text("Could not list the disks: %s" % GLib.markup_escape_text(str(e))), False, False, 0)
        for d in found:
            label = d["label"] + ("  —  " + d["why_not"] if d["why_not"] else "")
            r = Gtk.RadioButton.new_with_label_from_widget(group, label)
            group = group or r
            r.set_sensitive(not d["why_not"])
            r.disk = d["path"]
            r.connect("toggled", lambda *_: self.update_install_button())
            self.radios.append(r)
            self.disk_box.pack_start(r, False, False, 0)
        usable = [r for r in self.radios if r.get_sensitive()]
        if usable:
            usable[0].set_active(True)
        else:
            self.disk_box.pack_start(self.text("<b>No disk here can take it.</b> It needs a disk of at least 12 GB "
                                               "that is not the USB stick this is running from."), False, False, 0)
        self.agree.set_active(False)
        self.disk_box.show_all()
        self.update_install_button()
        self.stack.set_visible_child_name("disk")

    def chosen(self):
        for r in self.radios:
            if r.get_active() and r.get_sensitive():
                return r.disk
        return None

    def update_install_button(self):
        self.install_btn.set_sensitive(bool(self.chosen()) and self.agree.get_active())

    def confirm(self, *_):
        if self.pw1.get_text() != self.pw2.get_text():
            self.error.set_markup("<span foreground='#e74c3c'>The two passwords are different.</span>")
            return
        if ":" in self.pw1.get_text() or "\n" in self.pw1.get_text():
            self.error.set_markup("<span foreground='#e74c3c'>Passwords can't contain a colon.</span>")
            return
        self.error.set_text("")
        disk = self.chosen()
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.NONE, text="Erase %s?" % disk)
        dlg.format_secondary_text("Everything on %s will be deleted and replaced with %s. This can't be undone."
                                  % (disk, self.name))
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = dlg.add_button("Erase and install", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action")
        answer = dlg.run()
        dlg.destroy()
        if answer == Gtk.ResponseType.OK:
            self.start(disk)

    def start(self, disk):
        self.stack.set_visible_child_name("progress")
        self.set_deletable(False)
        self.failed = None
        self.log = open(LOG, "w")
        # The live system lets its user run exactly this program as root
        # without a password (see /etc/sudoers.d/20-osmaker-live).
        self.proc = subprocess.Popen(
            ["sudo", "-n", BACKEND, disk, "--password-stdin"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        self.proc.stdin.write(self.pw1.get_text() + "\n")
        self.proc.stdin.close()
        threading.Thread(target=self.read_output, daemon=True).start()

    def read_output(self):
        # Read on a thread and hand each line to the UI thread.
        for line in self.proc.stdout:
            GLib.idle_add(self.on_line, line)
        GLib.idle_add(self.finish, self.proc.wait())

    def on_line(self, line):
        self.log.write(line)
        self.log.flush()
        buf = self.logview.get_buffer()
        buf.insert(buf.get_end_iter(), line)
        if buf.get_line_count() > 2000:
            buf.delete(buf.get_start_iter(), buf.get_iter_at_line(500))
        if line.startswith("PROGRESS "):
            parts = line.rstrip("\n").split(" ", 2)
            try:
                self.bar.set_fraction(int(parts[1]) / 100)
            except ValueError:
                pass
            self.status.set_text(parts[2] if len(parts) > 2 else "")
        elif line.startswith("ERROR ") and self.failed is None:
            self.failed = line[6:].strip()
        return False

    def finish(self, code):
        self.log.close()
        self.set_deletable(True)
        for c in self.done_btn.get_children():
            self.done_btn.remove(c)
        try:
            self.done_btn.disconnect_by_func(self.reboot)
        except TypeError:
            pass
        n = GLib.markup_escape_text(self.name)
        if code == 0:
            self.done_title.set_markup("<span size='x-large' weight='bold'>🎉 %s is installed!</span>" % n)
            self.done_text.set_markup("Restart the computer and take out the USB stick. It will start up "
                                      "into %s by itself." % n)
            self.done_btn.set_label("Restart now")
            self.done_btn.connect("clicked", self.reboot)
        else:
            why = self.failed or "the installer could not get permission to run (exit code %d)" % code
            self.done_title.set_markup("<span size='x-large' weight='bold'>The install didn't finish</span>")
            self.done_text.set_markup("%s.\n\nThe full log is in <tt>%s</tt>. Nothing else on this USB stick changed; "
                                      "you can try again." % (GLib.markup_escape_text(why), LOG))
            self.done_btn.set_label("Try again")
            self.done_btn.connect("clicked", lambda *_: self.show_disks())
        self.done_btn.show_all()
        self.stack.set_visible_child_name("done")
        return False

    def reboot(self, *_):
        subprocess.Popen(["systemctl", "reboot"])


def main():
    if not os.path.isdir("/run/archiso"):
        dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
                                text="%s is already installed" % os_name())
        dlg.format_secondary_text("The installer only works when the computer is started from the USB stick or DVD.")
        dlg.run()
        return
    win = Installer()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
